thena spine> :theorem id : ∀ (A : Type) -> A -> A
proving id : ∀ (A : Type (?ℓ1)) -> A -> A
thena spine> try (\ (A : Type) (a : A) -> a)
thena spine> solve
thena spine> qed
id {ℓ13} : ∀ (A : Type (ℓ13)) -> A -> A   ∎
thena spine> :show id
id {ℓ13} : ∀ (A : Type (ℓ13)) -> A -> A
id = let id = λ (A : Type (ℓ13)) (a : A) -> a : ∀ (A : Type (ℓ13)) -> A -> A in id
thena spine> :infer id {0}
id {0} : ∀ (A : Type₀) -> A -> A
thena spine> :infer id {3}
id {3} : ∀ (A : Type₃) -> A -> A
thena spine> :infer id
id has 1 level parameter, and was given 0 level arguments
its level parameters are prenex, so a use supplies all of them or none
thena spine> :theorem lift : ∀ (A : Type) -> Type
proving lift : Type (?ℓ15) -> Type (?ℓ17)
thena spine> try (\ (A : Type) -> A)
thena spine> solve
thena spine> qed
lift {ℓ24 ℓ25} : Type (ℓ24) -> Type (ℓ25)   ∎
thena spine> :show lift
lift {ℓ24 ℓ25} : Type (ℓ24) -> Type (ℓ25)
  provided ℓ24 ≤ ℓ25
lift = let lift = λ (A : Type (ℓ24)) -> A : Type (ℓ24) -> Type (ℓ25) in lift
thena spine> :infer lift {0 1}
lift {0 1} : Type₀ -> Type₁
thena spine> :infer lift {1 0}
lift {1 0} : Type₁ -> Type₀
thena spine> :theorem bad : Type₁ -> Type₀
proving bad : Type₁ -> Type₀
thena spine> try (lift {1 0})
thena spine> solve
thena spine> :revalidate
1 is not at most 0
thena spine> qed
the kernel refused it
1 is not at most 0
thena spine> along
thena core> reduce
thena core> :revalidate
1 is not at most 0
thena core> :abandon
abandoned bad
thena spine> :quit
