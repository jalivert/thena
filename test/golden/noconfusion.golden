thena spine> data Term : Type₀ where { true : Term ; false : Term ; ifthen : Term -> Term -> Term -> Term ; zero : Term ; succ : Term -> Term }
declared Term
thena spine> :show noConfusionTerm
noConfusionTerm : ∀ (x : Term) (y : Term) -> Eq {0} Term x y -> NoConfusionTerm x y
noConfusionTerm = λ (x : Term) (y : Term) (e : Eq {0} Term x y) -> elim Eq {0} (Term) (λ (u : Term) (v : Term) (w : Eq {0} Term u v) -> NoConfusionTerm u v) ((λ (a : Term) -> elim Term () (λ (z : Term) -> NoConfusionTerm z z) (unit {0} unit {0} (λ (x1 : Term) (x2 : Term) (x3 : Term) (ih : (λ (z : Term) -> NoConfusionTerm z z) x1) (ih1 : (λ (z : Term) -> NoConfusionTerm z z) x2) (ih2 : (λ (z : Term) -> NoConfusionTerm z z) x3) -> both {0 0} (Eq {0} Term x1 x1) (And {0 0} (Eq {0} Term x2 x2) (Eq {0} Term x3 x3)) (refl {0} Term x1) (both {0 0} (Eq {0} Term x2 x2) (Eq {0} Term x3 x3) (refl {0} Term x2) (refl {0} Term x3))) unit {0} (λ (x1 : Term) (ih : (λ (z : Term) -> NoConfusionTerm z z) x1) -> refl {0} Term x1)) () a)) (x y) e
thena spine> :whnf NoConfusionTerm true true
Unit {0}
thena spine> :whnf NoConfusionTerm true (succ zero)
Empty {0}
thena spine> :whnf NoConfusionTerm (succ true) (succ zero)
Eq {0} Term true zero
thena spine> :whnf NoConfusionTerm (ifthen true zero zero) (ifthen false zero zero)
And {0 0} (Eq {0} Term true false) (And {0 0} (Eq {0} Term zero zero) (Eq {0} Term zero zero))
