let goal = λ (a : Term) (b : Term) (e : Eq {0} Term (succ a) (succ b)) -> Term.lemmata.noConfusion (succ a) (succ b) e : ∀ (a : Term) (b : Term) -> Eq {0} Term (succ a) (succ b) -> Eq {0} Term a b in goal
