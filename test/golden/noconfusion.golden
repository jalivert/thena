thena spine> data Eq (A : Type₀) : A -> A -> Type₀ where { refl : ∀ (a : A) -> Eq A a a }
declared Eq
thena spine> data Unit : Type₀ where { unit : Unit }
declared Unit
thena spine> data Empty : Type₀ where { }
declared Empty
thena spine> data And (A : Type₀) (B : Type₀) : Type₀ where { both : ∀ (a : A) (b : B) -> And A B }
declared And
thena spine> data Term : Type₀ where { true : Term ; false : Term ; ifthen : Term -> Term -> Term -> Term ; zero : Term ; succ : Term -> Term }
declared Term
thena spine> :show noConfusionTerm
noConfusionTerm : ∀ (x : Term) (y : Term) -> Eq Term x y -> NoConfusionTerm x y
noConfusionTerm = λ (x : Term) (y : Term) (e : Eq Term x y) -> elim Eq (Term) (λ (u : Term) (v : Term) (w : Eq Term u v) -> NoConfusionTerm u v) ((λ (a : Term) -> elim Term () (λ (z : Term) -> NoConfusionTerm z z) (unit unit (λ (x1 : Term) (x2 : Term) (x3 : Term) (ih : (λ (z : Term) -> NoConfusionTerm z z) x1) (ih1 : (λ (z : Term) -> NoConfusionTerm z z) x2) (ih2 : (λ (z : Term) -> NoConfusionTerm z z) x3) -> both (Eq Term x1 x1) (And (Eq Term x2 x2) (Eq Term x3 x3)) (refl Term x1) (both (Eq Term x2 x2) (Eq Term x3 x3) (refl Term x2) (refl Term x3))) unit (λ (x1 : Term) (ih : (λ (z : Term) -> NoConfusionTerm z z) x1) -> refl Term x1)) () a)) (x y) e
thena spine> :whnf NoConfusionTerm true true
Unit
thena spine> :whnf NoConfusionTerm true (succ zero)
Empty
thena spine> :whnf NoConfusionTerm (succ true) (succ zero)
Eq Term true zero
thena spine> :whnf NoConfusionTerm (ifthen true zero zero) (ifthen false zero zero)
And (Eq Term true false) (And (Eq Term zero zero) (Eq Term zero zero))
thena spine> :goal ∀ (a : Term) (b : Term) -> Eq Term (succ a) (succ b) -> Eq Term a b
▶ let ? goal : ∀ (a : Term) (b : Term) -> Eq Term (succ a) (succ b) -> Eq Term a b in
  goal
thena spine> along
thena core> unify goal ≟ \ (a : Term) (b : Term) (e : Eq Term (succ a) (succ b)) -> noConfusionTerm (succ a) (succ b) e
solved: goal
thena core> :extract
let goal = λ (a : Term) (b : Term) (e : Eq Term (succ a) (succ b)) -> noConfusionTerm (succ a) (succ b) e : ∀ (a : Term) (b : Term) -> Eq Term (succ a) (succ b) -> Eq Term a b in goal
thena core> certify ∀ (a : Term) (b : Term) -> Eq Term (succ a) (succ b) -> Eq Term a b
certified
thena core> back
thena spine> data Nat : Type₀ where { zero' : Nat ; succ' : Nat -> Nat }
declared Nat
thena spine> data Vec (A : Type₀) : Nat -> Type₀ where { nil : Vec A zero' ; cons : ∀ (n : Nat) (a : A) (as : Vec A n) -> Vec A (succ' n) }
no noConfusionVec: cons's argument as has a type that depends on an earlier argument, so its equation cannot be stated
declared Vec
thena spine> :show noConfusionVec
nothing named noConfusionVec has been declared
thena spine> :quit
