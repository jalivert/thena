▶ let ? goal : ∀ (a : Term) (b : Term) -> Eq {0} Term (succ a) (succ b) -> Eq {0} Term a b in
  goal
thena spine> along
thena core> unify goal ≟ \ (a : Term) (b : Term) (e : Eq {0} Term (succ a) (succ b)) -> noConfusionTerm (succ a) (succ b) e
solved: goal
thena core> :extract
let goal = λ (a : Term) (b : Term) (e : Eq {0} Term (succ a) (succ b)) -> noConfusionTerm (succ a) (succ b) e : ∀ (a : Term) (b : Term) -> Eq {0} Term (succ a) (succ b) -> Eq {0} Term a b in goal
