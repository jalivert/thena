Term.lemmata.noConfusion : ∀ (x : Term) (x' : Term) -> Eq {0} Term x x' -> Term.lemmata.NoConfusion x x'
Term.lemmata.noConfusion = λ (u : Term) (v : Term) (q : Eq {0} Term u v) -> elim Eq {0} (Term) (λ (u1 : Term) (v1 : Term) (w : Eq {0} Term u1 v1) -> Term.lemmata.NoConfusion u1 v1) ((λ (c : Term) -> elim Term () (λ (z : Term) -> Term.lemmata.NoConfusion z z) (unit {0} unit {0} (λ (x : Term) (x1 : Term) (x2 : Term) (ih : (λ (z : Term) -> Term.lemmata.NoConfusion z z) x) (ih1 : (λ (z : Term) -> Term.lemmata.NoConfusion z z) x1) (ih2 : (λ (z : Term) -> Term.lemmata.NoConfusion z z) x2) -> both {0 0} (Eq {0} Term x x) (And {0 0} (Eq {0} Term x1 x1) (Eq {0} Term x2 x2)) (refl {0} Term x) (both {0 0} (Eq {0} Term x1 x1) (Eq {0} Term x2 x2) (refl {0} Term x1) (refl {0} Term x2))) unit {0} (λ (x : Term) (ih : (λ (z : Term) -> Term.lemmata.NoConfusion z z) x) -> refl {0} Term x)) () c)) (u v) q
thena spine> :whnf Term.lemmata.NoConfusion true true
Unit {0}
thena spine> :whnf Term.lemmata.NoConfusion true (succ zero)
Empty {0}
thena spine> :whnf Term.lemmata.NoConfusion (succ true) (succ zero)
Eq {0} Term true zero
thena spine> :whnf Term.lemmata.NoConfusion (ifthen true zero zero) (ifthen false zero zero)
And {0 0} (Eq {0} Term true false) (And {0 0} (Eq {0} Term zero zero) (Eq {0} Term zero zero))
