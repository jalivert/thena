thena spine> data Nat : Type₀ where { zero : Nat ; succ : Nat -> Nat }
declared Nat.Nat
thena spine> open Nat
opened Nat
thena spine> :show Nat
data Nat.Nat : Type₀ where
  { Nat.zero : Nat.Nat
  ; Nat.succ : Nat.Nat -> Nat.Nat }
thena spine> :show succ
Nat.succ : Nat.Nat -> Nat.Nat
Nat.succ = λ (x : Nat.Nat) -> Nat.succ x
thena spine> :show zero
Nat.zero : Nat.Nat
Nat.zero = Nat.zero
thena spine> :core succ (succ zero)
Nat.succ (Nat.succ Nat.zero)
thena spine> data Vec (A : Type₀) : Nat -> Type₀ where { nil : Vec A zero ; cons : ∀ (n : Nat) (a : A) (as : Vec A n) -> Vec A (succ n) }
declared Vec.Vec
thena spine> open Vec
opened Vec
thena spine> :show Vec
data Vec.Vec (A : Type₀) : Nat.Nat -> Type₀ where
  { Vec.nil : Vec.Vec A Nat.zero
  ; Vec.cons : ∀ (n : Nat.Nat) -> A -> Vec.Vec A n -> Vec.Vec A (Nat.succ n) }
thena spine> :show cons
Vec.cons : ∀ (A : Type₀) (n : Nat.Nat) -> A -> Vec.Vec A n -> Vec.Vec A (Nat.succ n)
Vec.cons = λ (A : Type₀) (n : Nat.Nat) (a : A) (as : Vec.Vec A n) -> Vec.cons A n a as
thena spine> data Empty : Type where { }
declared Empty.Empty
thena spine> open Empty
opened Empty
thena spine> :show Empty
data Empty.Empty {ℓ₃₆} : Type (ℓ₃₆) where { }
thena spine> data Nat : Type₀ where { z : Nat }
refused: Nat.Nat is already declared
thena spine> open Nat
opened Nat
thena spine> data Ordinal : Type₀ where { sup : (Nat -> Ordinal) -> Ordinal }
refused: the argument x of Ordinal.sup is a function into the datatype, which MS1 does not admit yet
thena spine> data Bad : Type₀ where { bad : (Bad -> Bad) -> Bad }
refused: the argument x of Bad.bad puts the datatype to the left of an arrow
thena spine> :show nowhere
nothing named nowhere has been declared
thena spine> assume "n" ⌜ Nat ⌝
thena spine> :show
  λ (n : Nat.Nat) ->
▶ let ? goal : Type₀ in
  goal
thena spine> :quit
