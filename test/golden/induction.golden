plusZero : ∀ (n : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus n Nat.zero) n   ∎
thena spine> :show plusZero
plusZero : ∀ (n : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus n Nat.zero) n
plusZero = let plusZero = λ (n : Nat.Nat) -> let zeroMethod = Eq.refl {0} Nat.Nat Nat.zero : Eq.Eq {0} Nat.Nat (plus Nat.zero Nat.zero) Nat.zero in let succMethod = λ (x : Nat.Nat) (ih : Eq.Eq {0} Nat.Nat (plus x Nat.zero) x) -> congSucc (plus x Nat.zero) x ih : ∀ (x : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus x Nat.zero) x -> Eq.Eq {0} Nat.Nat (plus (Nat.succ x) Nat.zero) (Nat.succ x) in let plusZero1 = elim Nat.Nat () (λ (target : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus target Nat.zero) target) (zeroMethod succMethod) () n : Eq.Eq {0} Nat.Nat (plus n Nat.zero) n in plusZero1 : ∀ (n : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus n Nat.zero) n in plusZero
thena spine> :quit
