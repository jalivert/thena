plusZero : ∀ (n : Nat) -> Eq Nat (plus n zero) n   ∎
thena spine> :show plusZero
plusZero : ∀ (n : Nat) -> Eq Nat (plus n zero) n
plusZero = let plusZero = λ (n : Nat) -> let zeroMethod = refl Nat zero : Eq Nat (plus zero zero) zero in let succMethod = λ (x : Nat) (ih : Eq Nat (plus x zero) x) -> congSucc (plus x zero) x ih : ∀ (x : Nat) -> Eq Nat (plus x zero) x -> Eq Nat (plus (succ x) zero) (succ x) in let plusZero1 = elim Nat () (λ (target : Nat) -> Eq Nat (plus target zero) target) (zeroMethod succMethod) () n : Eq Nat (plus n zero) n in plusZero1 : ∀ (n : Nat) -> Eq Nat (plus n zero) n in plusZero
thena spine> :quit
