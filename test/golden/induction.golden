thena spine> :theorem plusZero : ∀ (n : Nat) -> Eq {0} Nat (plus n zero) n
proving plusZero : ∀ (n : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus n Nat.zero) n
thena spine> attack
thena spine> intro
thena spine> into
thena spine> along
thena spine> eliminate-core ⌜ n ⌝
subgoals: zeroMethod, succMethod
thena spine> :show
  let ? plusZero : ∀ (n : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus n Nat.zero) n ≐ (
    λ (n : Nat.Nat) ->
    let ? zeroMethod : Eq.Eq {0} Nat.Nat (plus Nat.zero Nat.zero) Nat.zero in
    let ? succMethod : ∀ (x : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus x Nat.zero) x -> Eq.Eq {0} Nat.Nat (plus (Nat.succ x) Nat.zero) (Nat.succ x) in
▶   let ? plusZero1 : Eq.Eq {0} Nat.Nat (plus n Nat.zero) n ≐ (
      elim Nat.Nat () (λ (target : Nat.Nat) -> Eq.Eq {0} Nat.Nat (plus target Nat.zero) target) (zeroMethod succMethod) () n
    ) in
    plusZero1
  ) in
  plusZero
thena spine> back
thena spine> back
