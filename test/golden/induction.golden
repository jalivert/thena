proving plus : Nat.Nat -> Nat.Nat -> Nat.Nat
thena spine> try-core ⌜ \ (n : Nat) (m : Nat) -> elim Nat () (\ (t : Nat) -> Nat) (m (\ (k : Nat) (ih : Nat) -> succ ih)) () n ⌝
thena spine> solve
thena spine> qed
