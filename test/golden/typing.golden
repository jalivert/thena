thena spine> data Nat : Type₀ where { zero : Nat ; succ : Nat -> Nat }
declared Nat.Nat
thena spine> open Nat
opened Nat
thena spine> :infer ⌜ succ zero ⌝
Nat.succ Nat.zero : Nat.Nat
thena spine> :infer ⌜ \ (x : Nat) -> x ⌝
λ (x : Nat.Nat) -> x : Nat.Nat -> Nat.Nat
thena spine> :infer ⌜ ∀ (A : Type₀) -> A ⌝
∀ (A : Type₀) -> A : Type₁
thena spine> :convert succ ≟ \ (n : Nat) -> succ n
Nat.succ ≟ λ (n : Nat.Nat) -> Nat.succ n   yes
thena spine> :convert Type₀ ≟ Type₁
Type₀ ≟ Type₁   no
  Type₀ and Type₁ are different universes
thena spine> :convert succ zero ≟ succ (succ zero)
Nat.succ Nat.zero ≟ Nat.succ (Nat.succ Nat.zero)   no
  in argument 1 of Nat.succ, Nat.zero and Nat.succ are different names
thena spine> :infer ⌜ zero zero ⌝
Nat.zero cannot be applied — it has type Nat.Nat
thena spine> :infer ⌜ elim Nat () (\ (_ : Nat) -> Nat) (zero succ) () (succ zero) ⌝
Nat.succ has type Nat.Nat -> Nat.Nat
  but ∀ (x : Nat.Nat) -> (λ (_ : Nat.Nat) -> Nat.Nat) x -> (λ (_ : Nat.Nat) -> Nat.Nat) (Nat.succ x) was expected
  under x, (λ (_ : Nat.Nat) -> Nat.Nat) x -> (λ (_ : Nat.Nat) -> Nat.Nat) (Nat.succ x) and Nat.Nat do not match
thena spine> claim "h" ⌜ Nat ⌝
thena spine> cross type
thena core> :infer
Type₀ : Type₁
thena core> back
thena spine> back
thena spine> :infer
that move is for a core term, and the focus is on the chain
thena spine> data Big : Type₀ where { wrap : Type₀ -> Big }
refused: the argument x of Big.wrap lives in Type₁, which the datatype's own Type₀ does not contain
thena spine> :quit
