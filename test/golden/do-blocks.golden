thena spine> :surface do { attack ; intro }
do { attack ; intro }
thena spine> :surface f (do { attack })
f do { attack }
thena spine> data Nat : Type₀ where { zero : Nat ; succ : Nat -> Nat }
declared Nat
thena spine> open Nat
opened Nat
thena spine> :theorem t : Nat
proving t : Nat
thena spine> elaborate surface`do { attack ; prove }`
do block 1, instruction 2: no rule or function is called prove
thena spine> :show
▶ let ? t : Nat in
  t
thena spine> :abandon
abandoned t
thena spine> :theorem u : Nat
proving u : Nat
thena spine> elaborate surface`do { say }`
do block 1, instruction 1: say takes 1 argument, not 0 arguments
thena spine> :quit
