thena spine> data Nat : Type₀ where { zero : Nat ; succ : Nat -> Nat }
declared Nat
thena spine> open Nat
opened Nat
thena spine> claim "h" core`Nat`
thena spine> unify core`succ h` core`succ (succ zero)`
solved: h
thena spine> :show
  let h = succ zero : Nat in
▶ let ? goal : Type₀ in
  goal
thena spine> claim "f" core`Nat -> Nat`
thena spine> unify core`\ (x : Nat) -> f x` core`\ (x : Nat) -> succ x`
solved: f
thena spine> :show
  let h = succ zero : Nat in
  let f = λ (x : Nat) -> succ x : Nat -> Nat in
▶ let ? goal : Type₀ in
  goal
thena spine> claim "a" core`Nat`
thena spine> claim "b" core`Nat`
thena spine> unify core`a` core`b`
solved: b
thena spine> :show
  let h = succ zero : Nat in
  let f = λ (x : Nat) -> succ x : Nat -> Nat in
  let ? a : Nat in
  let b = a : Nat in
▶ let ? goal : Type₀ in
  goal
thena spine> unify core`b` core`zero`
solved: a
thena spine> :show
  let h = succ zero : Nat in
  let f = λ (x : Nat) -> succ x : Nat -> Nat in
  let a = zero : Nat in
  let b = a : Nat in
▶ let ? goal : Type₀ in
  goal
thena spine> claim "c" core`Nat`
thena spine> unify core`c` core`succ c`
stuck: solving c with succ c would define it in terms of itself
thena spine> unify core`zero` core`succ zero`
stuck: zero and succ zero cannot be made equal
thena spine> :quit
