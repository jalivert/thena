thena spine> claim "n" ⌜ Nat ⌝
thena spine> :whnf elim Nat () (\ (_ : Nat) -> Nat) (zero succ) () n
elim Nat.Nat () (λ (_ : Nat.Nat) -> Nat.Nat) (Nat.zero Nat.succ) () n
