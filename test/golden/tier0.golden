module examples.Tier0
  declared Nat
  declared plus
  declared identity
  declared one
  declared two
  declared plusZeroLeft
examples.Tier0.one = let refined = Nat : Type₀ in let A = refined : Type₀ in let refined1 = zero : Nat in let a1 = refined1 : Nat in let refined2 = succ a1 : Nat in let a = refined2 : A in let refined3 = identity A a : A in let goal = refined3 : Nat in goal
examples.Tier0.two = let refined = one : Nat in let a = refined : Nat in let refined1 = one : Nat in let a1 = refined1 : Nat in let refined2 = plus a a1 : Nat in let goal = refined2 : Nat in goal
examples.Tier0.plusZeroLeft = let goal = λ (n : Nat) -> let refined = Nat : Type₀ in let A = refined : Type₀ in let refined1 = n : Nat in let a = refined1 : A in let refined2 = refl {ℓ₄₉₉₇} A a : Eq {ℓ₄₉₉₇} A a a in let goal1 = refined2 : Eq {ℓ₄₉₉₇} Nat (plus zero n) n in goal1 : ∀ (n : Nat) -> Eq {ℓ₄₉₉₇} Nat (plus zero n) n in goal
