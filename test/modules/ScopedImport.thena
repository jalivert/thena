module test.modules.ScopedImport where

-- **The import states how far it reaches** (MS11 phase 291, his design of
-- 2026-11-05): `Bit.Bit` and `Bit.off` are writable in the block and neither is
-- writable after the `}`. **An `open` of `Opener`'s is not inherited here** —
-- his ruling of 2026-11-06 — so the names are written in full.
import test.modules.Opener where
  mine : Bit.Bit
  mine = Bit.off
