data Nat : Type₀ where { zero : Nat ; succ : Nat -> Nat }
data Even : Nat -> Type₀ where { evenZero : Even zero ; evenSS : ∀ (n : Nat) (p : Even n) -> Even (succ (succ n)) }
:whnf NoConfusionNat zero zero
:whnf NoConfusionNat zero (succ zero)
:whnf NoConfusionNat (succ zero) (succ (succ zero))
:theorem twoIsEven : Even (succ (succ zero))
try (evenSS zero evenZero)
solve
qed
:theorem anEvenNumber : Sigma Nat Even
try (pair Nat Even (succ (succ zero)) twoIsEven)
solve
qed
:whnf fst Nat Even anEvenNumber
:theorem eta : ∀ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> Eq (Sigma A B) s (pair A B (fst A B s) (snd A B s))
try (\ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> elim Sigma (A B) (\ (z : Sigma A B) -> Eq (Sigma A B) z (pair A B (fst A B z) (snd A B z))) ((\ (a : A) (b : B a) -> refl (Sigma A B) (pair A B a b))) () s)
solve
qed
:theorem swap : ∀ (A : Type₀) (B : Type₀) (c : And A B) -> And B A
try (\ (A : Type₀) (B : Type₀) (c : And A B) -> both B A (andRight A B c) (andLeft A B c))
solve
qed
:theorem succInjective : ∀ (a : Nat) (b : Nat) (q : Eq Nat (succ a) (succ b)) -> Eq Nat a b
try (\ (a : Nat) (b : Nat) (q : Eq Nat (succ a) (succ b)) -> noConfusionNat (succ a) (succ b) q)
solve
qed
:theorem zeroIsNotSuccessor : ∀ (a : Nat) (q : Eq Nat zero (succ a)) -> Empty
try (\ (a : Nat) (q : Eq Nat zero (succ a)) -> noConfusionNat zero (succ a) q)
solve
qed
