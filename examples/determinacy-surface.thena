invPred = \ p p' s0 ih0 u s ->
  elim Step () (\ x y r -> Eq Term x (pred p) -> Eq Term (pred p') y)
    ((\ c1 c2 q -> absurd (Eq Term (pred p') c1) (noConfusionTerm (ifthen true c1 c2) (pred p) q))
     (\ c1 c2 q -> absurd (Eq Term (pred p') c2) (noConfusionTerm (ifthen false c1 c2) (pred p) q))
     (\ c1 c2 c3 c4 sr ih q -> absurd (Eq Term (pred p') (ifthen c2 c3 c4)) (noConfusionTerm (ifthen c1 c3 c4) (pred p) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (pred p') (succ c2)) (noConfusionTerm (succ c1) (pred p) q))
     (\ q -> let nc2 : Eq Term zero p = noConfusionTerm (pred zero) (pred p) q in let e1 : Eq Term zero p = (nc2) in absurd (Eq Term (pred p') zero) (zeroNoStep p' (subst Term (\ x -> Step x p') p zero (sym Term zero p e1) (s0))))
     (\ c1 nv1 q -> let nc2 : Eq Term (succ c1) p = noConfusionTerm (pred (succ c1)) (pred p) q in let e1 : Eq Term (succ c1) p = (nc2) in absurd (Eq Term (pred p') c1) (nvNoStep (succ c1) (nvSucc c1 nv1) p' (subst Term (\ x -> Step x p') p (succ c1) (sym Term (succ c1) p e1) (s0))))
     (\ c1 c2 sr ih q -> let nc2 : Eq Term c1 p = noConfusionTerm (pred c1) (pred p) q in let e1 : Eq Term c1 p = (nc2) in cong Term Term (\ x -> pred x) p' c2 (ih0 c2 (subst Term (\ x -> Step x c2) c1 p (e1) (sr))))
     (\ q -> absurd (Eq Term (pred p') true) (noConfusionTerm (iszero zero) (pred p) q))
     (\ c1 nv1 q -> absurd (Eq Term (pred p') false) (noConfusionTerm (iszero (succ c1)) (pred p) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (pred p') (iszero c2)) (noConfusionTerm (iszero c1) (pred p) q)))
    ((pred p) u) s (refl Term (pred p))

invIsZeroZero : ∀ (u : Term) (s : Step (iszero zero) u) -> Eq Term true u
invIsZeroZero = \ u s ->
  elim Step () (\ x y r -> Eq Term x (iszero zero) -> Eq Term true y)
    ((\ c1 c2 q -> absurd (Eq Term true c1) (noConfusionTerm (ifthen true c1 c2) (iszero zero) q))
     (\ c1 c2 q -> absurd (Eq Term true c2) (noConfusionTerm (ifthen false c1 c2) (iszero zero) q))
     (\ c1 c2 c3 c4 sr ih q -> absurd (Eq Term true (ifthen c2 c3 c4)) (noConfusionTerm (ifthen c1 c3 c4) (iszero zero) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term true (succ c2)) (noConfusionTerm (succ c1) (iszero zero) q))
     (\ q -> absurd (Eq Term true zero) (noConfusionTerm (pred zero) (iszero zero) q))
     (\ c1 nv1 q -> absurd (Eq Term true c1) (noConfusionTerm (pred (succ c1)) (iszero zero) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term true (pred c2)) (noConfusionTerm (pred c1) (iszero zero) q))
     (\ q -> let nc2 : Eq Term zero zero = noConfusionTerm (iszero zero) (iszero zero) q in let e1 : Eq Term zero zero = (nc2) in refl Term true)
     (\ c1 nv1 q -> let nc2 : Eq Term (succ c1) zero = noConfusionTerm (iszero (succ c1)) (iszero zero) q in let e1 : Eq Term (succ c1) zero = (nc2) in absurd (Eq Term true false) (noConfusionTerm (succ c1) zero e1))
     (\ c1 c2 sr ih q -> let nc2 : Eq Term c1 zero = noConfusionTerm (iszero c1) (iszero zero) q in let e1 : Eq Term c1 zero = (nc2) in absurd (Eq Term true (iszero c2)) (zeroNoStep c2 (subst Term (\ x -> Step x c2) c1 zero (e1) (sr)))))
    ((iszero zero) u) s (refl Term (iszero zero))

invIsZeroSucc : ∀ (v : Term) (nv : NV v) (u : Term) (s : Step (iszero (succ v)) u) -> Eq Term false u
invIsZeroSucc = \ v nv u s ->
  elim Step () (\ x y r -> Eq Term x (iszero (succ v)) -> Eq Term false y)
    ((\ c1 c2 q -> absurd (Eq Term false c1) (noConfusionTerm (ifthen true c1 c2) (iszero (succ v)) q))
     (\ c1 c2 q -> absurd (Eq Term false c2) (noConfusionTerm (ifthen false c1 c2) (iszero (succ v)) q))
     (\ c1 c2 c3 c4 sr ih q -> absurd (Eq Term false (ifthen c2 c3 c4)) (noConfusionTerm (ifthen c1 c3 c4) (iszero (succ v)) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term false (succ c2)) (noConfusionTerm (succ c1) (iszero (succ v)) q))
     (\ q -> absurd (Eq Term false zero) (noConfusionTerm (pred zero) (iszero (succ v)) q))
     (\ c1 nv1 q -> absurd (Eq Term false c1) (noConfusionTerm (pred (succ c1)) (iszero (succ v)) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term false (pred c2)) (noConfusionTerm (pred c1) (iszero (succ v)) q))
     (\ q -> let nc2 : Eq Term zero (succ v) = noConfusionTerm (iszero zero) (iszero (succ v)) q in let e1 : Eq Term zero (succ v) = (nc2) in absurd (Eq Term false true) (noConfusionTerm zero (succ v) e1))
     (\ c1 nv1 q -> let nc2 : Eq Term (succ c1) (succ v) = noConfusionTerm (iszero (succ c1)) (iszero (succ v)) q in let e1 : Eq Term (succ c1) (succ v) = (nc2) in let nc4 : Eq Term c1 v = noConfusionTerm (succ c1) (succ v) e1 in let e3 : Eq Term c1 v = (nc4) in refl Term false)
     (\ c1 c2 sr ih q -> let nc2 : Eq Term c1 (succ v) = noConfusionTerm (iszero c1) (iszero (succ v)) q in let e1 : Eq Term c1 (succ v) = (nc2) in absurd (Eq Term false (iszero c2)) (nvNoStep (succ v) (nvSucc v nv) c2 (subst Term (\ x -> Step x c2) c1 (succ v) (e1) (sr)))))
    ((iszero (succ v)) u) s (refl Term (iszero (succ v)))

invIsZero : ∀ (p : Term) (p' : Term) (s0 : Step p p') (ih0 : ∀ (w : Term) (sw : Step p w) -> Eq Term p' w) (u : Term) (s : Step (iszero p) u) -> Eq Term (iszero p') u
invIsZero = \ p p' s0 ih0 u s ->
  elim Step () (\ x y r -> Eq Term x (iszero p) -> Eq Term (iszero p') y)
    ((\ c1 c2 q -> absurd (Eq Term (iszero p') c1) (noConfusionTerm (ifthen true c1 c2) (iszero p) q))
     (\ c1 c2 q -> absurd (Eq Term (iszero p') c2) (noConfusionTerm (ifthen false c1 c2) (iszero p) q))
     (\ c1 c2 c3 c4 sr ih q -> absurd (Eq Term (iszero p') (ifthen c2 c3 c4)) (noConfusionTerm (ifthen c1 c3 c4) (iszero p) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (iszero p') (succ c2)) (noConfusionTerm (succ c1) (iszero p) q))
     (\ q -> absurd (Eq Term (iszero p') zero) (noConfusionTerm (pred zero) (iszero p) q))
     (\ c1 nv1 q -> absurd (Eq Term (iszero p') c1) (noConfusionTerm (pred (succ c1)) (iszero p) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (iszero p') (pred c2)) (noConfusionTerm (pred c1) (iszero p) q))
     (\ q -> let nc2 : Eq Term zero p = noConfusionTerm (iszero zero) (iszero p) q in let e1 : Eq Term zero p = (nc2) in absurd (Eq Term (iszero p') true) (zeroNoStep p' (subst Term (\ x -> Step x p') p zero (sym Term zero p e1) (s0))))
     (\ c1 nv1 q -> let nc2 : Eq Term (succ c1) p = noConfusionTerm (iszero (succ c1)) (iszero p) q in let e1 : Eq Term (succ c1) p = (nc2) in absurd (Eq Term (iszero p') false) (nvNoStep (succ c1) (nvSucc c1 nv1) p' (subst Term (\ x -> Step x p') p (succ c1) (sym Term (succ c1) p e1) (s0))))
     (\ c1 c2 sr ih q -> let nc2 : Eq Term c1 p = noConfusionTerm (iszero c1) (iszero p) q in let e1 : Eq Term c1 p = (nc2) in cong Term Term (\ x -> iszero x) p' c2 (ih0 c2 (subst Term (\ x -> Step x c2) c1 p (e1) (sr)))))
    ((iszero p) u) s (refl Term (iszero p))

determinacy : ∀ (t : Term) (t1 : Term) (s1 : Step t t1) (t2 : Term) (s2 : Step t t2) -> Eq Term t1 t2
determinacy = \ t t1 s1 ->
  elim Step () (\ x y r -> ∀ (u : Term) -> Step x u -> Eq Term y u)
    ((\ c1 c2 -> invIfTrue c1 c2)
     (\ c1 c2 -> invIfFalse c1 c2)
     (\ c1 c2 c3 c4 sr ih -> invIf c1 c2 c3 c4 sr ih)
     (\ c1 c2 sr ih -> invSucc c1 c2 sr ih)
     (invPredZero)
     (\ c1 nv1 -> invPredSucc c1 nv1)
     (\ c1 c2 sr ih -> invPred c1 c2 sr ih)
     (invIsZeroZero)
     (\ c1 nv1 -> invIsZeroSucc c1 nv1)
     (\ c1 c2 sr ih -> invIsZero c1 c2 sr ih))
    (t t1) s1
