-- POPLMark problem 1A: transitivity of subtyping, with narrowing.
--
-- LOAD AFTER 01-syntax.thena, 02-subtyping.thena AND 03-typing.thena.
--
-- The challenge's crux. Transitivity is not a rule of the system, it is a
-- lemma, and its proof needs narrowing simultaneously: in the SA-All case the
-- two subderivations bind the same type variable at DIFFERENT bounds, so one
-- of them has to be narrowed before transitivity applies to the bodies. The
-- induction is on the structure of the middle type, with an inner induction
-- on derivations.

module FsubTransitivity where

-- ---------------------------------------------------------------------------
-- The usual four, as 07 defines them: equality is an ordinary datatype here.

absurdly : forall (C : Type₀) (e : Empty) -> C
absurdly = \ C e -> elim Empty () (\ t -> C) () () e

substEq : forall (A : Type₀) (P : A -> Type₀) (a : A) (b : A) (e : Eq A a b) (p : P a) -> P b
substEq = \ A P a b e p -> elim Eq (A) (\ x y q -> P x -> P y) ((\ c -> \ z -> z)) (a b) e p

symEq : forall (A : Type₀) (a : A) (b : A) (e : Eq A a b) -> Eq A b a
symEq = \ A a b e -> substEq A (\ z -> Eq A z a) a b e (refl A a)

transEq : forall (A : Type₀) (a : A) (b : A) (c : A) (e1 : Eq A a b) (e2 : Eq A b c) -> Eq A a c
transEq = \ A a b c e1 e2 -> substEq A (\ z -> Eq A a z) b c e2 e1

-- A disjunction, as 07 declares it: And is in the prelude and Or is not.
data Or (A : Type₀) (B : Type₀) : Type₀ where
  orLeft  : forall (a : A) -> Or A B
  orRight : forall (b : B) -> Or A B


-- ---------------------------------------------------------------------------
-- Reflexivity. An induction on the TYPE, and the variable case is a rule, so
-- this one needs nothing about contexts at all.

subRefl : forall (T : Ty) (G : Ctx) -> sub G T T
subRefl = \ T ->
  elim Ty () (\ T0 -> forall (G : Ctx) -> sub G T0 T0)
    ((\ Z G -> SA-Refl-TVar G Z)
     (\ G -> SA-Top G Ty`⊤`)
     (\ A B ihA ihB G -> SA-Arrow G A A B B (ihA G) (ihB G))
     (\ Z A B ihA ihB G -> SA-All G A A Z B B (ihA G) (ihB (bindTy G Z A))))
    () T


-- ---------------------------------------------------------------------------
-- Inversion of subtyping on the SHAPE OF THE LOWER TYPE.
--
-- `sub` gets no no-confusion lemma — SA-Trans-TVar's second premise has a
-- type that mentions an earlier argument, so its equation cannot be stated —
-- so inversion is done the way 07 does it: eliminate the derivation with a
-- motive that takes an equation pinning the index, then hand it `refl`.

-- Nothing is above ⊤ but ⊤.
topSuper : forall (G : Ctx) (T : Ty) (d : sub G Ty`⊤` T) -> Eq Ty T Ty`⊤`
topSuper = \ G T d ->
  elim sub () (\ G0 S0 T0 d0 -> Eq Ty S0 Ty`⊤` -> Eq Ty T0 Ty`⊤`)
    ((\ G0 S0 e -> refl Ty Ty`⊤`)
     (\ G0 Z e -> absurdly (Eq Ty Ty`${Z}` Ty`⊤`) (noConfusionTy Ty`${Z}` Ty`⊤` e))
     (\ Z U G0 T0 lk p1 ih1 e -> absurdly (Eq Ty T0 Ty`⊤`) (noConfusionTy Ty`${Z}` Ty`⊤` e))
     (\ G0 T1 S1 S2 T2 p1 p2 ih1 ih2 e ->
        absurdly (Eq Ty Ty`( ${T1} -> ${T2} )` Ty`⊤`)
          (noConfusionTy Ty`( ${S1} -> ${S2} )` Ty`⊤` e))
     (\ G0 T1 S1 Z S2 T2 p1 p2 ih1 ih2 e ->
        absurdly (Eq Ty Ty`( ∀ ${Z} <: ${T1} . ${T2} )` Ty`⊤`)
          (noConfusionTy Ty`( ∀ ${Z} <: ${S1} . ${S2} )` Ty`⊤` e)))
    (G Ty`⊤` T) d (refl Ty Ty`⊤`)

-- Above an arrow there is ⊤, or an arrow, and then the two parts are related
-- the way SA-Arrow relates them.
data ArrowSuper (G : Ctx) (A : Ty) (B : Ty) : Ty -> Type₀ where
  AS-Top   : ArrowSuper G A B Ty`⊤`
  AS-Arrow : forall (C : Ty) (D : Ty) (d1 : sub G C A) (d2 : sub G B D)
               -> ArrowSuper G A B Ty`( ${C} -> ${D} )`

arrowSuper : forall (G : Ctx) (A : Ty) (B : Ty) (T : Ty) (d : sub G Ty`( ${A} -> ${B} )` T)
               -> ArrowSuper G A B T
arrowSuper = \ G A B T d ->
  elim sub () (\ G0 S0 T0 d0 -> Eq Ty S0 Ty`( ${A} -> ${B} )` -> ArrowSuper G0 A B T0)
    ((\ G0 S0 e -> AS-Top G0 A B)
     (\ G0 Z e ->
        absurdly (ArrowSuper G0 A B Ty`${Z}`)
          (noConfusionTy Ty`${Z}` Ty`( ${A} -> ${B} )` e))
     (\ Z U G0 T0 lk p1 ih1 e ->
        absurdly (ArrowSuper G0 A B T0)
          (noConfusionTy Ty`${Z}` Ty`( ${A} -> ${B} )` e))
     (\ G0 T1 S1 S2 T2 p1 p2 ih1 ih2 e ->
        AS-Arrow G0 A B T1 T2
          (substEq Ty (\ z -> sub G0 T1 z) S1 A
            (andLeft (Eq Ty S1 A) (Eq Ty S2 B) (noConfusionTy Ty`( ${S1} -> ${S2} )` Ty`( ${A} -> ${B} )` e)) p1)
          (substEq Ty (\ z -> sub G0 z T2) S2 B
            (andRight (Eq Ty S1 A) (Eq Ty S2 B) (noConfusionTy Ty`( ${S1} -> ${S2} )` Ty`( ${A} -> ${B} )` e)) p2))
     (\ G0 T1 S1 Z S2 T2 p1 p2 ih1 ih2 e ->
        absurdly (ArrowSuper G0 A B Ty`( ∀ ${Z} <: ${T1} . ${T2} )`)
          (noConfusionTy Ty`( ∀ ${Z} <: ${S1} . ${S2} )` Ty`( ${A} -> ${B} )` e)))
    (G Ty`( ${A} -> ${B} )` T) d (refl Ty Ty`( ${A} -> ${B} )`)

-- Above a quantifier there is ⊤, or a quantifier BINDING THE SAME NAME —
-- which is why no α-equivalence is needed anywhere in this proof: SA-All
-- shares one X between the two types it compares, so inverting a derivation
-- whose lower type is fixed hands back the same bound name.
data AllSuper (G : Ctx) (Z : String) (A : Ty) (B : Ty) : Ty -> Type₀ where
  ALS-Top : AllSuper G Z A B Ty`⊤`
  ALS-All : forall (C : Ty) (D : Ty) (d1 : sub G C A) (d2 : sub (bindTy G Z C) B D)
              -> AllSuper G Z A B Ty`( ∀ ${Z} <: ${C} . ${D} )`

allSuper : forall (G : Ctx) (Z : String) (A : Ty) (B : Ty) (T : Ty)
             (d : sub G Ty`( ∀ ${Z} <: ${A} . ${B} )` T) -> AllSuper G Z A B T
allSuper = \ G Z A B T d ->
  elim sub () (\ G0 S0 T0 d0 -> Eq Ty S0 Ty`( ∀ ${Z} <: ${A} . ${B} )` -> AllSuper G0 Z A B T0)
    ((\ G0 S0 e -> ALS-Top G0 Z A B)
     (\ G0 W e ->
        absurdly (AllSuper G0 Z A B Ty`${W}`)
          (noConfusionTy Ty`${W}` Ty`( ∀ ${Z} <: ${A} . ${B} )` e))
     (\ W U G0 T0 lk p1 ih1 e ->
        absurdly (AllSuper G0 Z A B T0)
          (noConfusionTy Ty`${W}` Ty`( ∀ ${Z} <: ${A} . ${B} )` e))
     (\ G0 T1 S1 S2 T2 p1 p2 ih1 ih2 e ->
        absurdly (AllSuper G0 Z A B Ty`( ${T1} -> ${T2} )`)
          (noConfusionTy Ty`( ${S1} -> ${S2} )` Ty`( ∀ ${Z} <: ${A} . ${B} )` e))
     (\ G0 T1 S1 W S2 T2 p1 p2 ih1 ih2 e ->
        substEq String (\ z -> AllSuper G0 Z A B Ty`( ∀ ${z} <: ${T1} . ${T2} )`) Z W
          (symEq String W Z
            (andLeft (Eq String W Z) (And (Eq Ty S1 A) (Eq Ty S2 B))
              (noConfusionTy Ty`( ∀ ${W} <: ${S1} . ${S2} )` Ty`( ∀ ${Z} <: ${A} . ${B} )` e)))
          (ALS-All G0 Z A B T1 T2
            (substEq Ty (\ z -> sub G0 T1 z) S1 A
              (andLeft (Eq Ty S1 A) (Eq Ty S2 B)
                (andRight (Eq String W Z) (And (Eq Ty S1 A) (Eq Ty S2 B))
                  (noConfusionTy Ty`( ∀ ${W} <: ${S1} . ${S2} )` Ty`( ∀ ${Z} <: ${A} . ${B} )` e)))
              p1)
            (substEq Ty (\ z -> sub (bindTy G0 Z T1) z T2) S2 B
              (andRight (Eq Ty S1 A) (Eq Ty S2 B)
                (andRight (Eq String W Z) (And (Eq Ty S1 A) (Eq Ty S2 B))
                  (noConfusionTy Ty`( ∀ ${W} <: ${S1} . ${S2} )` Ty`( ∀ ${Z} <: ${A} . ${B} )` e)))
              (substEq String (\ z -> sub (bindTy G0 z T1) S2 T2) W Z
                (andLeft (Eq String W Z) (And (Eq Ty S1 A) (Eq Ty S2 B))
                  (noConfusionTy Ty`( ∀ ${W} <: ${S1} . ${S2} )` Ty`( ∀ ${Z} <: ${A} . ${B} )` e))
                p2)))))
    (G Ty`( ∀ ${Z} <: ${A} . ${B} )` T) d (refl Ty Ty`( ∀ ${Z} <: ${A} . ${B} )`)


-- ---------------------------------------------------------------------------
-- Inversion of the type lookup, one shape of context at a time.

-- Nothing is declared in the empty context.
bindTyInEmpty : forall (Y : String) (U : Ty) (i : bindTy-in Y U Ctx`·`) -> Empty
bindTyInEmpty = \ Y U i ->
  elim bindTy-in () (\ Y1 U1 C1 i1 -> Eq Ctx C1 Ctx`·` -> Empty)
    ((\ G W S e -> noConfusionCtx (bindTy G W S) Ctx`·` e)
     (\ G W S w S' p ih e -> noConfusionCtx (bindTm G w S') Ctx`·` e)
     (\ G W S W' S' ne p ih e -> noConfusionCtx (bindTy G W' S') Ctx`·` e))
    (Y U Ctx`·`) i (refl Ctx Ctx`·`)

-- A type lookup past a TERM binding is a lookup in what is underneath: the
-- generated relation has no inequality to discharge here, because shadowing
-- is within a namespace.
bindTyInBindTm : forall (G : Ctx) (w : String) (S : Ty) (Y : String) (U : Ty)
                   (i : bindTy-in Y U (bindTm G w S)) -> bindTy-in Y U G
bindTyInBindTm = \ G w S Y U i ->
  elim bindTy-in () (\ Y1 U1 C1 i1 -> Eq Ctx C1 (bindTm G w S) -> bindTy-in Y1 U1 G)
    ((\ G0 W S0 e ->
        absurdly (bindTy-in W S0 G) (noConfusionCtx (bindTy G0 W S0) (bindTm G w S) e))
     (\ G0 W S0 w' S' p ih e ->
        substEq Ctx (\ c -> bindTy-in W S0 c) G0 G
          (andLeft (Eq Ctx G0 G) (And (Eq String w' w) (Eq Ty S' S))
            (noConfusionCtx (bindTm G0 w' S') (bindTm G w S) e)) p)
     (\ G0 W S0 W' S' ne p ih e ->
        absurdly (bindTy-in W S0 G) (noConfusionCtx (bindTy G0 W' S') (bindTm G w S) e)))
    (Y U (bindTm G w S)) i (refl Ctx (bindTm G w S))

-- A type lookup past a TYPE binding is either that binding, or a lookup
-- underneath it at a different name.
FoundTy : Ctx -> String -> Ty -> String -> Ty -> Type₀
FoundTy = \ G W S Y U ->
  Or (And (Eq String Y W) (Eq Ty U S))
     (And (Eq String Y W -> Empty) (bindTy-in Y U G))

bindTyInBindTy : forall (G : Ctx) (W : String) (S : Ty) (Y : String) (U : Ty)
                   (i : bindTy-in Y U (bindTy G W S)) -> FoundTy G W S Y U
bindTyInBindTy = \ G W S Y U i ->
  elim bindTy-in () (\ Y1 U1 C1 i1 -> Eq Ctx C1 (bindTy G W S) -> FoundTy G W S Y1 U1)
    ((\ G0 W0 S0 e ->
        orLeft (And (Eq String W0 W) (Eq Ty S0 S)) (And (Eq String W0 W -> Empty) (bindTy-in W0 S0 G))
          (both (Eq String W0 W) (Eq Ty S0 S)
            (andLeft (Eq String W0 W) (Eq Ty S0 S)
              (andRight (Eq Ctx G0 G) (And (Eq String W0 W) (Eq Ty S0 S))
                (noConfusionCtx (bindTy G0 W0 S0) (bindTy G W S) e)))
            (andRight (Eq String W0 W) (Eq Ty S0 S)
              (andRight (Eq Ctx G0 G) (And (Eq String W0 W) (Eq Ty S0 S))
                (noConfusionCtx (bindTy G0 W0 S0) (bindTy G W S) e)))))
     (\ G0 W0 S0 w' S' p ih e ->
        absurdly (FoundTy G W S W0 S0) (noConfusionCtx (bindTm G0 w' S') (bindTy G W S) e))
     (\ G0 W0 S0 W' S' ne p ih e ->
        orRight (And (Eq String W0 W) (Eq Ty S0 S)) (And (Eq String W0 W -> Empty) (bindTy-in W0 S0 G))
          (both (Eq String W0 W -> Empty) (bindTy-in W0 S0 G)
            (\ q -> ne (transEq String W0 W W' q
                          (symEq String W' W
                            (andLeft (Eq String W' W) (Eq Ty S' S)
                              (andRight (Eq Ctx G0 G) (And (Eq String W' W) (Eq Ty S' S))
                                (noConfusionCtx (bindTy G0 W' S') (bindTy G W S) e))))))
            (substEq Ctx (\ c -> bindTy-in W0 S0 c) G0 G
              (andLeft (Eq Ctx G0 G) (And (Eq String W' W) (Eq Ty S' S))
                (noConfusionCtx (bindTy G0 W' S') (bindTy G W S) e)) p))))
    (Y U (bindTy G W S)) i (refl Ctx (bindTy G W S))


-- ---------------------------------------------------------------------------
-- Weakening, RELATIVE TO A WITNESS. Nothing here needs a name to be fresh:
-- the witness is the hypothesis that every type binding Γ finds is found in
-- Γ₁ as well, and SA-All is the one case that has to extend it.

InclTy : Ctx -> Ctx -> Type₀
InclTy = \ G G1 -> forall (Y : String) (U : Ty) (i : bindTy-in Y U G) -> bindTy-in Y U G1

inclBindTy : forall (G : Ctx) (G1 : Ctx) (W : String) (S : Ty) (inc : InclTy G G1)
               -> InclTy (bindTy G W S) (bindTy G1 W S)
inclBindTy = \ G G1 W S inc Y U i ->
  elim Or ((And (Eq String Y W) (Eq Ty U S)) (And (Eq String Y W -> Empty) (bindTy-in Y U G)))
    (\ o -> bindTy-in Y U (bindTy G1 W S))
    ((\ h -> substEq String (\ z -> bindTy-in z U (bindTy G1 W S)) W Y
               (symEq String Y W (andLeft (Eq String Y W) (Eq Ty U S) h))
               (substEq Ty (\ V -> bindTy-in W V (bindTy G1 W S)) S U
                  (symEq Ty U S (andRight (Eq String Y W) (Eq Ty U S) h))
                  (bindTy-here G1 W S)))
     (\ h -> bindTy-there-bindTy G1 Y U W S
               (andLeft (Eq String Y W -> Empty) (bindTy-in Y U G) h)
               (inc Y U (andRight (Eq String Y W -> Empty) (bindTy-in Y U G) h))))
    () (bindTyInBindTy G W S Y U i)

inclBindTm : forall (G : Ctx) (G1 : Ctx) (w : String) (S : Ty) (inc : InclTy G G1)
               -> InclTy (bindTm G w S) (bindTm G1 w S)
inclBindTm = \ G G1 w S inc Y U i ->
  bindTy-there-bindTm G1 Y U w S (inc Y U (bindTyInBindTm G w S Y U i))

subWeaken : forall (G : Ctx) (S : Ty) (T : Ty) (d : sub G S T) (G1 : Ctx) (inc : InclTy G G1)
              -> sub G1 S T
subWeaken = \ G S T d ->
  elim sub () (\ G0 S0 T0 d0 -> forall (G1 : Ctx) (inc : InclTy G0 G1) -> sub G1 S0 T0)
    ((\ G0 S0 G1 inc -> SA-Top G1 S0)
     (\ G0 Z G1 inc -> SA-Refl-TVar G1 Z)
     (\ Z U G0 T0 lk p1 ih1 G1 inc -> SA-Trans-TVar Z U G1 T0 (inc Z U lk) (ih1 G1 inc))
     (\ G0 T1 S1 S2 T2 p1 p2 ih1 ih2 G1 inc -> SA-Arrow G1 T1 S1 S2 T2 (ih1 G1 inc) (ih2 G1 inc))
     (\ G0 T1 S1 Z S2 T2 p1 p2 ih1 ih2 G1 inc ->
        SA-All G1 T1 S1 Z S2 T2 (ih1 G1 inc)
          (ih2 (bindTy G1 Z T1) (inclBindTy G0 G1 Z T1 inc))))
    (G S T) d


-- ---------------------------------------------------------------------------
-- The lookup lemma of narrowing: what a type lookup in Γ , X <: Q , Δ becomes
-- when the bound Q is replaced by P. An induction on Δ, pushing through the
-- append the paper's comma stands for.
--
-- Either the lookup survives the swap untouched, or it IS the swapped entry —
-- and in that case it also hands back the lookup of the NEW bound, which is
-- what the narrowing proof needs to go on with. Carrying that witness in the
-- second disjunct is what makes the X-is-the-narrowed-variable case work: the
-- original lookup stepped over all of Δ, so X is not shadowed in Δ either.

NFound1 : Ctx -> String -> Ty -> Ctx -> String -> Ty -> Type₀
NFound1 = \ G Xn P D Y U -> bindTy-in Y U (append (bindTy G Xn P) D)

NFound2 : Ctx -> String -> Ty -> Ty -> Ctx -> String -> Ty -> Type₀
NFound2 = \ G Xn Q P D Y U ->
  And (And (Eq String Y Xn) (Eq Ty U Q)) (bindTy-in Xn P (append (bindTy G Xn P) D))

NarrowFound : Ctx -> String -> Ty -> Ty -> Ctx -> String -> Ty -> Type₀
NarrowFound = \ G Xn Q P D Y U -> Or (NFound1 G Xn P D Y U) (NFound2 G Xn Q P D Y U)

narrowLookup : forall (G : Ctx) (Xn : String) (Q : Ty) (P : Ty) (D : Ctx)
                 (Y : String) (U : Ty) (i : bindTy-in Y U (append (bindTy G Xn Q) D))
                 -> NarrowFound G Xn Q P D Y U
narrowLookup = \ G Xn Q P D ->
  elim Ctx () (\ D0 -> forall (Y : String) (U : Ty)
                         (i : bindTy-in Y U (append (bindTy G Xn Q) D0))
                         -> NarrowFound G Xn Q P D0 Y U)
    (-- Δ is empty: the lookup is in Γ , X <: Q itself.
     (\ Y U i ->
        elim Or ((And (Eq String Y Xn) (Eq Ty U Q))
                 (And (Eq String Y Xn -> Empty) (bindTy-in Y U G)))
          (\ o -> NarrowFound G Xn Q P Ctx`·` Y U)
          ((\ h -> orRight (NFound1 G Xn P Ctx`·` Y U) (NFound2 G Xn Q P Ctx`·` Y U)
                     (both (And (Eq String Y Xn) (Eq Ty U Q))
                           (bindTy-in Xn P (append (bindTy G Xn P) Ctx`·`))
                       h (bindTy-here G Xn P)))
           (\ h -> orLeft (NFound1 G Xn P Ctx`·` Y U) (NFound2 G Xn Q P Ctx`·` Y U)
                     (bindTy-there-bindTy G Y U Xn P
                       (andLeft (Eq String Y Xn -> Empty) (bindTy-in Y U G) h)
                       (andRight (Eq String Y Xn -> Empty) (bindTy-in Y U G) h))))
          () (bindTyInBindTy G Xn Q Y U i))
     -- Δ ends in a term binding: step over it on both sides.
     (\ D0 w S ih Y U i ->
        elim Or ((NFound1 G Xn P D0 Y U) (NFound2 G Xn Q P D0 Y U))
          (\ o -> NarrowFound G Xn Q P (bindTm D0 w S) Y U)
          ((\ h -> orLeft (NFound1 G Xn P (bindTm D0 w S) Y U)
                          (NFound2 G Xn Q P (bindTm D0 w S) Y U)
                     (bindTy-there-bindTm (append (bindTy G Xn P) D0) Y U w S h))
           (\ h -> orRight (NFound1 G Xn P (bindTm D0 w S) Y U)
                           (NFound2 G Xn Q P (bindTm D0 w S) Y U)
                     (both (And (Eq String Y Xn) (Eq Ty U Q))
                           (bindTy-in Xn P (append (bindTy G Xn P) (bindTm D0 w S)))
                       (andLeft (And (Eq String Y Xn) (Eq Ty U Q))
                                (bindTy-in Xn P (append (bindTy G Xn P) D0)) h)
                       (bindTy-there-bindTm (append (bindTy G Xn P) D0) Xn P w S
                         (andRight (And (Eq String Y Xn) (Eq Ty U Q))
                                   (bindTy-in Xn P (append (bindTy G Xn P) D0)) h)))))
          () (ih Y U (bindTyInBindTm (append (bindTy G Xn Q) D0) w S Y U i)))
     -- Δ ends in a type binding: it may be the entry found, and then it is in
     -- Δ and the swap of Q for P does not touch it.
     (\ D0 W S ih Y U i ->
        elim Or ((And (Eq String Y W) (Eq Ty U S))
                 (And (Eq String Y W -> Empty) (bindTy-in Y U (append (bindTy G Xn Q) D0))))
          (\ o -> NarrowFound G Xn Q P (bindTy D0 W S) Y U)
          ((\ h -> orLeft (NFound1 G Xn P (bindTy D0 W S) Y U)
                          (NFound2 G Xn Q P (bindTy D0 W S) Y U)
                     (substEq String (\ z -> bindTy-in z U (bindTy (append (bindTy G Xn P) D0) W S)) W Y
                       (symEq String Y W (andLeft (Eq String Y W) (Eq Ty U S) h))
                       (substEq Ty (\ V -> bindTy-in W V (bindTy (append (bindTy G Xn P) D0) W S)) S U
                         (symEq Ty U S (andRight (Eq String Y W) (Eq Ty U S) h))
                         (bindTy-here (append (bindTy G Xn P) D0) W S))))
           (\ h ->
              elim Or ((NFound1 G Xn P D0 Y U) (NFound2 G Xn Q P D0 Y U))
                (\ o -> NarrowFound G Xn Q P (bindTy D0 W S) Y U)
                ((\ g -> orLeft (NFound1 G Xn P (bindTy D0 W S) Y U)
                                (NFound2 G Xn Q P (bindTy D0 W S) Y U)
                           (bindTy-there-bindTy (append (bindTy G Xn P) D0) Y U W S
                             (andLeft (Eq String Y W -> Empty)
                                      (bindTy-in Y U (append (bindTy G Xn Q) D0)) h)
                             g))
                 (\ g -> orRight (NFound1 G Xn P (bindTy D0 W S) Y U)
                                 (NFound2 G Xn Q P (bindTy D0 W S) Y U)
                           (both (And (Eq String Y Xn) (Eq Ty U Q))
                                 (bindTy-in Xn P (append (bindTy G Xn P) (bindTy D0 W S)))
                             (andLeft (And (Eq String Y Xn) (Eq Ty U Q))
                                      (bindTy-in Xn P (append (bindTy G Xn P) D0)) g)
                             (bindTy-there-bindTy (append (bindTy G Xn P) D0) Xn P W S
                               (\ q -> andLeft (Eq String Y W -> Empty)
                                               (bindTy-in Y U (append (bindTy G Xn Q) D0)) h
                                         (transEq String Y Xn W
                                           (andLeft (Eq String Y Xn) (Eq Ty U Q)
                                             (andLeft (And (Eq String Y Xn) (Eq Ty U Q))
                                                      (bindTy-in Xn P (append (bindTy G Xn P) D0)) g))
                                           q))
                               (andRight (And (Eq String Y Xn) (Eq Ty U Q))
                                         (bindTy-in Xn P (append (bindTy G Xn P) D0)) g)))))
                () (ih Y U (andRight (Eq String Y W -> Empty)
                                     (bindTy-in Y U (append (bindTy G Xn Q) D0)) h))))
          () (bindTyInBindTy (append (bindTy G Xn Q) D0) W S Y U i)))
    () D


-- ---------------------------------------------------------------------------
-- The two statements, and the shape of the proof they want.
--
-- Transitivity and narrowing go together: the induction is on the STRUCTURE
-- OF THE MIDDLE TYPE Q, and for one Q the two statements lean on each other —
-- narrowing at Q uses transitivity at the same Q, and transitivity at Q uses
-- both at the proper parts of Q. So the outer induction proves the pair.

TransAt : Ty -> Type₀
TransAt = \ Q -> forall (G : Ctx) (S : Ty) (T : Ty) (d1 : sub G S Q) (d2 : sub G Q T) -> sub G S T

NarrowAt : Ty -> Type₀
NarrowAt = \ Q -> forall (G : Ctx) (Xn : String) (D : Ctx) (M : Ty) (N : Ty) (P : Ty)
                    (d : sub (append (bindTy G Xn Q) D) M N) (dp : sub G P Q)
                    -> sub (append (bindTy G Xn P) D) M N

-- Three of the four cases of that outer induction, proved. Each is an inner
-- induction on the derivation of the LEFT premise, with the motive carrying an
-- equation that pins the middle index to the Q the case is about — the only
-- way to have the outer hypothesis apply, since `sub` has no no-confusion
-- lemma to invert the index with directly.

-- Q = ⊤. Nothing is above ⊤, so the right premise says T is ⊤ and SA-Top
-- closes it with no induction at all.
transTop : TransAt Ty`⊤`
transTop = \ G S T d1 d2 ->
  substEq Ty (\ z -> sub G S z) Ty`⊤` T (symEq Ty T Ty`⊤` (topSuper G T d2)) (SA-Top G S)

-- Q = X. The left premise is either SA-Refl-TVar, and then the right premise
-- IS the conclusion, or SA-Trans-TVar, and the inner hypothesis does it.
transTVar : forall (Z : String) -> TransAt Ty`${Z}`
transTVar = \ Z G S T d1 d2 ->
  elim sub () (\ G0 S0 Q0 d0 -> Eq Ty Q0 Ty`${Z}`
                 -> forall (T0 : Ty) (dd : sub G0 Q0 T0) -> sub G0 S0 T0)
    ((\ G0 S0 e T0 dd -> absurdly (sub G0 S0 T0) (noConfusionTy Ty`⊤` Ty`${Z}` e))
     (\ G0 W e T0 dd -> dd)
     (\ W U G0 T1 lk p1 ih1 e T0 dd -> SA-Trans-TVar W U G0 T0 lk (ih1 e T0 dd))
     (\ G0 T1 S1 S2 T2 p1 p2 ih1 ih2 e T0 dd ->
        absurdly (sub G0 Ty`( ${S1} -> ${S2} )` T0)
          (noConfusionTy Ty`( ${T1} -> ${T2} )` Ty`${Z}` e))
     (\ G0 T1 S1 W S2 T2 p1 p2 ih1 ih2 e T0 dd ->
        absurdly (sub G0 Ty`( ∀ ${W} <: ${S1} . ${S2} )` T0)
          (noConfusionTy Ty`( ∀ ${W} <: ${T1} . ${T2} )` Ty`${Z}` e)))
    (G S Ty`${Z}`) d1 (refl Ty Ty`${Z}`) T d2

-- Q = Q₁ -> Q₂. The first case that uses the outer hypothesis, and it uses it
-- at both parts: once contravariantly on the argument, once on the result.
transArrow : forall (Q1 : Ty) (Q2 : Ty) (ihQ1 : TransAt Q1) (ihQ2 : TransAt Q2)
               -> TransAt Ty`( ${Q1} -> ${Q2} )`
transArrow = \ Q1 Q2 ihQ1 ihQ2 G S T d1 d2 ->
  elim sub () (\ G0 S0 Q0 d0 -> Eq Ty Q0 Ty`( ${Q1} -> ${Q2} )`
                 -> forall (T0 : Ty) (dd : sub G0 Q0 T0) -> sub G0 S0 T0)
    ((\ G0 S0 e T0 dd ->
        absurdly (sub G0 S0 T0) (noConfusionTy Ty`⊤` Ty`( ${Q1} -> ${Q2} )` e))
     (\ G0 W e T0 dd ->
        absurdly (sub G0 Ty`${W}` T0) (noConfusionTy Ty`${W}` Ty`( ${Q1} -> ${Q2} )` e))
     (\ W U G0 T1 lk p1 ih1 e T0 dd -> SA-Trans-TVar W U G0 T0 lk (ih1 e T0 dd))
     (\ G0 T1 S1 S2 T2 p1 p2 ih1 ih2 e T0 dd ->
        elim ArrowSuper (G0 T1 T2) (\ T0' a -> sub G0 Ty`( ${S1} -> ${S2} )` T0')
          ((SA-Top G0 Ty`( ${S1} -> ${S2} )`)
           (\ C D dC dD ->
              SA-Arrow G0 C S1 S2 D
                (ihQ1 G0 C S1
                  (substEq Ty (\ z -> sub G0 C z) T1 Q1
                    (andLeft (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                      (noConfusionTy Ty`( ${T1} -> ${T2} )` Ty`( ${Q1} -> ${Q2} )` e)) dC)
                  (substEq Ty (\ z -> sub G0 z S1) T1 Q1
                    (andLeft (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                      (noConfusionTy Ty`( ${T1} -> ${T2} )` Ty`( ${Q1} -> ${Q2} )` e)) p1))
                (ihQ2 G0 S2 D
                  (substEq Ty (\ z -> sub G0 S2 z) T2 Q2
                    (andRight (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                      (noConfusionTy Ty`( ${T1} -> ${T2} )` Ty`( ${Q1} -> ${Q2} )` e)) p2)
                  (substEq Ty (\ z -> sub G0 z D) T2 Q2
                    (andRight (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                      (noConfusionTy Ty`( ${T1} -> ${T2} )` Ty`( ${Q1} -> ${Q2} )` e)) dD))))
          (T0) (arrowSuper G0 T1 T2 T0 dd))
     (\ G0 T1 S1 W S2 T2 p1 p2 ih1 ih2 e T0 dd ->
        absurdly (sub G0 Ty`( ∀ ${W} <: ${S1} . ${S2} )` T0)
          (noConfusionTy Ty`( ∀ ${W} <: ${T1} . ${T2} )` Ty`( ${Q1} -> ${Q2} )` e)))
    (G S Ty`( ${Q1} -> ${Q2} )`) d1 (refl Ty Ty`( ${Q1} -> ${Q2} )`) T d2


-- ---------------------------------------------------------------------------
-- Narrowing, in full, from transitivity at the same Q — AND ONE MORE THING.
--
-- `wk` below is the step the paper takes silently: a derivation in Γ still
-- holds in Γ , X <: P , Δ. Everything else in narrowing is proved here, so
-- `wk` is the entire remaining distance to problem 1A. The section after this
-- one shows that it cannot be proved as stated.

narrowFrom : forall (Q : Ty) (tr : TransAt Q)
               (wk : forall (G : Ctx) (Xn : String) (D : Ctx) (P : Ty) (dp : sub G P Q)
                       -> sub (append (bindTy G Xn P) D) P Q)
               -> NarrowAt Q
narrowFrom = \ Q tr wk G Xn D M N P d dp ->
  elim sub () (\ C0 M0 N0 d0 -> forall (G1 : Ctx) (Xn1 : String) (D1 : Ctx) (P1 : Ty)
                 (e : Eq Ctx C0 (append (bindTy G1 Xn1 Q) D1)) (dp1 : sub G1 P1 Q)
                 -> sub (append (bindTy G1 Xn1 P1) D1) M0 N0)
    ((\ C0 S0 G1 Xn1 D1 P1 e dp1 -> SA-Top (append (bindTy G1 Xn1 P1) D1) S0)
     (\ C0 W G1 Xn1 D1 P1 e dp1 -> SA-Refl-TVar (append (bindTy G1 Xn1 P1) D1) W)
     (\ W U C0 N0 lk p1 ih1 G1 Xn1 D1 P1 e dp1 ->
        elim Or ((NFound1 G1 Xn1 P1 D1 W U) (NFound2 G1 Xn1 Q P1 D1 W U))
          (\ o -> sub (append (bindTy G1 Xn1 P1) D1) Ty`${W}` N0)
          ((\ h -> SA-Trans-TVar W U (append (bindTy G1 Xn1 P1) D1) N0 h
                     (ih1 G1 Xn1 D1 P1 e dp1))
           (\ h ->
              substEq String (\ z -> sub (append (bindTy G1 Xn1 P1) D1) Ty`${z}` N0) Xn1 W
                (symEq String W Xn1
                  (andLeft (Eq String W Xn1) (Eq Ty U Q)
                    (andLeft (And (Eq String W Xn1) (Eq Ty U Q))
                             (bindTy-in Xn1 P1 (append (bindTy G1 Xn1 P1) D1)) h)))
                (SA-Trans-TVar Xn1 P1 (append (bindTy G1 Xn1 P1) D1) N0
                  (andRight (And (Eq String W Xn1) (Eq Ty U Q))
                            (bindTy-in Xn1 P1 (append (bindTy G1 Xn1 P1) D1)) h)
                  (tr (append (bindTy G1 Xn1 P1) D1) P1 N0
                    (wk G1 Xn1 D1 P1 dp1)
                    (substEq Ty (\ z -> sub (append (bindTy G1 Xn1 P1) D1) z N0) U Q
                      (andRight (Eq String W Xn1) (Eq Ty U Q)
                        (andLeft (And (Eq String W Xn1) (Eq Ty U Q))
                                 (bindTy-in Xn1 P1 (append (bindTy G1 Xn1 P1) D1)) h))
                      (ih1 G1 Xn1 D1 P1 e dp1))))))
          () (narrowLookup G1 Xn1 Q P1 D1 W U
               (substEq Ctx (\ c -> bindTy-in W U c) C0 (append (bindTy G1 Xn1 Q) D1) e lk)))
     (\ C0 T1 S1 S2 T2 p1 p2 ih1 ih2 G1 Xn1 D1 P1 e dp1 ->
        SA-Arrow (append (bindTy G1 Xn1 P1) D1) T1 S1 S2 T2
          (ih1 G1 Xn1 D1 P1 e dp1) (ih2 G1 Xn1 D1 P1 e dp1))
     (\ C0 T1 S1 W S2 T2 p1 p2 ih1 ih2 G1 Xn1 D1 P1 e dp1 ->
        SA-All (append (bindTy G1 Xn1 P1) D1) T1 S1 W S2 T2
          (ih1 G1 Xn1 D1 P1 e dp1)
          (ih2 G1 Xn1 (bindTy D1 W T1) P1
            (substEq Ctx (\ c -> Eq Ctx (bindTy C0 W T1) (bindTy c W T1))
              C0 (append (bindTy G1 Xn1 Q) D1) e (refl Ctx (bindTy C0 W T1)))
            dp1)))
    ((append (bindTy G Xn Q) D) M N) d G Xn D P
    (refl Ctx (append (bindTy G Xn Q) D)) dp


-- The fourth case, and the one the challenge is really about. Q = ∀Z<:Q₁.Q₂.
--
-- Both derivations end in SA-All, and their bodies are compared under
-- DIFFERENT bounds — the left one under Q₁, the right one under the C that
-- inverting the right premise hands back. So the left body's derivation is
-- NARROWED from Q₁ to C first, and only then does transitivity at Q₂ apply.
-- That is the mutual step, and it is why narrowing has to be proved alongside.
--
-- The bound name is shared rather than renamed: SA-All writes one X for both
-- types it compares, so inverting a derivation whose lower type is fixed hands
-- back the same name, and no α-equivalence is needed. That was the one thing
-- POPLMARK.md predicted would hurt here and it does not.
transAll : forall (Z : String) (Q1 : Ty) (Q2 : Ty)
             (trQ1 : TransAt Q1) (naQ1 : NarrowAt Q1) (trQ2 : TransAt Q2)
             -> TransAt Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )`
transAll = \ Z Q1 Q2 trQ1 naQ1 trQ2 G S T d1 d2 ->
  elim sub () (\ G0 S0 Q0 d0 -> Eq Ty Q0 Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )`
                 -> forall (T0 : Ty) (dd : sub G0 Q0 T0) -> sub G0 S0 T0)
    ((\ G0 S0 e T0 dd ->
        absurdly (sub G0 S0 T0)
          (noConfusionTy Ty`⊤` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e))
     (\ G0 W e T0 dd ->
        absurdly (sub G0 Ty`${W}` T0)
          (noConfusionTy Ty`${W}` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e))
     (\ W U G0 T1 lk p1 ih1 e T0 dd -> SA-Trans-TVar W U G0 T0 lk (ih1 e T0 dd))
     (\ G0 T1 S1 S2 T2 p1 p2 ih1 ih2 e T0 dd ->
        absurdly (sub G0 Ty`( ${S1} -> ${S2} )` T0)
          (noConfusionTy Ty`( ${T1} -> ${T2} )` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e))
     (\ G0 T1 S1 W S2 T2 p1 p2 ih1 ih2 e T0 dd ->
        elim AllSuper (G0 W T1 T2) (\ T0' a -> sub G0 Ty`( ∀ ${W} <: ${S1} . ${S2} )` T0')
          ((SA-Top G0 Ty`( ∀ ${W} <: ${S1} . ${S2} )`)
           (\ C Dd dC dD ->
              SA-All G0 C S1 W S2 Dd
                (trQ1 G0 C S1
                  (substEq Ty (\ z -> sub G0 C z) T1 Q1
                    (andLeft (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                      (andRight (Eq String W Z) (And (Eq Ty T1 Q1) (Eq Ty T2 Q2))
                        (noConfusionTy Ty`( ∀ ${W} <: ${T1} . ${T2} )` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e)))
                    dC)
                  (substEq Ty (\ z -> sub G0 z S1) T1 Q1
                    (andLeft (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                      (andRight (Eq String W Z) (And (Eq Ty T1 Q1) (Eq Ty T2 Q2))
                        (noConfusionTy Ty`( ∀ ${W} <: ${T1} . ${T2} )` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e)))
                    p1))
                (trQ2 (bindTy G0 W C) S2 Dd
                  (substEq Ty (\ z -> sub (bindTy G0 W C) S2 z) T2 Q2
                    (andRight (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                      (andRight (Eq String W Z) (And (Eq Ty T1 Q1) (Eq Ty T2 Q2))
                        (noConfusionTy Ty`( ∀ ${W} <: ${T1} . ${T2} )` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e)))
                    (naQ1 G0 W Ctx`·` S2 T2 C
                      (substEq Ty (\ z -> sub (bindTy G0 W z) S2 T2) T1 Q1
                        (andLeft (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                          (andRight (Eq String W Z) (And (Eq Ty T1 Q1) (Eq Ty T2 Q2))
                            (noConfusionTy Ty`( ∀ ${W} <: ${T1} . ${T2} )` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e)))
                        p2)
                      (substEq Ty (\ z -> sub G0 C z) T1 Q1
                        (andLeft (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                          (andRight (Eq String W Z) (And (Eq Ty T1 Q1) (Eq Ty T2 Q2))
                            (noConfusionTy Ty`( ∀ ${W} <: ${T1} . ${T2} )` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e)))
                        dC)))
                  (substEq Ty (\ z -> sub (bindTy G0 W C) z Dd) T2 Q2
                    (andRight (Eq Ty T1 Q1) (Eq Ty T2 Q2)
                      (andRight (Eq String W Z) (And (Eq Ty T1 Q1) (Eq Ty T2 Q2))
                        (noConfusionTy Ty`( ∀ ${W} <: ${T1} . ${T2} )` Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )` e)))
                    dD))))
          (T0) (allSuper G0 W T1 T2 T0 dd)))
    (G S Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )`) d1 (refl Ty Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )`) T d2


-- ---------------------------------------------------------------------------
-- PROBLEM 1A, assembled. The outer induction on the middle type, with all
-- four cases above, under the one hypothesis the development could not build.

Wk : Ty -> Type₀
Wk = \ Q -> forall (G : Ctx) (Xn : String) (D : Ctx) (P : Ty) (dp : sub G P Q)
              -> sub (append (bindTy G Xn P) D) P Q

transNarrow : forall (wk : forall (Q : Ty) -> Wk Q) (Q : Ty) -> And (TransAt Q) (NarrowAt Q)
transNarrow = \ wk Q ->
  elim Ty () (\ Q0 -> And (TransAt Q0) (NarrowAt Q0))
    ((\ W -> both (TransAt Ty`${W}`) (NarrowAt Ty`${W}`)
               (transTVar W)
               (narrowFrom Ty`${W}` (transTVar W) (wk Ty`${W}`)))
     (both (TransAt Ty`⊤`) (NarrowAt Ty`⊤`)
        transTop (narrowFrom Ty`⊤` transTop (wk Ty`⊤`)))
     (\ A B ihA ihB ->
        both (TransAt Ty`( ${A} -> ${B} )`) (NarrowAt Ty`( ${A} -> ${B} )`)
          (transArrow A B (andLeft (TransAt A) (NarrowAt A) ihA)
                          (andLeft (TransAt B) (NarrowAt B) ihB))
          (narrowFrom Ty`( ${A} -> ${B} )`
            (transArrow A B (andLeft (TransAt A) (NarrowAt A) ihA)
                            (andLeft (TransAt B) (NarrowAt B) ihB))
            (wk Ty`( ${A} -> ${B} )`)))
     (\ W A B ihA ihB ->
        both (TransAt Ty`( ∀ ${W} <: ${A} . ${B} )`) (NarrowAt Ty`( ∀ ${W} <: ${A} . ${B} )`)
          (transAll W A B (andLeft (TransAt A) (NarrowAt A) ihA)
                          (andRight (TransAt A) (NarrowAt A) ihA)
                          (andLeft (TransAt B) (NarrowAt B) ihB))
          (narrowFrom Ty`( ∀ ${W} <: ${A} . ${B} )`
            (transAll W A B (andLeft (TransAt A) (NarrowAt A) ihA)
                            (andRight (TransAt A) (NarrowAt A) ihA)
                            (andLeft (TransAt B) (NarrowAt B) ihB))
            (wk Ty`( ∀ ${W} <: ${A} . ${B} )`))))
    () Q

-- Transitivity of subtyping, POPLMark problem 1A.
transitivity : forall (wk : forall (Q : Ty) -> Wk Q) (G : Ctx) (S : Ty) (Q : Ty) (T : Ty)
                 (d1 : sub G S Q) (d2 : sub G Q T) -> sub G S T
transitivity = \ wk G S Q T d1 d2 ->
  andLeft (TransAt Q) (NarrowAt Q) (transNarrow wk Q) G S T d1 d2

-- And narrowing, which came with it.
narrowing : forall (wk : forall (Q : Ty) -> Wk Q) (G : Ctx) (Xn : String) (Q : Ty) (D : Ctx)
              (M : Ty) (N : Ty) (P : Ty)
              (d : sub (append (bindTy G Xn Q) D) M N) (dp : sub G P Q)
              -> sub (append (bindTy G Xn P) D) M N
narrowing = \ wk G Xn Q D M N P d dp ->
  andRight (TransAt Q) (NarrowAt Q) (transNarrow wk Q) G Xn D M N P d dp


-- ---------------------------------------------------------------------------
-- AND THAT HYPOTHESIS IS FALSE. Not merely unproved — refutable, here.
--
-- The paper's step "a derivation in Γ still holds in Γ , X <: P , Δ" relies on
-- the Barendregt convention: bound names are assumed fresh for the context,
-- so no entry of Γ is shadowed. Thena's names are nominal and there is no such
-- convention, so a context may shadow, and then a lookup is lost.

-- Two literals differ, with no axiom: eqString computes and Eq carries it.
yNotB : Eq String "Y" "B" -> Empty
yNotB = \ q ->
  elim Eq (String)
    (\ a b r -> elim Comparison () (\ c -> Type₀) ((Unit) (Empty)) () (eqString "Y" a)
                -> elim Comparison () (\ c -> Type₀) ((Unit) (Empty)) () (eqString "Y" b))
    ((\ a d -> d))
    ("Y" "B") q unit

-- In this context Y is below B, by looking Y up and stopping at B.
yBelowB : sub Ctx`· , B <: ⊤ , Y <: B` Ty`Y` Ty`B`
yBelowB =
  SA-Trans-TVar "Y" Ty`B` Ctx`· , B <: ⊤ , Y <: B` Ty`B`
    (bindTy-here Ctx`· , B <: ⊤` "Y" Ty`B`)
    (SA-Refl-TVar Ctx`· , B <: ⊤ , Y <: B` "B")

-- Weaken that context by Y <: Y and the entry Y <: B is shadowed, so the only
-- bound Y has is Y itself.
shadowed : Ctx
shadowed = Ctx`· , B <: ⊤ , Y <: B , Y <: Y`

shadowedLookup : forall (U : Ty) (i : bindTy-in "Y" U shadowed) -> Eq Ty U Ty`Y`
shadowedLookup = \ U i ->
  elim Or ((And (Eq String "Y" "Y") (Eq Ty U Ty`Y`))
           (And (Eq String "Y" "Y" -> Empty) (bindTy-in "Y" U Ctx`· , B <: ⊤ , Y <: B`)))
    (\ o -> Eq Ty U Ty`Y`)
    ((\ h -> andRight (Eq String "Y" "Y") (Eq Ty U Ty`Y`) h)
     (\ h -> absurdly (Eq Ty U Ty`Y`)
               (andLeft (Eq String "Y" "Y" -> Empty)
                        (bindTy-in "Y" U Ctx`· , B <: ⊤ , Y <: B`) h (refl String "Y"))))
    () (bindTyInBindTy Ctx`· , B <: ⊤ , Y <: B` "Y" Ty`Y` "Y" U i)

-- So Y is NOT below B there, and the proof is an induction on derivations: the
-- only rule that could conclude it is SA-Trans-TVar, whose lookup can only
-- find Y <: Y, which leaves the same goal.
noYBelowB : forall (d : sub shadowed Ty`Y` Ty`B`) -> Empty
noYBelowB = \ d ->
  elim sub () (\ G0 S0 T0 d0 -> Eq Ctx G0 shadowed -> Eq Ty S0 Ty`Y` -> Eq Ty T0 Ty`B` -> Empty)
    ((\ G0 S0 eG eS eT -> noConfusionTy Ty`⊤` Ty`B` eT)
     (\ G0 W eG eS eT ->
        yNotB (transEq String "Y" W "B"
                (symEq String W "Y" (noConfusionTy Ty`${W}` Ty`Y` eS))
                (noConfusionTy Ty`${W}` Ty`B` eT)))
     (\ W U G0 T0 lk p1 ih1 eG eS eT ->
        ih1 eG
          (shadowedLookup U
            (substEq String (\ z -> bindTy-in z U shadowed) W "Y"
              (noConfusionTy Ty`${W}` Ty`Y` eS)
              (substEq Ctx (\ c -> bindTy-in W U c) G0 shadowed eG lk)))
          eT)
     (\ G0 T1 S1 S2 T2 p1 p2 ih1 ih2 eG eS eT ->
        noConfusionTy Ty`( ${S1} -> ${S2} )` Ty`Y` eS)
     (\ G0 T1 S1 W S2 T2 p1 p2 ih1 ih2 eG eS eT ->
        noConfusionTy Ty`( ∀ ${W} <: ${S1} . ${S2} )` Ty`Y` eS))
    (shadowed Ty`Y` Ty`B`) d (refl Ctx shadowed) (refl Ty Ty`Y`) (refl Ty Ty`B`)

-- The refutation. `Wk B` would take yBelowB into the shadowed context.
wkIsFalse : Wk Ty`B` -> Empty
wkIsFalse = \ wk ->
  noYBelowB (wk Ctx`· , B <: ⊤ , Y <: B` "Y" Ctx`·` Ty`Y` yBelowB)
