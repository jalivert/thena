-- POPLMark problem 1A: transitivity of subtyping, with narrowing.
--
-- LOAD AFTER 01-syntax, 02-contexts, 03-wellformed, 04-subtyping, 05-typing.
--
-- The challenge's crux. Transitivity is not a rule of the system, it is a
-- lemma, and its proof needs narrowing simultaneously: in the SA-All case the
-- two subderivations bind the same type variable at DIFFERENT bounds, so one
-- of them has to be narrowed before transitivity applies to the bodies. The
-- induction is on the structure of the middle type, with an inner induction
-- on derivations.
--
-- == It is written in splits, and 16 `elim`s became none
--
-- **The three inversion lemmas are gone and so are the two datatypes they
-- handed back**, because a split on the right-hand derivation IS the inversion:
-- see the note below where they used to stand. That is 185 lines of this file.
--
-- **`narrowFrom` had to say more than its statement did**, for the same reason
-- `03`'s `tyRebind` did: the SA-All case recurses at `Δ , W <: T1`, so the
-- induction varies the Δ inside the `append`, and a split generalises whole
-- premises and never a part of an index. `narrowFromAt` takes the context and
-- the equation as arguments — the hand-written motive, said in the statement —
-- and `narrowFrom` closes it with `refl`.

module FsubTransitivity where

-- ---------------------------------------------------------------------------
-- Reflexivity, by induction on the WELL-FORMEDNESS of the type rather than on
-- the type: the quantifier case has to build SA-All's premise, and ty-all is
-- exactly where the freshness it needs is recorded.

subRefl : forall (G : Ctx) (T : Ty) (h : ty G T) (o : ok G) -> sub G T T
subRefl = \ G T h o -> induction h of
  { ty-tvar X T1 C0 lk -> SA-Refl-TVar C0 X
  ; ty-top C0 -> SA-Top C0 Ty`⊤`
  ; ty-arrow C0 T1 T2 h1 h2 ->
      SA-Arrow C0 T1 T1 T2 T2 (subRefl C0 T1 h1 o) (subRefl C0 T2 h2 o)
  ; ty-all X C0 T1 T2 f h1 h2 ->
      SA-All C0 T1 T1 X T2 T2 (subRefl C0 T1 h1 o)
        (ok-bindTy C0 X T1 o f h1)
        (subRefl (bindTy C0 X T1) T2 h2 (ok-bindTy C0 X T1 o f h1)) }


-- ---------------------------------------------------------------------------
-- THE INVERSION LEMMAS ARE GONE, and a split is why.
--
-- Three used to stand here — one per shape of the lower type — each an
-- elimination of the derivation under a motive that takes an equation pinning
-- the index, and each handing back a datatype declared for the purpose
-- (`ArrowSuper`, `AllSuper`) because `sub` gets no no-confusion lemma. Every
-- one of them was the same move the split already makes: the rules that cannot
-- conclude at the shape in hand have no arm, and the ones that can arrive with
-- their premises already at the refined types. So the proofs below split the
-- right-hand derivation where they used to invert it, and the two datatypes and
-- their three lemmas are not needed at all. `07` reports the same thing, in its
-- own words, about nine of them.


-- ---------------------------------------------------------------------------
-- The two statements, and the one step that is left over.
--
-- Transitivity and narrowing go together: the induction is on the STRUCTURE OF
-- THE MIDDLE TYPE Q, and for one Q the two lean on each other — narrowing at Q
-- uses transitivity at the same Q, and transitivity at Q uses both at the
-- proper parts of Q. So the outer induction proves the pair.

TransAt : Ty -> Type₀
TransAt = \ Q -> forall (G : Ctx) (S : Ty) (T : Ty) (d1 : sub G S Q) (d2 : sub G Q T) -> sub G S T

NarrowAt : Ty -> Type₀
NarrowAt = \ Q -> forall (G : Ctx) (Xn : String) (D : Ctx) (M : Ty) (N : Ty) (P : Ty)
                    (o : ok (append (bindTy G Xn Q) D)) (tp : ty G P)
                    (d : sub (append (bindTy G Xn Q) D) M N) (dp : sub G P Q)
                    -> sub (append (bindTy G Xn P) D) M N

-- Plain weakening: a derivation in Γ still holds in Γ , X <: P , Δ, when that
-- is a well-formed context. THE SECTION AT THE END OF THIS FILE REFUTES IT.
Wk : Ty -> Type₀
Wk = \ Q -> forall (G : Ctx) (Xn : String) (D : Ctx) (P : Ty)
              (o : ok (append (bindTy G Xn P) D)) (dp : sub G P Q)
              -> sub (append (bindTy G Xn P) D) P Q


-- Q = ⊤. Nothing is above ⊤, so the right premise says T is ⊤.
transTop : TransAt Ty`⊤`
transTop = \ G S T d1 d2 -> case d2 of
  { SA-Top G0 S0 -> SA-Top G0 S }

-- Q = X. Either SA-Refl-TVar, and the right premise IS the conclusion, or
-- SA-Trans-TVar, and the inner hypothesis does it.
transTVar : forall (Z : String) -> TransAt Ty`${Z}`
transTVar = \ Z G S T d1 d2 -> induction d1 of
  { SA-Refl-TVar G0 W -> d2
  ; SA-Trans-TVar W U G0 T1 lk p1 ->
      SA-Trans-TVar W U G0 T lk (transTVar Z G0 U T p1 d2) }

-- Q = Q₁ -> Q₂. The first case that uses the outer hypothesis, at both parts.
transArrow : forall (Q1 : Ty) (Q2 : Ty) (ihQ1 : TransAt Q1) (ihQ2 : TransAt Q2)
               -> TransAt Ty`( ${Q1} -> ${Q2} )`
transArrow = \ Q1 Q2 ihQ1 ihQ2 G S T d1 d2 -> induction d1 of
  { SA-Trans-TVar W U G0 T1 lk p1 ->
      SA-Trans-TVar W U G0 T lk (transArrow Q1 Q2 ihQ1 ihQ2 G0 U T p1 d2)
  -- **The inner split IS the inversion**, so `arrowSuper` is not needed here:
  -- `d2`'s lower type is `Q1 -> Q2`, and the three rules that cannot conclude
  -- that have no arm.
  ; SA-Arrow G0 T1 S1 S2 T2 p1 p2 -> case d2 of
      { SA-Top G1 S3 -> SA-Top G0 Ty`( ${S1} -> ${S2} )`
      ; SA-Arrow G1 T3 S3 S4 T4 q1 q2 ->
          SA-Arrow G0 T3 S1 S2 T4 (ihQ1 G0 T3 S1 q1 p1) (ihQ2 G0 S2 T4 p2 q2) } }


-- ---------------------------------------------------------------------------
-- Narrowing, in full, from transitivity at the same Q and plain weakening.
--
-- The well-formedness premise is what makes the SA-All case go through: the
-- rule carries `⊢ Γ , X <: T1 ok`, and okRebind turns that into the same fact
-- about the narrowed context, which is what rebuilding the rule needs.

-- **The context is a premise and the equation is written down**, because the
-- induction has to vary Δ — the SA-All case recurses at `Δ , W <: T1` — and a
-- split can only generalise a whole premise, never the Δ inside the `append`
-- the paper's comma stands for. `narrowFrom` below closes the equation with
-- `refl` and is the lemma the rest of the file asks for.
narrowFromAt : forall (Q : Ty) (tr : TransAt Q) (wk : Wk Q)
                 (C : Ctx) (M : Ty) (N : Ty) (d : sub C M N)
                 (G : Ctx) (Xn : String) (D : Ctx) (P : Ty)
                 (e : Eq Ctx C (append (bindTy G Xn Q) D))
                 (o : ok (append (bindTy G Xn Q) D)) (tp : ty G P) (dp : sub G P Q)
                 -> sub (append (bindTy G Xn P) D) M N
narrowFromAt = \ Q tr wk C M N d G Xn D P e o tp dp -> induction d of
  { SA-Top C0 S0 -> SA-Top (append (bindTy G Xn P) D) S0
  ; SA-Refl-TVar C0 W -> SA-Refl-TVar (append (bindTy G Xn P) D) W
  ; SA-Trans-TVar W U C0 N0 lk p1 ->
      case (narrowLookup G Xn Q P D W U
              (substEq Ctx (\ c -> bindTy-in W U c) C0 (append (bindTy G Xn Q) D) e lk)) of
        { orLeft h -> SA-Trans-TVar W U (append (bindTy G Xn P) D) N0 h
                        (narrowFromAt Q tr wk C0 U N0 p1 G Xn D P e o tp dp)
        ; orRight h ->
            substEq String (\ z -> sub (append (bindTy G Xn P) D) Ty`${z}` N0) Xn W
              (symEq String W Xn
                (andLeft (Eq String W Xn) (Eq Ty U Q)
                  (andLeft (And (Eq String W Xn) (Eq Ty U Q))
                           (bindTy-in Xn P (append (bindTy G Xn P) D)) h)))
              (SA-Trans-TVar Xn P (append (bindTy G Xn P) D) N0
                (andRight (And (Eq String W Xn) (Eq Ty U Q))
                          (bindTy-in Xn P (append (bindTy G Xn P) D)) h)
                (tr (append (bindTy G Xn P) D) P N0
                  (wk G Xn D P (okRebind G Xn Q P D o tp) dp)
                  (substEq Ty (\ z -> sub (append (bindTy G Xn P) D) z N0) U Q
                    (andRight (Eq String W Xn) (Eq Ty U Q)
                      (andLeft (And (Eq String W Xn) (Eq Ty U Q))
                               (bindTy-in Xn P (append (bindTy G Xn P) D)) h))
                    (narrowFromAt Q tr wk C0 U N0 p1 G Xn D P e o tp dp)))) }
  ; SA-Arrow C0 T1 S1 S2 T2 p1 p2 ->
      SA-Arrow (append (bindTy G Xn P) D) T1 S1 S2 T2
        (narrowFromAt Q tr wk C0 T1 S1 p1 G Xn D P e o tp dp)
        (narrowFromAt Q tr wk C0 S2 T2 p2 G Xn D P e o tp dp)
  ; SA-All C0 T1 S1 W S2 T2 p1 okW p2 ->
      SA-All (append (bindTy G Xn P) D) T1 S1 W S2 T2
        (narrowFromAt Q tr wk C0 T1 S1 p1 G Xn D P e o tp dp)
        (okRebind G Xn Q P (bindTy D W T1)
          (substEq Ctx (\ c -> ok (bindTy c W T1)) C0 (append (bindTy G Xn Q) D) e okW)
          tp)
        (narrowFromAt Q tr wk (bindTy C0 W T1) S2 T2 p2 G Xn (bindTy D W T1) P
          (substEq Ctx (\ c -> Eq Ctx (bindTy C0 W T1) (bindTy c W T1))
            C0 (append (bindTy G Xn Q) D) e (refl Ctx (bindTy C0 W T1)))
          (substEq Ctx (\ c -> ok (bindTy c W T1)) C0 (append (bindTy G Xn Q) D) e okW)
          tp dp) }

narrowFrom : forall (Q : Ty) (tr : TransAt Q) (wk : Wk Q) -> NarrowAt Q
narrowFrom = \ Q tr wk G Xn D M N P o tp d dp ->
  narrowFromAt Q tr wk (append (bindTy G Xn Q) D) M N d G Xn D P
    (refl Ctx (append (bindTy G Xn Q) D)) o tp dp


-- The fourth case, and the one the challenge is really about. Q = ∀Z<:Q₁.Q₂.
--
-- Both derivations end in SA-All and their bodies are compared under DIFFERENT
-- bounds — the left under Q₁, the right under the C that inverting the right
-- premise hands back. So the left body is NARROWED from Q₁ to C first, and only
-- then does transitivity at Q₂ apply. That is the mutual step.
--
-- The bound name is shared rather than renamed, so no α-equivalence is needed
-- here. Both well-formedness facts the rebuilt SA-All needs come out of the two
-- derivations being inverted, which is the whole reason SA-All carries one.
transAll : forall (Z : String) (Q1 : Ty) (Q2 : Ty)
             (trQ1 : TransAt Q1) (naQ1 : NarrowAt Q1) (trQ2 : TransAt Q2)
             -> TransAt Ty`( ∀ ${Z} <: ${Q1} . ${Q2} )`
transAll = \ Z Q1 Q2 trQ1 naQ1 trQ2 G S T d1 d2 -> induction d1 of
  { SA-Trans-TVar W U G0 T1 lk p1 ->
      SA-Trans-TVar W U G0 T lk (transAll Z Q1 Q2 trQ1 naQ1 trQ2 G0 U T p1 d2)
  ; SA-All G0 T1 S1 W S2 T2 p1 okW p2 -> case d2 of
      { SA-Top G1 S3 -> SA-Top G0 Ty`( ∀ ${W} <: ${S1} . ${S2} )`
      ; SA-All G1 T3 S3 W1 S4 T4 q1 oq q2 ->
          SA-All G0 T3 S1 W S2 T4
            (trQ1 G0 T3 S1 q1 p1)
            oq
            (trQ2 (bindTy G0 W T3) S2 T4
              (naQ1 G0 W Ctx`·` S2 T2 T3 okW
                (andRight (notIn W G0) (ty G0 T3)
                  (andRight (ok G0) (And (notIn W G0) (ty G0 T3))
                    (okBindTy G0 W T3 oq)))
                p2 q1)
              q2) } }


-- ---------------------------------------------------------------------------
-- PROBLEM 1A, assembled: the outer induction on the middle type, with all four
-- cases above, under the one hypothesis the development could not build.

transNarrow : forall (wk : forall (Q : Ty) -> Wk Q) (Q : Ty) -> And (TransAt Q) (NarrowAt Q)
transNarrow = \ wk Q -> induction Q of
  { tvar W -> both (TransAt Ty`${W}`) (NarrowAt Ty`${W}`)
                (transTVar W)
                (narrowFrom Ty`${W}` (transTVar W) (wk Ty`${W}`))
  ; top -> both (TransAt Ty`⊤`) (NarrowAt Ty`⊤`)
             transTop (narrowFrom Ty`⊤` transTop (wk Ty`⊤`))
  ; arrow A B ->
      both (TransAt Ty`( ${A} -> ${B} )`) (NarrowAt Ty`( ${A} -> ${B} )`)
        (transArrow A B (andLeft (TransAt A) (NarrowAt A) (transNarrow wk A))
                        (andLeft (TransAt B) (NarrowAt B) (transNarrow wk B)))
        (narrowFrom Ty`( ${A} -> ${B} )`
          (transArrow A B (andLeft (TransAt A) (NarrowAt A) (transNarrow wk A))
                          (andLeft (TransAt B) (NarrowAt B) (transNarrow wk B)))
          (wk Ty`( ${A} -> ${B} )`))
  ; all W A B ->
      both (TransAt Ty`( ∀ ${W} <: ${A} . ${B} )`) (NarrowAt Ty`( ∀ ${W} <: ${A} . ${B} )`)
        (transAll W A B (andLeft (TransAt A) (NarrowAt A) (transNarrow wk A))
                        (andRight (TransAt A) (NarrowAt A) (transNarrow wk A))
                        (andLeft (TransAt B) (NarrowAt B) (transNarrow wk B)))
        (narrowFrom Ty`( ∀ ${W} <: ${A} . ${B} )`
          (transAll W A B (andLeft (TransAt A) (NarrowAt A) (transNarrow wk A))
                          (andRight (TransAt A) (NarrowAt A) (transNarrow wk A))
                          (andLeft (TransAt B) (NarrowAt B) (transNarrow wk B)))
          (wk Ty`( ∀ ${W} <: ${A} . ${B} )`)) }

-- Transitivity of subtyping, POPLMark problem 1A.
transitivity : forall (wk : forall (Q : Ty) -> Wk Q) (G : Ctx) (S : Ty) (Q : Ty) (T : Ty)
                 (d1 : sub G S Q) (d2 : sub G Q T) -> sub G S T
transitivity = \ wk G S Q T d1 d2 ->
  andLeft (TransAt Q) (NarrowAt Q) (transNarrow wk Q) G S T d1 d2

-- And narrowing, which came with it.
narrowing : forall (wk : forall (Q : Ty) -> Wk Q) (G : Ctx) (Xn : String) (Q : Ty) (D : Ctx)
              (M : Ty) (N : Ty) (P : Ty)
              (o : ok (append (bindTy G Xn Q) D)) (tp : ty G P)
              (d : sub (append (bindTy G Xn Q) D) M N) (dp : sub G P Q)
              -> sub (append (bindTy G Xn P) D) M N
narrowing = \ wk G Xn Q D M N P o tp d dp ->
  andRight (TransAt Q) (NarrowAt Q) (transNarrow wk Q) G Xn D M N P o tp d dp


-- ---------------------------------------------------------------------------
-- AND THE HYPOTHESIS IS STILL FALSE — for a DIFFERENT reason than before.
--
-- Well-formed contexts killed the first counterexample: a derivation could be
-- lost by weakening into a context that declares a name twice, and `⊢ Γ ok`
-- forbids that. What is left is not about the context at all. It is about the
-- DERIVATION: its own quantifiers bind names, and weakening may declare one of
-- them. Then SA-All's premise cannot be met, because the context it extends to
-- would declare that name twice.
--
-- This is the step α-equivalence exists to take: rename the bound variable and
-- the obstruction is gone. Thena is nominal by design, so there is nothing to
-- rename with — a bound name is a `String` field, and changing it changes the
-- type.

zNotB : Eq String "Z" "B" -> Empty
zNotB = \ q -> substEq String (\ z -> isSame (eqString "Z" z)) "Z" "B" q unit

okB : ok`⊢ · , B <: ⊤ ok`
okB = ok-bindTy Ctx`·` "B" Ty`⊤` ok-empty (NI-empty "B") (ty-top Ctx`·`)

zFreshInB : notIn`Z # · , B <: ⊤`
zFreshInB = NI-bindTy "Z" Ctx`·` "B" Ty`⊤` zNotB (NI-empty "Z")

-- The derivation binds Z, and its SA-All premise says Z is fresh for · , B <: ⊤.
bindsZ : sub`· , B <: ⊤ ⊢ ( ∀ Z <: ⊤ . Z ) <: ( ∀ Z <: ⊤ . ⊤ )`
bindsZ =
  SA-All Ctx`· , B <: ⊤` Ty`⊤` Ty`⊤` "Z" Ty`Z` Ty`⊤`
    (SA-Top Ctx`· , B <: ⊤` Ty`⊤`)
    (ok-bindTy Ctx`· , B <: ⊤` "Z" Ty`⊤` okB zFreshInB (ty-top Ctx`· , B <: ⊤`))
    (SA-Top Ctx`· , B <: ⊤ , Z <: ⊤` Ty`Z`)

-- Weakening by Z <: ( ∀ Z <: ⊤ . Z ) is a WELL-FORMED extension: Z is not
-- declared in · , B <: ⊤, and the bound is a well-formed type there.
okTarget : ok`⊢ · , B <: ⊤ , Z <: ( ∀ Z <: ⊤ . Z ) ok`
okTarget =
  ok-bindTy Ctx`· , B <: ⊤` "Z" Ty`( ∀ Z <: ⊤ . Z )` okB zFreshInB
    (ty-all "Z" Ctx`· , B <: ⊤` Ty`⊤` Ty`Z` zFreshInB (ty-top Ctx`· , B <: ⊤`)
      (ty-tvar "Z" Ty`⊤` Ctx`· , B <: ⊤ , Z <: ⊤`
        (bindTy-here Ctx`· , B <: ⊤` "Z" Ty`⊤`)))

-- And yet the derivation does not survive into it.
noBindsZ : forall (d : sub Ctx`· , B <: ⊤ , Z <: ( ∀ Z <: ⊤ . Z )`
                          Ty`( ∀ Z <: ⊤ . Z )` Ty`( ∀ Z <: ⊤ . ⊤ )`) -> Empty
noBindsZ = \ d -> case d of
  { SA-All G0 T1 S1 W S2 T2 p1 okW p2 ->
      andLeft (Eq String "Z" "Z" -> Empty) (notIn "Z" Ctx`· , B <: ⊤`)
        (notInBindTy "Z" Ctx`· , B <: ⊤` "Z" Ty`( ∀ Z <: ⊤ . Z )`
          (andLeft (notIn "Z" Ctx`· , B <: ⊤ , Z <: ( ∀ Z <: ⊤ . Z )`)
                   (ty Ctx`· , B <: ⊤ , Z <: ( ∀ Z <: ⊤ . Z )` Ty`⊤`)
            (andRight (ok Ctx`· , B <: ⊤ , Z <: ( ∀ Z <: ⊤ . Z )`)
              (And (notIn "Z" Ctx`· , B <: ⊤ , Z <: ( ∀ Z <: ⊤ . Z )`)
                   (ty Ctx`· , B <: ⊤ , Z <: ( ∀ Z <: ⊤ . Z )` Ty`⊤`))
              (okBindTy Ctx`· , B <: ⊤ , Z <: ( ∀ Z <: ⊤ . Z )` "Z" Ty`⊤` okW))))
        (refl String "Z") }

-- So plain weakening is refutable even between well-formed contexts.
wkIsFalse : Wk Ty`( ∀ Z <: ⊤ . ⊤ )` -> Empty
wkIsFalse = \ wk ->
  noBindsZ (wk Ctx`· , B <: ⊤` "Z" Ctx`·` Ty`( ∀ Z <: ⊤ . Z )` okTarget bindsZ)
