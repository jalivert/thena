-- Well-formed contexts and well-formed types.
--
-- LOAD AFTER 01-syntax.thena AND 02-subtyping.thena.
--
-- THE CHALLENGE PAPER DOES NOT PRINT THESE, and it does not have to: its
-- contexts are finite functions, so `Γ, X<:T` is notation that only means
-- something when X is new, and a context cannot repeat a name. Thena's context
-- is a datatype and its comma is a constructor, so `· , Y <: ⊤ , Y <: ⊤` is a
-- perfectly good value — and a lookup takes the newest entry, so the second Y
-- hides the first. That is a decision this project made deliberately.
--
-- The consequence is in 05: the paper's proof of transitivity takes one step
-- that is FALSE for a context that repeats a name. So the law the paper gets
-- from its notation is written down here instead, as two judgments, and
-- carried as a hypothesis — which is what careful papers do anyway.

module FsubWellformed where

-- ---------------------------------------------------------------------------
-- The usual four, as 07 defines them: equality is an ordinary datatype here.

absurdly : forall (C : Type₀) (e : Empty) -> C
absurdly = \ C e -> case e of { }

substEq : forall (A : Type₀) (P : A -> Type₀) (a : A) (b : A) (e : Eq A a b) (p : P a) -> P b
substEq = \ A P a b e p -> case e of { refl c -> p }

symEq : forall (A : Type₀) (a : A) (b : A) (e : Eq A a b) -> Eq A b a
symEq = \ A a b e -> substEq A (\ z -> Eq A z a) a b e (refl A a)

transEq : forall (A : Type₀) (a : A) (b : A) (c : A) (e1 : Eq A a b) (e2 : Eq A b c) -> Eq A a c
transEq = \ A a b c e1 e2 -> substEq A (\ z -> Eq A a z) b c e2 e1

-- A disjunction, as 07 declares it: And is in the prelude and Or is not.
data Or (A : Type₀) (B : Type₀) : Type₀ where
  orLeft  : forall (a : A) -> Or A B
  orRight : forall (b : B) -> Or A B



-- A type variable is not declared in Γ. Written by hand rather than as a
-- `judgment` block, because its last rule needs a side condition — two names
-- differ — and a premise above a bar is a type, not an implication. Phase 160
-- then gives the hand-written family its own notation, so it reads on paper
-- exactly as the side condition it is.
--
-- `#` is about TYPE variables only. Subtyping never looks a term variable up,
-- so distinctness of term names buys nothing here and is not required.
data notIn : String -> Ctx -> Type₀ where
  NI-empty  : forall (X : String) -> notIn X Ctx`·`
  NI-bindTm : forall (X : String) (G : Ctx) (y : String) (T : Ty) (p : notIn X G)
                -> notIn X (bindTm G y T)
  NI-bindTy : forall (X : String) (G : Ctx) (Y : String) (T : Ty)
                (ne : Eq String X Y -> Empty) (p : notIn X G)
                -> notIn X (bindTy G Y T)

notation notIn (v : X) G -> v # G where

-- A well-formed type: every variable in it is declared, and a quantifier binds
-- a variable that is NOT already declared. That second clause is the whole
-- point — it is where the paper's freshness convention lives, and it is what
-- lets the proof in 05 know that a quantifier's bound variable does not shadow
-- anything in the context.
judgment ty = Γ ⊢ T ty where

  ty-tvar:   X <: T ∈ Γ
             ---------------
             Γ ⊢ X ty

  ty-top:    -----------------
             Γ ⊢ ⊤ ty

  ty-arrow:  Γ ⊢ T1 ty      Γ ⊢ T2 ty
             ---------------------------------
             Γ ⊢ ( T1 -> T2 ) ty

  ty-all:    X # Γ      Γ ⊢ T1 ty      Γ , X <: T1 ⊢ T2 ty
             -------------------------------------------------------
             Γ ⊢ ( ∀ X <: T1 . T2 ) ty

-- A well-formed context: each entry's type is well-formed in what comes before
-- it, and a type binding declares a name not already declared. No forward
-- reference falls out of the first clause with no negation anywhere, because a
-- lookup premise already means "declared strictly before".
judgment ok = ⊢ Γ ok where

  ok-empty:  ---------------
             ⊢ · ok

  ok-bindTm: ⊢ Γ ok      Γ ⊢ T ty
             -------------------------
             ⊢ Γ , x : T ok

  ok-bindTy: ⊢ Γ ok      X # Γ      Γ ⊢ T ty
             -------------------------------------
             ⊢ Γ , X <: T ok


-- ---------------------------------------------------------------------------
-- Two literals differ, with no axiom: eqString computes on them and Eq carries
-- the fact from one name to the other. One per pair, because the proof needs
-- eqString to REDUCE — a version quantified over two names would be claiming
-- that any two names differ.

yNotX : Eq String "Y" "X" -> Empty
yNotX = \ q -> substEq String (\ z -> isSame (eqString "Y" z)) "Y" "X" q unit

xNotY : Eq String "X" "Y" -> Empty
xNotY = \ q -> substEq String (\ z -> isSame (eqString "X" z)) "X" "Y" q unit

-- ---------------------------------------------------------------------------
-- Derivations.

-- The empty context, then a type binding, then a term binding whose type uses
-- the variable declared before it.
emptyOk : ok`⊢ · ok`
emptyOk = ok-empty

oneTypeVar : ok`⊢ · , X <: ⊤ ok`
oneTypeVar = ok-bindTy Ctx`·` "X" Ty`⊤` ok-empty (NI-empty "X") (ty-top Ctx`·`)

xIsAType : ty`· , X <: ⊤ ⊢ X ty`
xIsAType = ty-tvar "X" Ty`⊤` Ctx`· , X <: ⊤` (bindTy-here Ctx`·` "X" Ty`⊤`)

goodCtx : ok`⊢ · , X <: ⊤ , y : X ok`
goodCtx = ok-bindTm Ctx`· , X <: ⊤` Ty`X` "y" oneTypeVar xIsAType

-- A quantifier binding a variable the context does not declare.
goodAll : ty`· , X <: ⊤ ⊢ ( ∀ Y <: X . ( Y -> X ) ) ty`
goodAll =
  ty-all "Y" Ctx`· , X <: ⊤` Ty`X` Ty`( Y -> X )`
    (NI-bindTy "Y" Ctx`·` "X" Ty`⊤` yNotX (NI-empty "Y"))
    xIsAType
    (ty-arrow Ctx`· , X <: ⊤ , Y <: X` Ty`Y` Ty`X`
      (ty-tvar "Y" Ty`X` Ctx`· , X <: ⊤ , Y <: X`
        (bindTy-here Ctx`· , X <: ⊤` "Y" Ty`X`))
      (ty-tvar "X" Ty`⊤` Ctx`· , X <: ⊤ , Y <: X`
        (bindTy-there-bindTy Ctx`· , X <: ⊤` "X" Ty`⊤` "Y" Ty`X` xNotY
          (bindTy-here Ctx`·` "X" Ty`⊤`))))


-- ---------------------------------------------------------------------------
-- Inversion of the type lookup, one shape of context at a time.

-- Nothing is declared in the empty context.
bindTyInEmpty : forall (Y : String) (U : Ty) (i : bindTy-in Y U Ctx`·`) -> Empty
bindTyInEmpty = \ Y U i -> case i of { }

-- A type lookup past a TERM binding is a lookup in what is underneath: the
-- generated relation has no inequality to discharge here, because shadowing
-- is within a namespace.
bindTyInBindTm : forall (G : Ctx) (w : String) (S : Ty) (Y : String) (U : Ty)
                   (i : bindTy-in Y U (bindTm G w S)) -> bindTy-in Y U G
bindTyInBindTm = \ G w S Y U i -> case i of
  { bindTy-there-bindTm G0 W S0 w' S' p -> p }

-- A type lookup past a TYPE binding is either that binding, or a lookup
-- underneath it at a different name.
FoundTy : Ctx -> String -> Ty -> String -> Ty -> Type₀
FoundTy = \ G W S Y U ->
  Or (And (Eq String Y W) (Eq Ty U S))
     (And (Eq String Y W -> Empty) (bindTy-in Y U G))

bindTyInBindTy : forall (G : Ctx) (W : String) (S : Ty) (Y : String) (U : Ty)
                   (i : bindTy-in Y U (bindTy G W S)) -> FoundTy G W S Y U
bindTyInBindTy = \ G W S Y U i -> case i of
  { bindTy-here G0 W0 S0 ->
      orLeft (And (Eq String W0 W) (Eq Ty S0 S)) (And (Eq String W0 W -> Empty) (bindTy-in W0 S0 G))
        (both (Eq String W0 W) (Eq Ty S0 S) (refl String W0) (refl Ty S0))
  ; bindTy-there-bindTy G0 W0 S0 W' S' ne p ->
      orRight (And (Eq String W0 W) (Eq Ty S0 S)) (And (Eq String W0 W -> Empty) (bindTy-in W0 S0 G))
        (both (Eq String W0 W -> Empty) (bindTy-in W0 S0 G) ne p) }


-- ---------------------------------------------------------------------------
-- Inversion of `#`, and the one fact that makes it useful: a name that is not
-- declared cannot be looked up.

notInBindTm : forall (Z : String) (G : Ctx) (y : String) (T : Ty)
                (f : notIn Z (bindTm G y T)) -> notIn Z G
notInBindTm = \ Z G y T f -> case f of
  { NI-bindTm Z1 G1 y1 T1 p -> p }

NotInSplit : String -> Ctx -> String -> Type₀
NotInSplit = \ Z G Y -> And (Eq String Z Y -> Empty) (notIn Z G)

notInBindTy : forall (Z : String) (G : Ctx) (Y : String) (T : Ty)
                (f : notIn Z (bindTy G Y T)) -> NotInSplit Z G Y
notInBindTy = \ Z G Y T f -> case f of
  { NI-bindTy Z1 G1 Y1 T1 ne p -> both (Eq String Z1 Y -> Empty) (notIn Z1 G) ne p }

-- A name that is not declared is not found. This is what turns distinctness
-- into the weakening the proof in 06 needs.
freshNotFound : forall (Z : String) (G : Ctx) (f : notIn Z G) (U : Ty)
                  (i : bindTy-in Z U G) -> Empty
freshNotFound = \ Z G f -> induction f of
  { NI-empty Z1 -> \ U i -> bindTyInEmpty Z1 U i
  ; NI-bindTm Z1 G1 y1 T1 p -> \ U i ->
      freshNotFound Z1 G1 p U (bindTyInBindTm G1 y1 T1 Z1 U i)
  ; NI-bindTy Z1 G1 Y1 T1 ne p -> \ U i ->
      case (bindTyInBindTy G1 Y1 T1 Z1 U i) of
        { orLeft h -> ne (andLeft (Eq String Z1 Y1) (Eq Ty U T1) h)
        ; orRight h -> freshNotFound Z1 G1 p U
                         (andRight (Eq String Z1 Y1 -> Empty) (bindTy-in Z1 U G1) h) } }


-- ---------------------------------------------------------------------------
-- The lookup lemma of narrowing: what a type lookup in Γ , X <: Q , Δ becomes
-- when the bound Q is replaced by P. An induction on Δ, pushing through the
-- append the paper's comma stands for.
--
-- Either the lookup survives the swap untouched, or it IS the swapped entry —
-- and in that case it also hands back the lookup of the NEW bound, which is
-- what the narrowing proof needs to go on with. Carrying that witness in the
-- second disjunct is what makes the X-is-the-narrowed-variable case work: the
-- original lookup stepped over all of Δ, so X is not shadowed in Δ either.

NFound1 : Ctx -> String -> Ty -> Ctx -> String -> Ty -> Type₀
NFound1 = \ G Xn P D Y U -> bindTy-in Y U (append (bindTy G Xn P) D)

NFound2 : Ctx -> String -> Ty -> Ty -> Ctx -> String -> Ty -> Type₀
NFound2 = \ G Xn Q P D Y U ->
  And (And (Eq String Y Xn) (Eq Ty U Q)) (bindTy-in Xn P (append (bindTy G Xn P) D))

NarrowFound : Ctx -> String -> Ty -> Ty -> Ctx -> String -> Ty -> Type₀
NarrowFound = \ G Xn Q P D Y U -> Or (NFound1 G Xn P D Y U) (NFound2 G Xn Q P D Y U)

narrowLookup : forall (G : Ctx) (Xn : String) (Q : Ty) (P : Ty) (D : Ctx)
                 (Y : String) (U : Ty) (i : bindTy-in Y U (append (bindTy G Xn Q) D))
                 -> NarrowFound G Xn Q P D Y U
narrowLookup = \ G Xn Q P D -> induction D of
  -- Δ is empty: the lookup is in Γ , X <: Q itself.
  { empty -> \ Y U i -> case (bindTyInBindTy G Xn Q Y U i) of
      { orLeft h -> orRight (NFound1 G Xn P Ctx`·` Y U) (NFound2 G Xn Q P Ctx`·` Y U)
                      (both (And (Eq String Y Xn) (Eq Ty U Q))
                            (bindTy-in Xn P (append (bindTy G Xn P) Ctx`·`))
                        h (bindTy-here G Xn P))
      ; orRight h -> orLeft (NFound1 G Xn P Ctx`·` Y U) (NFound2 G Xn Q P Ctx`·` Y U)
                       (bindTy-there-bindTy G Y U Xn P
                         (andLeft (Eq String Y Xn -> Empty) (bindTy-in Y U G) h)
                         (andRight (Eq String Y Xn -> Empty) (bindTy-in Y U G) h)) }
  -- Δ ends in a term binding: step over it on both sides.
  ; bindTm D0 w S -> \ Y U i ->
      case (narrowLookup G Xn Q P D0 Y U
              (bindTyInBindTm (append (bindTy G Xn Q) D0) w S Y U i)) of
        { orLeft h -> orLeft (NFound1 G Xn P (bindTm D0 w S) Y U)
                             (NFound2 G Xn Q P (bindTm D0 w S) Y U)
                        (bindTy-there-bindTm (append (bindTy G Xn P) D0) Y U w S h)
        ; orRight h -> orRight (NFound1 G Xn P (bindTm D0 w S) Y U)
                               (NFound2 G Xn Q P (bindTm D0 w S) Y U)
                          (both (And (Eq String Y Xn) (Eq Ty U Q))
                                (bindTy-in Xn P (append (bindTy G Xn P) (bindTm D0 w S)))
                            (andLeft (And (Eq String Y Xn) (Eq Ty U Q))
                                     (bindTy-in Xn P (append (bindTy G Xn P) D0)) h)
                            (bindTy-there-bindTm (append (bindTy G Xn P) D0) Xn P w S
                              (andRight (And (Eq String Y Xn) (Eq Ty U Q))
                                        (bindTy-in Xn P (append (bindTy G Xn P) D0)) h))) }
  -- Δ ends in a type binding: it may be the entry found, and then it is in
  -- Δ and the swap of Q for P does not touch it.
  ; bindTy D0 W S -> \ Y U i ->
      case (bindTyInBindTy (append (bindTy G Xn Q) D0) W S Y U i) of
        { orLeft h -> orLeft (NFound1 G Xn P (bindTy D0 W S) Y U)
                             (NFound2 G Xn Q P (bindTy D0 W S) Y U)
                        (substEq String (\ z -> bindTy-in z U (bindTy (append (bindTy G Xn P) D0) W S)) W Y
                          (symEq String Y W (andLeft (Eq String Y W) (Eq Ty U S) h))
                          (substEq Ty (\ V -> bindTy-in W V (bindTy (append (bindTy G Xn P) D0) W S)) S U
                            (symEq Ty U S (andRight (Eq String Y W) (Eq Ty U S) h))
                            (bindTy-here (append (bindTy G Xn P) D0) W S)))
        ; orRight h ->
            case (narrowLookup G Xn Q P D0 Y U
                    (andRight (Eq String Y W -> Empty)
                              (bindTy-in Y U (append (bindTy G Xn Q) D0)) h)) of
              { orLeft g -> orLeft (NFound1 G Xn P (bindTy D0 W S) Y U)
                                   (NFound2 G Xn Q P (bindTy D0 W S) Y U)
                              (bindTy-there-bindTy (append (bindTy G Xn P) D0) Y U W S
                                (andLeft (Eq String Y W -> Empty)
                                         (bindTy-in Y U (append (bindTy G Xn Q) D0)) h)
                                g)
              ; orRight g -> orRight (NFound1 G Xn P (bindTy D0 W S) Y U)
                                     (NFound2 G Xn Q P (bindTy D0 W S) Y U)
                                (both (And (Eq String Y Xn) (Eq Ty U Q))
                                      (bindTy-in Xn P (append (bindTy G Xn P) (bindTy D0 W S)))
                                  (andLeft (And (Eq String Y Xn) (Eq Ty U Q))
                                           (bindTy-in Xn P (append (bindTy G Xn P) D0)) g)
                                  (bindTy-there-bindTy (append (bindTy G Xn P) D0) Xn P W S
                                    (\ q -> andLeft (Eq String Y W -> Empty)
                                                    (bindTy-in Y U (append (bindTy G Xn Q) D0)) h
                                              (transEq String Y Xn W
                                                (andLeft (Eq String Y Xn) (Eq Ty U Q)
                                                  (andLeft (And (Eq String Y Xn) (Eq Ty U Q))
                                                           (bindTy-in Xn P (append (bindTy G Xn P) D0)) g))
                                                q))
                                    (andRight (And (Eq String Y Xn) (Eq Ty U Q))
                                              (bindTy-in Xn P (append (bindTy G Xn P) D0)) g))) } } }


-- ---------------------------------------------------------------------------
-- REBINDING: a context with one bound replaced. Nothing that only cares which
-- names are declared can tell the difference, and `#`, well-formedness of a
-- type and well-formedness of a context are all of that kind. These three
-- lemmas are what let the proof in 06 move a fact between Γ , X <: Q , Δ and
-- Γ , X <: P , Δ.

notInRebind : forall (G : Ctx) (Xn : String) (A : Ty) (B : Ty) (D : Ctx) (Z : String)
                (f : notIn Z (append (bindTy G Xn A) D))
                -> notIn Z (append (bindTy G Xn B) D)
notInRebind = \ G Xn A B D Z f -> induction D of
  { empty ->
      NI-bindTy Z G Xn B
        (andLeft (Eq String Z Xn -> Empty) (notIn Z G) (notInBindTy Z G Xn A f))
        (andRight (Eq String Z Xn -> Empty) (notIn Z G) (notInBindTy Z G Xn A f))
  ; bindTm D0 w S ->
      NI-bindTm Z (append (bindTy G Xn B) D0) w S
        (notInRebind G Xn A B D0 Z (notInBindTm Z (append (bindTy G Xn A) D0) w S f))
  ; bindTy D0 W S ->
      NI-bindTy Z (append (bindTy G Xn B) D0) W S
        (andLeft (Eq String Z W -> Empty) (notIn Z (append (bindTy G Xn A) D0))
          (notInBindTy Z (append (bindTy G Xn A) D0) W S f))
        (notInRebind G Xn A B D0 Z
          (andRight (Eq String Z W -> Empty) (notIn Z (append (bindTy G Xn A) D0))
            (notInBindTy Z (append (bindTy G Xn A) D0) W S f))) }

tyRebindAt : forall (G : Ctx) (Xn : String) (A : Ty) (B : Ty) (C : Ctx) (T : Ty)
               (h : ty C T) (D : Ctx) (e : Eq Ctx C (append (bindTy G Xn A) D))
               -> ty (append (bindTy G Xn B) D) T
tyRebindAt = \ G Xn A B C T h D e -> induction h of
  { ty-tvar X T1 C0 lk ->
      case (narrowLookup G Xn A B D X T1
              (substEq Ctx (\ c -> bindTy-in X T1 c) C0 (append (bindTy G Xn A) D) e lk)) of
        { orLeft g -> ty-tvar X T1 (append (bindTy G Xn B) D) g
        ; orRight g -> substEq String (\ z -> ty (append (bindTy G Xn B) D) Ty`${z}`) Xn X
                         (symEq String X Xn
                           (andLeft (Eq String X Xn) (Eq Ty T1 A)
                             (andLeft (And (Eq String X Xn) (Eq Ty T1 A))
                               (bindTy-in Xn B (append (bindTy G Xn B) D)) g)))
                         (ty-tvar Xn B (append (bindTy G Xn B) D)
                           (andRight (And (Eq String X Xn) (Eq Ty T1 A))
                             (bindTy-in Xn B (append (bindTy G Xn B) D)) g)) }
  ; ty-top C0 -> ty-top (append (bindTy G Xn B) D)
  ; ty-arrow C0 T1 T2 h1 h2 ->
      ty-arrow (append (bindTy G Xn B) D) T1 T2
        (tyRebindAt G Xn A B C0 T1 h1 D e) (tyRebindAt G Xn A B C0 T2 h2 D e)
  ; ty-all X C0 T1 T2 f h1 h2 ->
      ty-all X (append (bindTy G Xn B) D) T1 T2
        (notInRebind G Xn A B D X (substEq Ctx (\ c -> notIn X c) C0 (append (bindTy G Xn A) D) e f))
        (tyRebindAt G Xn A B C0 T1 h1 D e)
        (tyRebindAt G Xn A B (bindTy C0 X T1) T2 h2 (bindTy D X T1)
          (substEq Ctx (\ c -> Eq Ctx (bindTy C0 X T1) (bindTy c X T1))
            C0 (append (bindTy G Xn A) D) e (refl Ctx (bindTy C0 X T1)))) }

-- And the lemma as the rest of the file asks for it, with the equation closed.
tyRebind : forall (G : Ctx) (Xn : String) (A : Ty) (B : Ty) (D : Ctx) (T : Ty)
             (h : ty (append (bindTy G Xn A) D) T)
             -> ty (append (bindTy G Xn B) D) T
tyRebind = \ G Xn A B D T h ->
  tyRebindAt G Xn A B (append (bindTy G Xn A) D) T h D
    (refl Ctx (append (bindTy G Xn A) D))


-- Inversion of well-formedness, one shape of context at a time.

OkTm : Ctx -> Ty -> Type₀
OkTm = \ G T -> And (ok G) (ty G T)

okBindTm : forall (G : Ctx) (w : String) (S : Ty) (o : ok (bindTm G w S)) -> OkTm G S
okBindTm = \ G w S o -> case o of
  { ok-bindTm G1 T1 x1 o1 h1 -> both (ok G) (ty G S) o1 h1 }

OkTy : Ctx -> String -> Ty -> Type₀
OkTy = \ G W S -> And (ok G) (And (notIn W G) (ty G S))

okBindTy : forall (G : Ctx) (W : String) (S : Ty) (o : ok (bindTy G W S)) -> OkTy G W S
okBindTy = \ G W S o -> case o of
  { ok-bindTy G1 X1 T1 o1 f1 h1 ->
      both (ok G) (And (notIn W G) (ty G S)) o1
        (both (notIn W G) (ty G S) f1 h1) }

-- And so a well-formed context stays well-formed when one bound is replaced by
-- another type that is well-formed where it is declared.
okRebind : forall (G : Ctx) (Xn : String) (A : Ty) (B : Ty) (D : Ctx)
             (o : ok (append (bindTy G Xn A) D)) (tb : ty G B)
             -> ok (append (bindTy G Xn B) D)
okRebind = \ G Xn A B D o tb -> induction D of
  { empty ->
      ok-bindTy G Xn B
        (andLeft (ok G) (And (notIn Xn G) (ty G A)) (okBindTy G Xn A o))
        (andLeft (notIn Xn G) (ty G A)
          (andRight (ok G) (And (notIn Xn G) (ty G A)) (okBindTy G Xn A o)))
        tb
  ; bindTm D0 w S ->
      ok-bindTm (append (bindTy G Xn B) D0) S w
        (okRebind G Xn A B D0
          (andLeft (ok (append (bindTy G Xn A) D0)) (ty (append (bindTy G Xn A) D0) S)
            (okBindTm (append (bindTy G Xn A) D0) w S o)) tb)
        (tyRebind G Xn A B D0 S
          (andRight (ok (append (bindTy G Xn A) D0)) (ty (append (bindTy G Xn A) D0) S)
            (okBindTm (append (bindTy G Xn A) D0) w S o)))
  ; bindTy D0 W S ->
      ok-bindTy (append (bindTy G Xn B) D0) W S
        (okRebind G Xn A B D0
          (andLeft (ok (append (bindTy G Xn A) D0))
             (And (notIn W (append (bindTy G Xn A) D0)) (ty (append (bindTy G Xn A) D0) S))
            (okBindTy (append (bindTy G Xn A) D0) W S o)) tb)
        (notInRebind G Xn A B D0 W
          (andLeft (notIn W (append (bindTy G Xn A) D0)) (ty (append (bindTy G Xn A) D0) S)
            (andRight (ok (append (bindTy G Xn A) D0))
              (And (notIn W (append (bindTy G Xn A) D0)) (ty (append (bindTy G Xn A) D0) S))
              (okBindTy (append (bindTy G Xn A) D0) W S o))))
        (tyRebind G Xn A B D0 S
          (andRight (notIn W (append (bindTy G Xn A) D0)) (ty (append (bindTy G Xn A) D0) S)
            (andRight (ok (append (bindTy G Xn A) D0))
              (And (notIn W (append (bindTy G Xn A) D0)) (ty (append (bindTy G Xn A) D0) S))
              (okBindTy (append (bindTy G Xn A) D0) W S o)))) }
