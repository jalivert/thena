-- A closed term has no free name — a case split on what fvInCtx says

:theorem closedNoFv-tactics : ∀ (N : LC) (S : Ty) (d : typing empty N S) (w : String) (h : In {0} w (LC-fv {0} N)) -> Empty {0}
attack
intro
intro
intro
intro
