-- Preservation for STLC again — the same lemmas as 07, proved by tactics.
--
-- LOAD AFTER 01, 02, 03 AND 07: this reuses 07's definitions (In, look, Good…)
-- and its small logic (subst, sym, trans, absurdly), and proves every lemma
-- again, by tactics, under a name ending in -tactics.
--
-- Run it with   :load examples/08-preservation-by-tactics.thena.script

-- ---------------------------------------------------------------------------
-- What `member` answers — induction on the list

:theorem memberSpec-tactics : ∀ (c : String) (xs : List {0} String) -> MemberSpec {0} c xs
attack
intro
intro
into
along
along
eliminate-core ⌜ xs ⌝
goto-named "nilMethod"
elaborate ⟨ orRight (And (Eq Comparison different same) Empty) (And (Eq Comparison different different) (Empty -> Empty)) (both (Eq Comparison different different) (Empty -> Empty) (refl Comparison different) (\ i -> i)) ⟩
goto-named "consMethod"
elaborate ⟨ \ b bs rb -> elim Dec ((Eq String c b)) (\ d -> Or (And (Eq Comparison (elim Dec ((Eq String c b)) (\ d1 -> Comparison) ((\ p -> same) (\ n -> member c bs)) () d) same) (Or (Eq String c b) (In c bs))) (And (Eq Comparison (elim Dec ((Eq String c b)) (\ d1 -> Comparison) ((\ p -> same) (\ n -> member c bs)) () d) different) (Or (Eq String c b) (In c bs) -> Empty))) ((\ p -> orLeft (And (Eq Comparison same same) (Or (Eq String c b) (In c bs))) (And (Eq Comparison same different) (Or (Eq String c b) (In c bs) -> Empty)) (both (Eq Comparison same same) (Or (Eq String c b) (In c bs)) (refl Comparison same) (orLeft (Eq String c b) (In c bs) p))) (\ n -> elim Or ((And (Eq Comparison (member c bs) same) (In c bs)) (And (Eq Comparison (member c bs) different) (In c bs -> Empty))) (\ o -> Or (And (Eq Comparison (member c bs) same) (Or (Eq String c b) (In c bs))) (And (Eq Comparison (member c bs) different) (Or (Eq String c b) (In c bs) -> Empty))) ((\ h -> orLeft (And (Eq Comparison (member c bs) same) (Or (Eq String c b) (In c bs))) (And (Eq Comparison (member c bs) different) (Or (Eq String c b) (In c bs) -> Empty)) (both (Eq Comparison (member c bs) same) (Or (Eq String c b) (In c bs)) (andLeft (Eq Comparison (member c bs) same) (In c bs) h) (orRight (Eq String c b) (In c bs) (andRight (Eq Comparison (member c bs) same) (In c bs) h)))) (\ h -> orRight (And (Eq Comparison (member c bs) same) (Or (Eq String c b) (In c bs))) (And (Eq Comparison (member c bs) different) (Or (Eq String c b) (In c bs) -> Empty)) (both (Eq Comparison (member c bs) different) (Or (Eq String c b) (In c bs) -> Empty) (andLeft (Eq Comparison (member c bs) different) (In c bs -> Empty) h) (\ o -> elim Or ((Eq String c b) (In c bs)) (\ o1 -> Empty) ((\ e -> n e) (\ i -> andRight (Eq Comparison (member c bs) different) (In c bs -> Empty) h i)) () o)))) () rb)) () (decString c b) ⟩
goto-named "memberSpec-tactics1"
solve
goto-named "memberSpec-tactics"
solve
qed

-- ---------------------------------------------------------------------------
-- LC-fresh keeps a name nothing forbids — induction on the list to avoid

:theorem freshKeeps-tactics : ∀ (c : String) (avoid : List {0} String) -> (In {0} c avoid -> Empty {0}) -> Eq {0} String (LC-fresh {0} c avoid) c
attack
intro
intro
into
along
along
eliminate-core ⌜ avoid ⌝
goto-named "nilMethod"
elaborate ⟨ \ ni -> refl String c ⟩
goto-named "consMethod"
elaborate ⟨ \ a rest r ni -> elim Or ((And (Eq Comparison (member c (cons String a rest)) same) (In c (cons String a rest))) (And (Eq Comparison (member c (cons String a rest)) different) (In c (cons String a rest) -> Empty))) (\ o -> Eq String (LC-fresh c (cons String a rest)) c) ((\ h -> absurdly _ (ni (andRight _ _ h))) (\ h -> pickDifferent c _ (member c (cons String a rest)) (andLeft _ _ h))) () (memberSpec-tactics c (cons String a rest)) ⟩
goto-named "freshKeeps-tactics1"
solve
goto-named "freshKeeps-tactics"
solve
qed

-- ---------------------------------------------------------------------------
-- Context lookups taken apart. A lookup's context is an index, so each is
-- proved for any context equal to the one wanted, by induction on the lookup,
-- and then for that context with `refl`.

:theorem ctxInvEmpty-general : ∀ (y : String) (U : Ty) (G : Ctx) (i : Ctx-in y U G) -> Eq {0} Ctx G empty -> Empty {0}
attack
intro
intro
intro
intro
into
along
along
along
along
eliminate-core ⌜ i ⌝
goto-named "Ctx-hereMethod"
elaborate ⟨ \ G x T e -> noConfusionCtx (extend G x T) empty e ⟩
goto-named "Ctx-thereMethod"
elaborate ⟨ \ G x T x1 T1 ne i1 ih e -> noConfusionCtx (extend G x1 T1) empty e ⟩
goto-named "ctxInvEmpty-general1"
solve
goto-named "ctxInvEmpty-general"
solve
qed

:theorem ctxInvEmpty-tactics : ∀ (y : String) (U : Ty) -> Ctx-in y U empty -> Empty {0}
elaborate ⟨ \ y U i -> ctxInvEmpty-general y U empty i (refl Ctx empty) ⟩
qed

:theorem ctxInvExtend-general : ∀ (y : String) (U : Ty) (G1 : Ctx) (i : Ctx-in y U G1) (G : Ctx) (a : String) (S : Ty) -> Eq {0} Ctx G1 (extend G a S) -> CtxFound G a S y U
attack
intro
intro
intro
intro
into
along
along
along
along
eliminate-core ⌜ i ⌝
goto-named "Ctx-hereMethod"
elaborate ⟨ \ G0 x T G a S e -> orLeft (And (Eq String x a) (Eq Ty T S)) (And (Eq String x a -> Empty) (Ctx-in x T G)) (both (Eq String x a) (Eq Ty T S) (extendName G0 x T G a S e) (extendTy G0 x T G a S e)) ⟩
goto-named "Ctx-thereMethod"
elaborate ⟨ \ G0 x T x1 T1 ne i1 ih G a S e -> orRight (And (Eq String x a) (Eq Ty T S)) (And (Eq String x a -> Empty) (Ctx-in x T G)) (both (Eq String x a -> Empty) (Ctx-in x T G) (\ q -> ne (trans String x a x1 q (sym String x1 a (extendName G0 x1 T1 G a S e)))) (subst Ctx (\ g -> Ctx-in x T g) G0 G (extendCtx G0 x1 T1 G a S e) i1)) ⟩
goto-named "ctxInvExtend-general1"
solve
goto-named "ctxInvExtend-general"
solve
qed

:theorem ctxInvExtend-tactics : ∀ (G : Ctx) (a : String) (S : Ty) (y : String) (U : Ty) -> Ctx-in y U (extend G a S) -> CtxFound G a S y U
elaborate ⟨ \ G a S y U i -> ctxInvExtend-general y U (extend G a S) i G a S (refl Ctx (extend G a S)) ⟩
qed

-- ---------------------------------------------------------------------------
-- Weakening — a case split on a lookup, then induction on the derivation

:theorem inclExtend-tactics : ∀ (G : Ctx) (G1 : Ctx) (x : String) (S : Ty) (inc : Incl G G1) -> Incl (extend G x S) (extend G1 x S)
attack
intro
intro
intro
intro
intro
intro
intro
intro
into
along
along
along
along
along
along
along
along
eliminate-core ⌜ ctxInvExtend-tactics G x S y U i ⌝
goto-named "orLeftMethod"
elaborate ⟨ \ h -> subst String (\ z -> Ctx-in z U (extend G1 x S)) x y (sym String y x (andLeft (Eq String y x) (Eq Ty U S) h)) (subst Ty (\ V -> Ctx-in x V (extend G1 x S)) S U (sym Ty U S (andRight (Eq String y x) (Eq Ty U S) h)) (Ctx-here G1 x S)) ⟩
goto-named "orRightMethod"
elaborate ⟨ \ h -> Ctx-there G1 y U x S (andLeft (Eq String y x -> Empty) (Ctx-in y U G) h) (inc y U (andRight (Eq String y x -> Empty) (Ctx-in y U G) h)) ⟩
goto-named "inclExtend-tactics1"
solve
goto-named "inclExtend-tactics"
solve
qed

:theorem weaken-tactics : ∀ (G : Ctx) (t : LC) (T : Ty) (d : typing G t T) (G1 : Ctx) (inc : Incl G G1) -> typing G1 t T
attack
intro
intro
intro
intro
into
along
along
along
along
eliminate-core ⌜ d ⌝
goto-named "T-varMethod"
elaborate ⟨ \ x T1 G0 i G1 inc -> T-var x T1 G1 (inc x T1 i) ⟩
goto-named "T-absMethod"
elaborate ⟨ \ G0 x S E T1 d0 ih G1 inc -> T-abs G1 x S E T1 (ih (extend G1 x S) (inclExtend-tactics G0 G1 x S inc)) ⟩
goto-named "T-appMethod"
elaborate ⟨ \ G0 M S T1 N d1 d2 ih1 ih2 G1 inc -> T-app G1 M S T1 N (ih1 G1 inc) (ih2 G1 inc) ⟩
goto-named "weaken-tactics1"
solve
goto-named "weaken-tactics"
solve
qed

:theorem weakenEmpty-tactics : ∀ (t : LC) (T : Ty) -> typing empty t T -> ∀ (D : Ctx) -> typing D t T
elaborate ⟨ \ t T d D -> weaken-tactics empty t T d D (\ y U i -> absurdly (Ctx-in y U D) (ctxInvEmpty-tactics y U i)) ⟩
qed

-- ---------------------------------------------------------------------------
-- A typed term's free names are in its context — induction on the derivation

:theorem fvInCtx-tactics : ∀ (G : Ctx) (t : LC) (T : Ty) (d : typing G t T) (bound : List {0} String) (acc : List {0} String) (w : String) (h : In {0} w (fvA {0 0} t bound acc)) -> FvSpec {0 0} G bound acc w
attack
intro
intro
intro
intro
into
along
along
along
along
eliminate-core ⌜ d ⌝
goto-named "T-varMethod"
elaborate ⟨ \ x T0 G0 i bound acc w h -> elim Or ((And (Eq Comparison (member x bound) same) (In x bound)) (And (Eq Comparison (member x bound) different) (In x bound -> Empty))) (\ o -> FvSpec G0 bound acc w) ((\ hs -> orLeft (In w acc) (And (In w bound -> Empty) (Dom G0 w)) (subst Comparison (\ q -> In w (elim Comparison () (\ q1 -> List String) ((acc) (cons String x acc)) () q)) (member x bound) same (andLeft (Eq Comparison (member x bound) same) (In x bound) hs) h)) (\ hs -> elim Or ((Eq String w x) (In w acc)) (\ o1 -> FvSpec G0 bound acc w) ((\ q -> orRight (In w acc) (And (In w bound -> Empty) (Dom G0 w)) (both (In w bound -> Empty) (Dom G0 w) (\ ib -> andRight (Eq Comparison (member x bound) different) (In x bound -> Empty) hs (subst String (\ z -> In z bound) w x q ib)) (pair Ty (\ U -> Ctx-in w U G0) T0 (subst String (\ z -> Ctx-in z T0 G0) x w (sym String w x q) i)))) (\ ia -> orLeft (In w acc) (And (In w bound -> Empty) (Dom G0 w)) ia)) () (subst Comparison (\ q -> In w (elim Comparison () (\ q1 -> List String) ((acc) (cons String x acc)) () q)) (member x bound) different (andLeft (Eq Comparison (member x bound) different) (In x bound -> Empty) hs) h))) () (memberSpec-tactics x bound) ⟩
goto-named "T-absMethod"
elaborate ⟨ \ G0 x S E T0 d0 ih bound acc w h -> elim Or ((In w acc) (And (In w (cons String x bound) -> Empty) (Dom (extend G0 x S) w))) (\ o -> FvSpec G0 bound acc w) ((\ ia -> orLeft (In w acc) (And (In w bound -> Empty) (Dom G0 w)) ia) (\ hb -> elim Sigma (Ty (\ U -> Ctx-in w U (extend G0 x S))) (\ z -> FvSpec G0 bound acc w) ((\ U i -> elim Or ((And (Eq String w x) (Eq Ty U S)) (And (Eq String w x -> Empty) (Ctx-in w U G0))) (\ o1 -> FvSpec G0 bound acc w) ((\ isX -> absurdly (FvSpec G0 bound acc w) (andLeft (In w (cons String x bound) -> Empty) (Dom (extend G0 x S) w) hb (orLeft (Eq String w x) (In w bound) (andLeft (Eq String w x) (Eq Ty U S) isX)))) (\ other -> orRight (In w acc) (And (In w bound -> Empty) (Dom G0 w)) (both (In w bound -> Empty) (Dom G0 w) (\ ib -> andLeft (In w (cons String x bound) -> Empty) (Dom (extend G0 x S) w) hb (orRight (Eq String w x) (In w bound) ib)) (pair Ty (\ U1 -> Ctx-in w U1 G0) U (andRight (Eq String w x -> Empty) (Ctx-in w U G0) other))))) () (ctxInvExtend-tactics G0 x S w U i))) () (andRight (In w (cons String x bound) -> Empty) (Dom (extend G0 x S) w) hb))) () (ih (cons String x bound) acc w h) ⟩
goto-named "T-appMethod"
elaborate ⟨ \ G0 M S T0 N d1 d2 ih1 ih2 bound acc w h -> elim Or ((In w (fvA N bound acc)) (And (In w bound -> Empty) (Dom G0 w))) (\ o -> FvSpec G0 bound acc w) ((\ h2 -> ih2 bound acc w h2) (\ r -> orRight (In w acc) (And (In w bound -> Empty) (Dom G0 w)) r)) () (ih1 bound (fvA N bound acc) w h) ⟩
goto-named "fvInCtx-tactics1"
solve
goto-named "fvInCtx-tactics"
solve
qed

