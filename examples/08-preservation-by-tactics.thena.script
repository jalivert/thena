into
along
along
along
along
along
along
along
along
along
along
eliminate-core ⌜ imagesIn-tactics s (LC-fv {0} (abs x S E)) x h ⌝
goto-named "pairMethod"
elaborate ⟨ \ y p -> elim Or ((In y (nil String)) (And (In y (cons String x (nil String)) -> Empty) (Dom (extend G x S) y))) (\ o -> Empty) ((\ e -> e) (\ r -> elim Sigma (Ty (\ U -> Ctx-in y U (extend G x S))) (\ z -> Empty) ((\ U i -> elim Or ((And (Eq String y x) (Eq Ty U S)) (And (Eq String y x -> Empty) (Ctx-in y U G))) (\ o -> Empty) ((\ h1 -> andLeft (In y (cons String x (nil String)) -> Empty) (Dom (extend G x S) y) r (orLeft (Eq String y x) (In y (nil String)) (andLeft (Eq String y x) (Eq Ty U S) h1))) (\ h2 -> elim Or ((And (Eq LC (look y s) (var y)) (Ctx-in y U D)) (And (typing empty (look y s) U) (Eq (List String) (LC-fv (look y s)) (nil String)))) (\ o -> Empty) ((\ e -> elim Or ((Eq String x y) Empty) (\ o1 -> Empty) ((\ q -> andLeft (Eq String y x -> Empty) (Ctx-in y U G) h2 (sym String x y q)) (\ e1 -> e1)) () (subst LC (\ m -> In x (LC-fv m)) (look y s) (var y) (andLeft (Eq LC (look y s) (var y)) (Ctx-in y U D) e) (andRight (In y (LC-fv (abs x S E))) (In x (LC-fv (look y s))) p))) (\ c -> subst (List String) (\ l -> In x l) (LC-fv (look y s)) (nil String) (andRight (typing empty (look y s) U) (Eq (List String) (LC-fv (look y s)) (nil String)) c) (andRight (In y (LC-fv (abs x S E))) (In x (LC-fv (look y s))) p))) () (g y U (andRight (Eq String y x -> Empty) (Ctx-in y U G) h2)))) () (ctxInvExtend-tactics G x S y U i))) () (andRight (In y (cons String x (nil String)) -> Empty) (Dom (extend G x S) y) r))) () (fvInCtx-tactics (extend G x S) E T d (cons String x (nil String)) (nil String) y (andLeft (In y (LC-fv (abs x S E))) (In x (LC-fv (look y s))) p)) ⟩
goto-named "notCaptured-tactics1"
solve
goto-named "notCaptured-tactics"
solve
qed

-- ---------------------------------------------------------------------------
-- The substitution lemma — induction on the derivation

:theorem substAll-tactics : ∀ (G : Ctx) (E : LC) (T : Ty) (d : typing G E T) (D : Ctx) (s : List {0} (And {0 0} String LC)) (g : Good {0 0 0} G D s) -> typing D (LC-subst-all {0 0 0} E s) T
attack
intro
intro
intro
intro
into
along
along
along
along
eliminate-core ⌜ d ⌝
goto-named "T-varMethod"
elaborate ⟨ \ x T0 G0 i D s g -> elim Or ((And (Eq LC (look x s) (var x)) (Ctx-in x T0 D)) (And (typing empty (look x s) T0) (Eq (List String) (LC-fv (look x s)) (nil String)))) (\ o -> typing D (look x s) T0) ((\ e -> subst LC (\ m -> typing D m T0) (var x) (look x s) (sym LC (look x s) (var x) (andLeft (Eq LC (look x s) (var x)) (Ctx-in x T0 D) e)) (T-var x T0 D (andRight (Eq LC (look x s) (var x)) (Ctx-in x T0 D) e))) (\ c -> weakenEmpty-tactics (look x s) T0 (andLeft (typing empty (look x s) T0) (Eq (List String) (LC-fv (look x s)) (nil String)) c) D)) () (g x T0 i) ⟩
goto-named "T-absMethod"
elaborate ⟨ \ G0 x S E0 T0 d0 ih D s g -> subst String (\ z -> typing D (abs z S (LC-subst-all E0 (cons (And String LC) (both String LC x (var z)) s))) (arrow S T0)) x (LC-fresh x (images s (LC-fv (abs x S E0)))) (sym String (LC-fresh x (images s (LC-fv (abs x S E0)))) x (freshKeeps-tactics x (images s (LC-fv (abs x S E0))) (notCaptured-tactics G0 D s x S E0 T0 d0 g))) (T-abs D x S (LC-subst-all E0 (cons (And String LC) (both String LC x (var x)) s)) T0 (ih (extend D x S) (cons (And String LC) (both String LC x (var x)) s) (goodExtend-tactics G0 D s x S g))) ⟩
goto-named "T-appMethod"
elaborate ⟨ \ G0 M S T0 N d1 d2 ih1 ih2 D s g -> T-app D (LC-subst-all M s) S T0 (LC-subst-all N s) (ih1 D s g) (ih2 D s g) ⟩
goto-named "substAll-tactics1"
solve
goto-named "substAll-tactics"
solve
qed

:theorem substLemma-tactics : ∀ (x : String) (S : Ty) (E : LC) (T : Ty) (N : LC) (d : typing (extend empty x S) E T) (dn : typing empty N S) -> typing empty (LC-subst E x N) T
elaborate ⟨ \ x S E T N d dn -> substAll-tactics (extend empty x S) E T d empty (cons (And String LC) (both String LC x N) (nil (And String LC))) (\ y U i -> elim Or ((And (Eq String y x) (Eq Ty U S)) (And (Eq String y x -> Empty) (Ctx-in y U empty))) (\ o -> Entry empty y U (look y (cons (And String LC) (both String LC x N) (nil (And String LC))))) ((\ h -> subst String (\ z -> Entry empty z U (look z (cons (And String LC) (both String LC x N) (nil (And String LC))))) x y (sym String y x (andLeft (Eq String y x) (Eq Ty U S) h)) (subst Ty (\ V -> Entry empty x V (look x (cons (And String LC) (both String LC x N) (nil (And String LC))))) S U (sym Ty U S (andRight (Eq String y x) (Eq Ty U S) h)) (subst LC (\ m -> Entry empty x S m) N (look x (cons (And String LC) (both String LC x N) (nil (And String LC)))) (sym LC (look x (cons (And String LC) (both String LC x N) (nil (And String LC)))) N (lookHit-tactics x N (nil (And String LC)))) (orRight (And (Eq LC N (var x)) (Ctx-in x S empty)) (And (typing empty N S) (Eq (List String) (LC-fv N) (nil String))) (both (typing empty N S) (Eq (List String) (LC-fv N) (nil String)) dn (listNil-tactics (LC-fv N) (closedNoFv-tactics N S dn))))))) (\ h -> absurdly (Entry empty y U (look y (cons (And String LC) (both String LC x N) (nil (And String LC))))) (ctxInvEmpty-tactics y U (andRight (Eq String y x -> Empty) (Ctx-in y U empty) h)))) () (ctxInvExtend-tactics empty x S y U i)) ⟩
qed

-- ---------------------------------------------------------------------------
-- Inversion — for any term equal to the shape wanted, then for the shape

:theorem invApp-general : ∀ (G : Ctx) (t : LC) (T : Ty) (d : typing G t T) (M : LC) (N : LC) (e : Eq {0} LC t (app M N)) -> AppInv G M N T
attack
intro
intro
intro
intro
into
along
along
along
along
eliminate-core ⌜ d ⌝
goto-named "T-varMethod"
elaborate ⟨ \ x T0 G0 i M N e -> absurdly (AppInv G0 M N T0) (noConfusionLC (var x) (app M N) e) ⟩
goto-named "T-absMethod"
elaborate ⟨ \ G0 x S E T0 d0 ih M N e -> absurdly (AppInv G0 M N (arrow S T0)) (noConfusionLC (abs x S E) (app M N) e) ⟩
goto-named "T-appMethod"
elaborate ⟨ \ G0 M0 S T0 N0 d1 d2 ih1 ih2 M N e -> pair Ty (\ S1 -> And (typing G0 M (arrow S1 T0)) (typing G0 N S1)) S (both (typing G0 M (arrow S T0)) (typing G0 N S) (subst LC (\ m -> typing G0 m (arrow S T0)) M0 M (andLeft (Eq LC M0 M) (Eq LC N0 N) (appInj M0 N0 M N e)) d1) (subst LC (\ n -> typing G0 n S) N0 N (andRight (Eq LC M0 M) (Eq LC N0 N) (appInj M0 N0 M N e)) d2)) ⟩
goto-named "invApp-general1"
solve
goto-named "invApp-general"
solve
qed

:theorem invApp-tactics : ∀ (G : Ctx) (M : LC) (N : LC) (T : Ty) (d : typing G (app M N) T) -> AppInv G M N T
elaborate ⟨ \ G M N T d -> invApp-general G (app M N) T d M N (refl LC (app M N)) ⟩
qed

:theorem invAbs-general : ∀ (G : Ctx) (t : LC) (T : Ty) (d : typing G t T) (x : String) (S : Ty) (E : LC) (e : Eq {0} LC t (abs x S E)) -> AbsInv G x S E T
