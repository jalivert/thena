:theorem invAbs-tactics : ∀ (G : Ctx) (x : String) (S : Ty) (E : LC) (T : Ty) (d : typing G (abs x S E) T) -> AbsInv G x S E T
elaborate ⟨ \ G x S E T d -> invAbs-general G (abs x S E) T d x S E (refl LC (abs x S E)) ⟩
qed

-- ---------------------------------------------------------------------------
-- Preservation — induction on the step, and in the β case two case splits by
-- tactic: typing the application apart, then typing the function apart.
--
-- The statement takes the step before the type, so that the step can be
-- eliminated with the typing still in the goal; `preservation-tactics` below
-- puts the arguments back in 07's order. The type is called U, not T: the
-- β rule's own T is a binder of the method, and two binders named T would
-- leave the rule's unreachable.

:theorem preservation-step : ∀ (M : LC) (M1 : LC) (s : step M M1) (U : Ty) (d : typing empty M U) -> typing empty M1 U
attack
intro
intro
intro
goto-named "preservation-step1"
eliminate-core ⌜ s ⌝
goto-named "E-betaMethod"
attack
intro
intro
intro
intro
intro
intro
intro
goto-named "E-betaMethod1"
eliminate-core ⌜ invApp-tactics empty (abs x T E) N U d ⌝
goto-named "pairMethod"
attack
intro
intro
goto-named "pairMethod1"
eliminate-core ⌜ invAbs-tactics empty x T E (arrow a U) (andLeft {0 0} (typing empty (abs x T E) (arrow a U)) (typing empty N a) b) ⌝
goto-named "pairMethod2"
elaborate ⟨ \ U1 q -> substLemma-tactics x T E U N (subst Ty (\ V -> typing (extend empty x T) E V) U1 U (sym Ty U U1 (andRight (Eq Ty a T) (Eq Ty U U1) (arrowInj a U T U1 (andLeft (Eq Ty (arrow a U) (arrow T U1)) (typing (extend empty x T) E U1) q)))) (andRight (Eq Ty (arrow a U) (arrow T U1)) (typing (extend empty x T) E U1) q)) (subst Ty (\ V -> typing empty N V) a T (andLeft (Eq Ty a T) (Eq Ty U U1) (arrowInj a U T U1 (andLeft (Eq Ty (arrow a U) (arrow T U1)) (typing (extend empty x T) E U1) q))) (andRight (typing empty (abs x T E) (arrow a U)) (typing empty N a) b)) ⟩
goto-named "pairMethod1"
solve
goto-named "pairMethod"
solve
goto-named "E-betaMethod1"
solve
goto-named "E-betaMethod"
solve
goto-named "E-app1Method"
attack
intro
intro
intro
intro
intro
intro
intro
goto-named "E-app1Method1"
eliminate-core ⌜ invApp-tactics empty M N U d ⌝
goto-named "pairMethod"
elaborate ⟨ \ S p -> T-app empty M' S U N (ih (arrow S U) (andLeft (typing empty M (arrow S U)) (typing empty N S) p)) (andRight (typing empty M (arrow S U)) (typing empty N S) p) ⟩
goto-named "E-app1Method1"
solve
goto-named "E-app1Method"
solve
goto-named "E-app2Method"
attack
intro
intro
intro
intro
intro
intro
intro
intro
goto-named "E-app2Method1"
eliminate-core ⌜ invApp-tactics empty M N U d ⌝
goto-named "pairMethod"
elaborate ⟨ \ S p -> T-app empty M S U N' (andLeft (typing empty M (arrow S U)) (typing empty N S) p) (ih S (andRight (typing empty M (arrow S U)) (typing empty N S) p)) ⟩
goto-named "E-app2Method1"
solve
goto-named "E-app2Method"
solve
goto-named "preservation-step1"
solve
goto-named "preservation-step"
solve
qed

-- The statement 07 proves, in 07's order.

:theorem preservation-tactics : ∀ (M : LC) (M1 : LC) (T : Ty) (d : typing empty M T) (s : step M M1) -> typing empty M1 T
elaborate ⟨ \ M M1 T d s -> preservation-step M M1 s T d ⟩
qed
