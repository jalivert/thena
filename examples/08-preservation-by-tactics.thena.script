-- ---------------------------------------------------------------------------
-- Looking up in a substitution, following decString

:theorem lookHit-tactics : ∀ (x : String) (w : LC) (s : List {0} (And {0 0} String LC)) -> Eq {0} LC (look {0 0 0} x (cons {0} (And {0 0} String LC) (both {0 0} String LC x w) s)) w
elaborate ⟨ \ x w s -> elim Dec ((Eq String x x)) (\ d -> Eq LC (elim Dec ((Eq String x x)) (\ d1 -> LC) ((\ p1 -> w) (\ n -> look x s)) () d) w) ((\ p -> refl LC w) (\ n -> absurdly (Eq LC (look x s) w) (n (refl String x)))) () (decString x x) ⟩
qed

:theorem lookMiss-tactics : ∀ (y : String) (x : String) (w : LC) (s : List {0} (And {0 0} String LC)) (ne : Eq {0} String y x -> Empty {0}) -> Eq {0} LC (look {0 0 0} y (cons {0} (And {0 0} String LC) (both {0 0} String LC x w) s)) (look {0 0 0} y s)
elaborate ⟨ \ y x w s ne -> elim Dec ((Eq String y x)) (\ d -> Eq LC (elim Dec ((Eq String y x)) (\ d1 -> LC) ((\ p1 -> w) (\ n -> look y s)) () d) (look y s)) ((\ p -> absurdly (Eq LC w (look y s)) (ne p)) (\ n -> refl LC (look y s))) () (decString y x) ⟩
qed

-- ---------------------------------------------------------------------------
-- The invariant survives a binder — a case split on the lookup

:theorem goodExtend-tactics : ∀ (G : Ctx) (D : Ctx) (s : List {0} (And {0 0} String LC)) (x : String) (S : Ty) (g : Good {0 0 0} G D s) (y : String) (U : Ty) (i : Ctx-in y U (extend G x S)) -> Entry (extend D x S) y U (look {0 0 0} y (cons {0} (And {0 0} String LC) (both {0 0} String LC x (var x)) s))
attack
intro
intro
intro
intro
intro
intro
intro
intro
intro
into
along
along
along
along
along
along
along
along
along
eliminate-core ⌜ ctxInvExtend-tactics G x S y U i ⌝
goto-named "orLeftMethod"
elaborate ⟨ \ h -> subst String (\ z -> Entry (extend D x S) z U (look z (cons (And String LC) (both String LC x (var x)) s))) x y (sym String y x (andLeft (Eq String y x) (Eq Ty U S) h)) (subst Ty (\ V -> Entry (extend D x S) x V (look x (cons (And String LC) (both String LC x (var x)) s))) S U (sym Ty U S (andRight (Eq String y x) (Eq Ty U S) h)) (orLeft (And (Eq LC (look x (cons (And String LC) (both String LC x (var x)) s)) (var x)) (Ctx-in x S (extend D x S))) (And (typing empty (look x (cons (And String LC) (both String LC x (var x)) s)) S) (Eq (List String) (LC-fv (look x (cons (And String LC) (both String LC x (var x)) s))) (nil String))) (both (Eq LC (look x (cons (And String LC) (both String LC x (var x)) s)) (var x)) (Ctx-in x S (extend D x S)) (lookHit-tactics x (var x) s) (Ctx-here D x S)))) ⟩
goto-named "orRightMethod"
elaborate ⟨ \ h -> subst LC (\ m -> Entry (extend D x S) y U m) (look y s) (look y (cons (And String LC) (both String LC x (var x)) s)) (sym LC (look y (cons (And String LC) (both String LC x (var x)) s)) (look y s) (lookMiss-tactics y x (var x) s (andLeft (Eq String y x -> Empty) (Ctx-in y U G) h))) (elim Or ((And (Eq LC (look y s) (var y)) (Ctx-in y U D)) (And (typing empty (look y s) U) (Eq (List String) (LC-fv (look y s)) (nil String)))) (\ o1 -> Entry (extend D x S) y U (look y s)) ((\ e -> orLeft (And (Eq LC (look y s) (var y)) (Ctx-in y U (extend D x S))) (And (typing empty (look y s) U) (Eq (List String) (LC-fv (look y s)) (nil String))) (both (Eq LC (look y s) (var y)) (Ctx-in y U (extend D x S)) (andLeft (Eq LC (look y s) (var y)) (Ctx-in y U D) e) (Ctx-there D y U x S (andLeft (Eq String y x -> Empty) (Ctx-in y U G) h) (andRight (Eq LC (look y s) (var y)) (Ctx-in y U D) e)))) (\ c -> orRight (And (Eq LC (look y s) (var y)) (Ctx-in y U (extend D x S))) (And (typing empty (look y s) U) (Eq (List String) (LC-fv (look y s)) (nil String))) c)) () (g y U (andRight (Eq String y x -> Empty) (Ctx-in y U G) h))) ⟩
goto-named "goodExtend-tactics1"
solve
goto-named "goodExtend-tactics"
solve
qed

-- ---------------------------------------------------------------------------
-- No binder is captured — a case split on where an avoided name comes from

:theorem notCaptured-tactics : ∀ (G : Ctx) (D : Ctx) (s : List {0} (And {0 0} String LC)) (x : String) (S : Ty) (E : LC) (T : Ty) (d : typing (extend G x S) E T) (g : Good {0 0 0} G D s) (h : In {0} x (images {0 0 0 0 0} s (LC-fv {0} (abs x S E)))) -> Empty {0}
attack
