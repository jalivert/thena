goto-named "orLeftMethod"
elaborate ⟨ \ e -> e ⟩
goto-named "orRightMethod"
elaborate ⟨ \ r -> elim Sigma (Ty (\ U -> Ctx-in w U empty)) (\ z -> Empty) ((\ U i -> ctxInvEmpty-tactics w U i)) () (andRight (In w (nil String) -> Empty) (Dom empty w) r) ⟩
goto-named "closedNoFv-tactics1"
