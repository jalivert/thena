-- Determinacy of a small-step semantics for the untyped arithmetic terms of
-- TAPL chapter 3 — the same theorem as examples/determinacy-surface.thena, and
-- the point of the file is the BOUNDARY it draws: eleven of its thirteen
-- lemmas are dependent pattern matching, and two of them cannot be, so they
-- are the generated proof's own, pasted here unchanged.
--
-- WRITTEN BY HAND except for those two. The companion file is GENERATED by
-- examples/determinacy.py, because nobody would write it: each of its thirteen
-- lemmas abstracts the goal over an equation `Eq Term x <the pattern I meant>`,
-- writes out all ten methods of `elim Step` whether the case is possible or not,
-- and discharges the nine impossible ones by hand with `noConfusionTerm`.
--
-- WHAT THE SPLIT DOES INSTEAD. `case s of { … }` unifies each constructor's
-- indices with the scrutinee's, and a method whose equations conflict is closed
-- before the user sees it — so an impossible case is an arm NOT WRITTEN rather
-- than a line of `absurd (…) (noConfusionTerm … q)`. A split also GENERALISES
-- the ambient entries its indices mention, quantifying a fresh copy of each, so
-- an arm that forces `p` to `true` gets `s0 : Step true p'` under its own name.
-- That is what lets `invIf`, `invSucc`, `invPred` and `invIsZero` be one arm
-- per possible case instead of ten methods each.
--
-- WHY A RECURSION MAY NOT CROSS A SPLIT, and it is why those four are lemmas
-- rather than inlined into `determinacy`'s arms. A recursive call is tied to an
-- induction hypothesis by the argument it names, and the hypothesis is about
-- the ENTRY, while inside a generalising split that name means the entry's
-- refined copy. So the hypothesis is taken as a PARAMETER — `succNoStep`'s
-- `ihp`, and `ih0` in the four — and the caller passes the recursive call from
-- outside the split, where it still names the entry.
--
-- WHY `invPredSucc` AND `invIsZeroSucc` ARE STILL THE OLD PROOF. Their index is
-- `pred (succ v)`, which nests a constructor around the generalised variable, so
-- against `ePred`'s own index `pred c1` injectivity leaves `Eq Term c1 (succ v9)`
-- — and `c1` is a binder of the method while `v9` is quantified AFTER it, so
-- solving `c1` to a term that mentions `v9` is not a telescope move the
-- specialiser has. Thena states the equation and keeps it; the arm would have to
-- be written to take it, and his ruling of 2026-10-20 is that a proof which
-- leverages that is not correctly proved, because an arm whose right-hand side
-- is a function of an equation the user had no way to predict is the elaboration
-- into the development calculus leaking into the surface. **These two will go
-- when a copy can be permuted before the argument that must be solved to it,
-- and not before.**

module Determinacy where

data Term : Type₀ where
  true : Term
  false : Term
  ifthen : Term -> Term -> Term -> Term
  zero : Term
  succ : Term -> Term
  pred : Term -> Term
  iszero : Term -> Term

data NV : Term -> Type₀ where
  nvZero : NV zero
  nvSucc : forall (t : Term) (n : NV t) -> NV (succ t)

data Step : Term -> Term -> Type₀ where
  eIfTrue : forall (t2 : Term) (t3 : Term) -> Step (ifthen true t2 t3) t2
  eIfFalse : forall (t2 : Term) (t3 : Term) -> Step (ifthen false t2 t3) t3
  eIf : forall (t1 : Term) (t1' : Term) (t2 : Term) (t3 : Term) (s : Step t1 t1') -> Step (ifthen t1 t2 t3) (ifthen t1' t2 t3)
  eSucc : forall (t1 : Term) (t1' : Term) (s : Step t1 t1') -> Step (succ t1) (succ t1')
  ePredZero : Step (pred zero) zero
  ePredSucc : forall (v : Term) (nv : NV v) -> Step (pred (succ v)) v
  ePred : forall (t1 : Term) (t1' : Term) (s : Step t1 t1') -> Step (pred t1) (pred t1')
  eIsZeroZero : Step (iszero zero) true
  eIsZeroSucc : forall (v : Term) (nv : NV v) -> Step (iszero (succ v)) false
  eIsZero : forall (t1 : Term) (t1' : Term) (s : Step t1 t1') -> Step (iszero t1) (iszero t1')

-- The equipment, and all four of these are splits too. `Empty` has no
-- constructors, so `absurd` has no arms. `Eq` has one, and its single arm
-- forces both indices to the same variable — which is what makes `refl B (f c)`
-- and the identity function proofs of `cong` and `subst`.
absurd : forall (C : Type₀) (e : Empty) -> C
absurd = \ C e -> case e of { }

sym : forall (A : Type₀) (a : A) (b : A) (e : Eq A a b) -> Eq A b a
sym = \ A a b e -> case e of { refl c -> refl A c }

subst : forall (A : Type₀) (P : A -> Type₀) (a : A) (b : A) (e : Eq A a b) (p : P a) -> P b
subst = \ A P a b e -> case e of { refl c -> \ z -> z }

cong : forall (A : Type₀) (B : Type₀) (f : A -> B) (a : A) (b : A) (e : Eq A a b) -> Eq B (f a) (f b)
cong = \ A B f a b e -> case e of { refl c -> refl B (f c) }

-- No value steps. Each of these is the whole lemma: every constructor of `Step`
-- has `ifthen`, `succ`, `pred` or `iszero` at its source, so against `true`,
-- `false` or `zero` all ten methods are closed by a conflicting equation and
-- there is nothing left to answer. The generated proof writes ten methods and
-- ten appeals to no-confusion for each of these three.
trueNoStep : forall (u : Term) (s : Step true u) -> Empty
trueNoStep = \ u s -> case s of { }

falseNoStep : forall (u : Term) (s : Step false u) -> Empty
falseNoStep = \ u s -> case s of { }

zeroNoStep : forall (u : Term) (s : Step zero u) -> Empty
zeroNoStep = \ u s -> case s of { }

-- A step out of `succ p` is a step out of `p`, so the hypothesis about `p` is
-- all this needs — and taking it as `ihp` rather than recursing is what keeps
-- the recursion out of the split. Inside the arm `ihp` is the refined copy,
-- `forall (w : Term) -> Step c1 w -> Empty`, so `sr` fits it with no transport.
succNoStep : forall (p : Term) (ihp : forall (w : Term) (sw : Step p w) -> Empty) (u : Term) (s : Step (succ p) u) -> Empty
succNoStep = \ p ihp u s -> case s of
  { eSucc c1 c1' sr -> ihp c1' sr }

-- `u` and `s` are deliberately NOT introduced before the split on `nv`: the
-- index `t` is a context variable, and an index no introduced premise mentions
-- is abstracted with no equation. `nvNoStep t n` IS the induction hypothesis,
-- and it is written here, outside `succNoStep`'s split, which is the only place
-- it can be written.
nvNoStep : forall (v : Term) (nv : NV v) (u : Term) (s : Step v u) -> Empty
nvNoStep = \ v nv -> induction nv of
  { nvZero -> \ u s -> zeroNoStep u s
  ; nvSucc t n -> succNoStep t (\ w sw -> nvNoStep t n w sw) }

-- ---------------------------------------------------------------------------
-- The four congruence inversions. Each takes the hypothesis about its subject
-- as `ih0`, for the reason in the header, and each is one arm per case the
-- source admits: the cases where the subject is a value and the step out of it
-- is absurd, and the case where it steps, where `ih0` gives the two results
-- equal. `invSucc` has only the second.
-- ---------------------------------------------------------------------------

invIf : forall (p : Term) (p' : Term) (a : Term) (b : Term) (s0 : Step p p') (ih0 : forall (w : Term) (sw : Step p w) -> Eq Term p' w) (u : Term) (s : Step (ifthen p a b) u) -> Eq Term (ifthen p' a b) u
invIf = \ p p' a b s0 ih0 u s -> case s of
  { eIfTrue c d -> absurd (Eq Term (ifthen p' c d) c) (trueNoStep p' s0)
  ; eIfFalse c d -> absurd (Eq Term (ifthen p' c d) d) (falseNoStep p' s0)
  ; eIf c1 c1' c2 c3 sr -> cong Term Term (\ x -> ifthen x c2 c3) p' c1' (ih0 c1' sr) }

invSucc : forall (p : Term) (p' : Term) (s0 : Step p p') (ih0 : forall (w : Term) (sw : Step p w) -> Eq Term p' w) (u : Term) (s : Step (succ p) u) -> Eq Term (succ p') u
invSucc = \ p p' s0 ih0 u s -> case s of
  { eSucc c1 c1' sr -> cong Term Term (\ x -> succ x) p' c1' (ih0 c1' sr) }

invPred : forall (p : Term) (p' : Term) (s0 : Step p p') (ih0 : forall (w : Term) (sw : Step p w) -> Eq Term p' w) (u : Term) (s : Step (pred p) u) -> Eq Term (pred p') u
invPred = \ p p' s0 ih0 u s -> case s of
  { ePredZero -> absurd (Eq Term (pred p') zero) (zeroNoStep p' s0)
  ; ePredSucc c1 nv1 -> absurd (Eq Term (pred p') c1) (nvNoStep (succ c1) (nvSucc c1 nv1) p' s0)
  ; ePred c1 c1' sr -> cong Term Term (\ x -> pred x) p' c1' (ih0 c1' sr) }

invIsZero : forall (p : Term) (p' : Term) (s0 : Step p p') (ih0 : forall (w : Term) (sw : Step p w) -> Eq Term p' w) (u : Term) (s : Step (iszero p) u) -> Eq Term (iszero p') u
invIsZero = \ p p' s0 ih0 u s -> case s of
  { eIsZeroZero -> absurd (Eq Term (iszero p') true) (zeroNoStep p' s0)
  ; eIsZeroSucc c1 nv1 -> absurd (Eq Term (iszero p') false) (nvNoStep (succ c1) (nvSucc c1 nv1) p' s0)
  ; eIsZero c1 c1' sr -> cong Term Term (\ x -> iszero x) p' c1' (ih0 c1' sr) }

-- ---------------------------------------------------------------------------
-- THE TWO THE SPLIT CANNOT DO, and these are `determinacy.py`'s own, pasted
-- unchanged. Each writes out all ten methods of `elim Step`, states the
-- equation `Eq Term x <the pattern>` in its own motive, and discharges nine
-- impossible cases with `noConfusionTerm`. Read one against any arm above.
-- ---------------------------------------------------------------------------

invPredSucc : ∀ (v : Term) (nv : NV v) (u : Term) (s : Step (pred (succ v)) u) -> Eq Term v u
invPredSucc = \ v nv u s ->
  elim Step () (\ x y r -> Eq Term x (pred (succ v)) -> Eq Term v y)
    ((\ c1 c2 q -> absurd (Eq Term v c1) (noConfusionTerm (ifthen true c1 c2) (pred (succ v)) q))
     (\ c1 c2 q -> absurd (Eq Term v c2) (noConfusionTerm (ifthen false c1 c2) (pred (succ v)) q))
     (\ c1 c2 c3 c4 sr ih q -> absurd (Eq Term v (ifthen c2 c3 c4)) (noConfusionTerm (ifthen c1 c3 c4) (pred (succ v)) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term v (succ c2)) (noConfusionTerm (succ c1) (pred (succ v)) q))
     (\ q -> let nc2 : Eq Term zero (succ v) = noConfusionTerm (pred zero) (pred (succ v)) q in let e1 : Eq Term zero (succ v) = (nc2) in absurd (Eq Term v zero) (noConfusionTerm zero (succ v) e1))
     (\ c1 nv1 q -> let nc2 : Eq Term (succ c1) (succ v) = noConfusionTerm (pred (succ c1)) (pred (succ v)) q in let e1 : Eq Term (succ c1) (succ v) = (nc2) in let nc4 : Eq Term c1 v = noConfusionTerm (succ c1) (succ v) e1 in let e3 : Eq Term c1 v = (nc4) in sym Term c1 v e3)
     (\ c1 c2 sr ih q -> let nc2 : Eq Term c1 (succ v) = noConfusionTerm (pred c1) (pred (succ v)) q in let e1 : Eq Term c1 (succ v) = (nc2) in absurd (Eq Term v (pred c2)) (nvNoStep (succ v) (nvSucc v nv) c2 (subst Term (\ x -> Step x c2) c1 (succ v) (e1) (sr))))
     (\ q -> absurd (Eq Term v true) (noConfusionTerm (iszero zero) (pred (succ v)) q))
     (\ c1 nv1 q -> absurd (Eq Term v false) (noConfusionTerm (iszero (succ c1)) (pred (succ v)) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term v (iszero c2)) (noConfusionTerm (iszero c1) (pred (succ v)) q)))
    ((pred (succ v)) u) s (refl Term (pred (succ v)))

invIsZeroSucc : ∀ (v : Term) (nv : NV v) (u : Term) (s : Step (iszero (succ v)) u) -> Eq Term false u
invIsZeroSucc = \ v nv u s ->
  elim Step () (\ x y r -> Eq Term x (iszero (succ v)) -> Eq Term false y)
    ((\ c1 c2 q -> absurd (Eq Term false c1) (noConfusionTerm (ifthen true c1 c2) (iszero (succ v)) q))
     (\ c1 c2 q -> absurd (Eq Term false c2) (noConfusionTerm (ifthen false c1 c2) (iszero (succ v)) q))
     (\ c1 c2 c3 c4 sr ih q -> absurd (Eq Term false (ifthen c2 c3 c4)) (noConfusionTerm (ifthen c1 c3 c4) (iszero (succ v)) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term false (succ c2)) (noConfusionTerm (succ c1) (iszero (succ v)) q))
     (\ q -> absurd (Eq Term false zero) (noConfusionTerm (pred zero) (iszero (succ v)) q))
     (\ c1 nv1 q -> absurd (Eq Term false c1) (noConfusionTerm (pred (succ c1)) (iszero (succ v)) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term false (pred c2)) (noConfusionTerm (pred c1) (iszero (succ v)) q))
     (\ q -> let nc2 : Eq Term zero (succ v) = noConfusionTerm (iszero zero) (iszero (succ v)) q in let e1 : Eq Term zero (succ v) = (nc2) in absurd (Eq Term false true) (noConfusionTerm zero (succ v) e1))
     (\ c1 nv1 q -> let nc2 : Eq Term (succ c1) (succ v) = noConfusionTerm (iszero (succ c1)) (iszero (succ v)) q in let e1 : Eq Term (succ c1) (succ v) = (nc2) in let nc4 : Eq Term c1 v = noConfusionTerm (succ c1) (succ v) e1 in let e3 : Eq Term c1 v = (nc4) in refl Term false)
     (\ c1 c2 sr ih q -> let nc2 : Eq Term c1 (succ v) = noConfusionTerm (iszero c1) (iszero (succ v)) q in let e1 : Eq Term c1 (succ v) = (nc2) in absurd (Eq Term false (iszero c2)) (nvNoStep (succ v) (nvSucc v nv) c2 (subst Term (\ x -> Step x c2) c1 (succ v) (e1) (sr)))))
    ((iszero (succ v)) u) s (refl Term (iszero (succ v)))

-- Determinacy. The generated proof's thirteen inversion lemmas are the ten arms
-- of the outer split and the inner split under each. The outer split is an
-- `induction`, because the congruence rules recurse and `determinacy p p' sr`
-- below IS the induction hypothesis; every inner split is a `case`, because
-- inversion never recurses, and that claim is carried by the type.
determinacy : forall (t : Term) (t1 : Term) (s1 : Step t t1) (t2 : Term) (s2 : Step t t2) -> Eq Term t1 t2
determinacy = \ t t1 s1 -> induction s1 of
  { eIfTrue a b -> \ u s -> case s of
      { eIfTrue c d -> refl Term c
      ; eIf c1 c1' c2 c3 sr -> absurd (Eq Term c2 (ifthen c1' c2 c3)) (trueNoStep c1' sr) }
  ; eIfFalse a b -> \ u s -> case s of
      { eIfFalse c d -> refl Term d
      ; eIf c1 c1' c2 c3 sr -> absurd (Eq Term c3 (ifthen c1' c2 c3)) (falseNoStep c1' sr) }
  ; eIf p p' a b sr -> invIf p p' a b sr (determinacy p p' sr)
  ; eSucc p p' sr -> invSucc p p' sr (determinacy p p' sr)
  ; ePredZero -> \ u s -> case s of
      { ePredZero -> refl Term zero
      ; ePred c1 c1' sr -> absurd (Eq Term zero (pred c1')) (zeroNoStep c1' sr) }
  ; ePredSucc v nv -> invPredSucc v nv
  ; ePred p p' sr -> invPred p p' sr (determinacy p p' sr)
  ; eIsZeroZero -> \ u s -> case s of
      { eIsZeroZero -> refl Term true
      ; eIsZero c1 c1' sr -> absurd (Eq Term true (iszero c1')) (zeroNoStep c1' sr) }
  ; eIsZeroSucc v nv -> invIsZeroSucc v nv
  ; eIsZero p p' sr -> invIsZero p p' sr (determinacy p p' sr) }
