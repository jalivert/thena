-- Determinacy of a small-step semantics for the untyped arithmetic terms of
-- TAPL chapter 3 — the same theorem as examples/determinacy-surface.thena, and
-- the point of the file is the BOUNDARY it draws: seven of the ten cases are
-- dependent pattern matching, and three of them cannot be, so they are the
-- generated proof's own lemmas, pasted here unchanged.
--
-- WRITTEN BY HAND except for those three. The companion file is GENERATED by
-- examples/determinacy.py, because nobody would write it: each of its thirteen
-- lemmas abstracts the goal over an equation `Eq Term x <the pattern I meant>`,
-- writes out all ten methods of `elim Step` whether the case is possible or not,
-- and discharges the nine impossible ones by hand with `noConfusionTerm`.
--
-- WHAT THE SPLIT DOES INSTEAD. `case s of { … }` unifies each constructor's
-- indices with the scrutinee's, and a method whose equations conflict is closed
-- before the user sees it — so an impossible case is an arm NOT WRITTEN rather
-- than a line of `absurd (…) (noConfusionTerm … q)`.
--
-- WHY `invIf`, `invPred` AND `invIsZero` ARE STILL THE OLD PROOF — `~2d9xj`.
-- Each is a congruence rule, so its own arm binds the subject as a variable:
-- `eIf p p' a b sr`. Splitting the second derivation then needs `p` to be
-- `true`, or `zero`, or `succ c1` — and `p` is bound by the ENCLOSING arm, not
-- by this split, so the specialiser cannot solve it. Thena states the equation
-- and keeps it; Agda and Idris refine `p` instead, because a clause's whole
-- left-hand side is one unification problem rather than one scrutinee with a
-- frozen context.
--
-- The arm can be written to TAKE the leftover equation, and an earlier version
-- of this file did that in six arms. His ruling, 2026-10-20: a proof that
-- leverages that is not correctly proved, because an arm whose right-hand side
-- is a function of an equation the user had no way to predict is the
-- elaboration into the development calculus leaking into the surface. So those
-- six arms are gone, and what stands in their place is the proof we already
-- had. **This file will get shorter when a split can refine a variable bound
-- outside it, and not before.**

module Determinacy where

data Term : Type₀ where
  true : Term
  false : Term
  ifthen : Term -> Term -> Term -> Term
  zero : Term
  succ : Term -> Term
  pred : Term -> Term
  iszero : Term -> Term

data NV : Term -> Type₀ where
  nvZero : NV zero
  nvSucc : forall (t : Term) (n : NV t) -> NV (succ t)

data Step : Term -> Term -> Type₀ where
  eIfTrue : forall (t2 : Term) (t3 : Term) -> Step (ifthen true t2 t3) t2
  eIfFalse : forall (t2 : Term) (t3 : Term) -> Step (ifthen false t2 t3) t3
  eIf : forall (t1 : Term) (t1' : Term) (t2 : Term) (t3 : Term) (s : Step t1 t1') -> Step (ifthen t1 t2 t3) (ifthen t1' t2 t3)
  eSucc : forall (t1 : Term) (t1' : Term) (s : Step t1 t1') -> Step (succ t1) (succ t1')
  ePredZero : Step (pred zero) zero
  ePredSucc : forall (v : Term) (nv : NV v) -> Step (pred (succ v)) v
  ePred : forall (t1 : Term) (t1' : Term) (s : Step t1 t1') -> Step (pred t1) (pred t1')
  eIsZeroZero : Step (iszero zero) true
  eIsZeroSucc : forall (v : Term) (nv : NV v) -> Step (iszero (succ v)) false
  eIsZero : forall (t1 : Term) (t1' : Term) (s : Step t1 t1') -> Step (iszero t1) (iszero t1')

-- The equipment, and all four of these are splits too. `Empty` has no
-- constructors, so `absurd` has no arms. `Eq` has one, and its single arm
-- forces both indices to the same variable — which is what makes `refl B (f c)`
-- and the identity function proofs of `cong` and `subst`.
absurd : forall (C : Type₀) (e : Empty) -> C
absurd = \ C e -> case e of { }

sym : forall (A : Type₀) (a : A) (b : A) (e : Eq A a b) -> Eq A b a
sym = \ A a b e -> case e of { refl c -> refl A c }

subst : forall (A : Type₀) (P : A -> Type₀) (a : A) (b : A) (e : Eq A a b) (p : P a) -> P b
subst = \ A P a b e -> case e of { refl c -> \ z -> z }

cong : forall (A : Type₀) (B : Type₀) (f : A -> B) (a : A) (b : A) (e : Eq A a b) -> Eq B (f a) (f b)
cong = \ A B f a b e -> case e of { refl c -> refl B (f c) }

-- No value steps. Each of these is the whole lemma: every constructor of `Step`
-- has `ifthen`, `succ`, `pred` or `iszero` at its source, so against `true`,
-- `false` or `zero` all ten methods are closed by a conflicting equation and
-- there is nothing left to answer. The generated proof writes ten methods and
-- ten appeals to no-confusion for each of these three.
trueNoStep : forall (u : Term) (s : Step true u) -> Empty
trueNoStep = \ u s -> case s of { }

falseNoStep : forall (u : Term) (s : Step false u) -> Empty
falseNoStep = \ u s -> case s of { }

zeroNoStep : forall (u : Term) (s : Step zero u) -> Empty
zeroNoStep = \ u s -> case s of { }

-- `u` and `s` are deliberately NOT introduced before the split on `nv`: the
-- index `t` is a context variable, and an index no introduced premise mentions
-- is abstracted with no equation. The generated proof needs a separate
-- `succNoStep` that takes its own induction hypothesis as an argument; here the
-- hypothesis IS the recursive call, so that lemma does not exist.
nvNoStep : forall (v : Term) (nv : NV v) (u : Term) (s : Step v u) -> Empty
nvNoStep = \ v nv -> induction nv of
  { nvZero -> \ u s -> zeroNoStep u s
  ; nvSucc t n -> \ u s -> case s of
      { eSucc c1 c1' sr -> nvNoStep t n c1' sr } }

-- ---------------------------------------------------------------------------
-- THE THREE THE SPLIT CANNOT DO — `~2d9xj`, and these are `determinacy.py`'s
-- own, pasted unchanged. Each writes out all ten methods of `elim Step`, states
-- the equation `Eq Term x <the pattern>` in its own motive, and discharges nine
-- impossible cases with `noConfusionTerm`. Read one against any arm above.
-- ---------------------------------------------------------------------------

trans : forall (A : Type₀) (a : A) (b : A) (c : A) (e : Eq A a b) (e2 : Eq A b c) -> Eq A a c
trans = \ A a b c e e2 -> elim Eq (A) (\ x y q -> Eq A y c -> Eq A x c) ((\ d -> \ z -> z)) (a b) e e2

invIf : ∀ (p : Term) (p' : Term) (a : Term) (b : Term) (s0 : Step p p') (ih0 : ∀ (w : Term) (sw : Step p w) -> Eq Term p' w) (u : Term) (s : Step (ifthen p a b) u) -> Eq Term (ifthen p' a b) u
invIf = \ p p' a b s0 ih0 u s ->
  elim Step () (\ x y r -> Eq Term x (ifthen p a b) -> Eq Term (ifthen p' a b) y)
    ((\ c1 c2 q -> let nc4 : And (Eq Term true p) (And (Eq Term c1 a) (Eq Term c2 b)) = noConfusionTerm (ifthen true c1 c2) (ifthen p a b) q in let e1 : Eq Term true p = (andLeft (Eq Term true p) (And (Eq Term c1 a) (Eq Term c2 b)) (nc4)) in let e2 : Eq Term c1 a = (andLeft (Eq Term c1 a) (Eq Term c2 b) (andRight (Eq Term true p) (And (Eq Term c1 a) (Eq Term c2 b)) (nc4))) in let e3 : Eq Term c2 b = (andRight (Eq Term c1 a) (Eq Term c2 b) (andRight (Eq Term true p) (And (Eq Term c1 a) (Eq Term c2 b)) (nc4))) in absurd (Eq Term (ifthen p' a b) c1) (trueNoStep p' (subst Term (\ x -> Step x p') p true (sym Term true p e1) (s0))))
     (\ c1 c2 q -> let nc4 : And (Eq Term false p) (And (Eq Term c1 a) (Eq Term c2 b)) = noConfusionTerm (ifthen false c1 c2) (ifthen p a b) q in let e1 : Eq Term false p = (andLeft (Eq Term false p) (And (Eq Term c1 a) (Eq Term c2 b)) (nc4)) in let e2 : Eq Term c1 a = (andLeft (Eq Term c1 a) (Eq Term c2 b) (andRight (Eq Term false p) (And (Eq Term c1 a) (Eq Term c2 b)) (nc4))) in let e3 : Eq Term c2 b = (andRight (Eq Term c1 a) (Eq Term c2 b) (andRight (Eq Term false p) (And (Eq Term c1 a) (Eq Term c2 b)) (nc4))) in absurd (Eq Term (ifthen p' a b) c2) (falseNoStep p' (subst Term (\ x -> Step x p') p false (sym Term false p e1) (s0))))
     (\ c1 c2 c3 c4 sr ih q -> let nc4 : And (Eq Term c1 p) (And (Eq Term c3 a) (Eq Term c4 b)) = noConfusionTerm (ifthen c1 c3 c4) (ifthen p a b) q in let e1 : Eq Term c1 p = (andLeft (Eq Term c1 p) (And (Eq Term c3 a) (Eq Term c4 b)) (nc4)) in let e2 : Eq Term c3 a = (andLeft (Eq Term c3 a) (Eq Term c4 b) (andRight (Eq Term c1 p) (And (Eq Term c3 a) (Eq Term c4 b)) (nc4))) in let e3 : Eq Term c4 b = (andRight (Eq Term c3 a) (Eq Term c4 b) (andRight (Eq Term c1 p) (And (Eq Term c3 a) (Eq Term c4 b)) (nc4))) in trans Term (ifthen p' a b) (ifthen c2 a b) (ifthen c2 c3 c4) (cong Term Term (\ x -> ifthen x a b) p' c2 (ih0 c2 (subst Term (\ x -> Step x c2) c1 p (e1) (sr)))) (trans Term (ifthen c2 a b) (ifthen c2 c3 b) (ifthen c2 c3 c4) (cong Term Term (\ x -> ifthen c2 x b) a c3 (sym Term c3 a e2)) (cong Term Term (\ x -> ifthen c2 c3 x) b c4 (sym Term c4 b e3))))
     (\ c1 c2 sr ih q -> absurd (Eq Term (ifthen p' a b) (succ c2)) (noConfusionTerm (succ c1) (ifthen p a b) q))
     (\ q -> absurd (Eq Term (ifthen p' a b) zero) (noConfusionTerm (pred zero) (ifthen p a b) q))
     (\ c1 nv1 q -> absurd (Eq Term (ifthen p' a b) c1) (noConfusionTerm (pred (succ c1)) (ifthen p a b) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (ifthen p' a b) (pred c2)) (noConfusionTerm (pred c1) (ifthen p a b) q))
     (\ q -> absurd (Eq Term (ifthen p' a b) true) (noConfusionTerm (iszero zero) (ifthen p a b) q))
     (\ c1 nv1 q -> absurd (Eq Term (ifthen p' a b) false) (noConfusionTerm (iszero (succ c1)) (ifthen p a b) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (ifthen p' a b) (iszero c2)) (noConfusionTerm (iszero c1) (ifthen p a b) q)))
    ((ifthen p a b) u) s (refl Term (ifthen p a b))

invPred : ∀ (p : Term) (p' : Term) (s0 : Step p p') (ih0 : ∀ (w : Term) (sw : Step p w) -> Eq Term p' w) (u : Term) (s : Step (pred p) u) -> Eq Term (pred p') u
invPred = \ p p' s0 ih0 u s ->
  elim Step () (\ x y r -> Eq Term x (pred p) -> Eq Term (pred p') y)
    ((\ c1 c2 q -> absurd (Eq Term (pred p') c1) (noConfusionTerm (ifthen true c1 c2) (pred p) q))
     (\ c1 c2 q -> absurd (Eq Term (pred p') c2) (noConfusionTerm (ifthen false c1 c2) (pred p) q))
     (\ c1 c2 c3 c4 sr ih q -> absurd (Eq Term (pred p') (ifthen c2 c3 c4)) (noConfusionTerm (ifthen c1 c3 c4) (pred p) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (pred p') (succ c2)) (noConfusionTerm (succ c1) (pred p) q))
     (\ q -> let nc2 : Eq Term zero p = noConfusionTerm (pred zero) (pred p) q in let e1 : Eq Term zero p = (nc2) in absurd (Eq Term (pred p') zero) (zeroNoStep p' (subst Term (\ x -> Step x p') p zero (sym Term zero p e1) (s0))))
     (\ c1 nv1 q -> let nc2 : Eq Term (succ c1) p = noConfusionTerm (pred (succ c1)) (pred p) q in let e1 : Eq Term (succ c1) p = (nc2) in absurd (Eq Term (pred p') c1) (nvNoStep (succ c1) (nvSucc c1 nv1) p' (subst Term (\ x -> Step x p') p (succ c1) (sym Term (succ c1) p e1) (s0))))
     (\ c1 c2 sr ih q -> let nc2 : Eq Term c1 p = noConfusionTerm (pred c1) (pred p) q in let e1 : Eq Term c1 p = (nc2) in cong Term Term (\ x -> pred x) p' c2 (ih0 c2 (subst Term (\ x -> Step x c2) c1 p (e1) (sr))))
     (\ q -> absurd (Eq Term (pred p') true) (noConfusionTerm (iszero zero) (pred p) q))
     (\ c1 nv1 q -> absurd (Eq Term (pred p') false) (noConfusionTerm (iszero (succ c1)) (pred p) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (pred p') (iszero c2)) (noConfusionTerm (iszero c1) (pred p) q)))
    ((pred p) u) s (refl Term (pred p))

invIsZero : ∀ (p : Term) (p' : Term) (s0 : Step p p') (ih0 : ∀ (w : Term) (sw : Step p w) -> Eq Term p' w) (u : Term) (s : Step (iszero p) u) -> Eq Term (iszero p') u
invIsZero = \ p p' s0 ih0 u s ->
  elim Step () (\ x y r -> Eq Term x (iszero p) -> Eq Term (iszero p') y)
    ((\ c1 c2 q -> absurd (Eq Term (iszero p') c1) (noConfusionTerm (ifthen true c1 c2) (iszero p) q))
     (\ c1 c2 q -> absurd (Eq Term (iszero p') c2) (noConfusionTerm (ifthen false c1 c2) (iszero p) q))
     (\ c1 c2 c3 c4 sr ih q -> absurd (Eq Term (iszero p') (ifthen c2 c3 c4)) (noConfusionTerm (ifthen c1 c3 c4) (iszero p) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (iszero p') (succ c2)) (noConfusionTerm (succ c1) (iszero p) q))
     (\ q -> absurd (Eq Term (iszero p') zero) (noConfusionTerm (pred zero) (iszero p) q))
     (\ c1 nv1 q -> absurd (Eq Term (iszero p') c1) (noConfusionTerm (pred (succ c1)) (iszero p) q))
     (\ c1 c2 sr ih q -> absurd (Eq Term (iszero p') (pred c2)) (noConfusionTerm (pred c1) (iszero p) q))
     (\ q -> let nc2 : Eq Term zero p = noConfusionTerm (iszero zero) (iszero p) q in let e1 : Eq Term zero p = (nc2) in absurd (Eq Term (iszero p') true) (zeroNoStep p' (subst Term (\ x -> Step x p') p zero (sym Term zero p e1) (s0))))
     (\ c1 nv1 q -> let nc2 : Eq Term (succ c1) p = noConfusionTerm (iszero (succ c1)) (iszero p) q in let e1 : Eq Term (succ c1) p = (nc2) in absurd (Eq Term (iszero p') false) (nvNoStep (succ c1) (nvSucc c1 nv1) p' (subst Term (\ x -> Step x p') p (succ c1) (sym Term (succ c1) p e1) (s0))))
     (\ c1 c2 sr ih q -> let nc2 : Eq Term c1 p = noConfusionTerm (iszero c1) (iszero p) q in let e1 : Eq Term c1 p = (nc2) in cong Term Term (\ x -> iszero x) p' c2 (ih0 c2 (subst Term (\ x -> Step x c2) c1 p (e1) (sr)))))
    ((iszero p) u) s (refl Term (iszero p))

-- Determinacy. The generated proof's thirteen inversion lemmas are the ten arms
-- of the outer split and the inner split under each. The outer split is an
-- `induction`, because the congruence rules recurse and `determinacy p p' sr`
-- below IS the induction hypothesis; every inner split is a `case`, because
-- inversion never recurses, and that claim is carried by the type.
determinacy : forall (t : Term) (t1 : Term) (s1 : Step t t1) (t2 : Term) (s2 : Step t t2) -> Eq Term t1 t2
determinacy = \ t t1 s1 -> induction s1 of
  { eIfTrue a b -> \ u s -> case s of
      { eIfTrue c d -> refl Term c
      ; eIf c1 c1' c2 c3 sr -> absurd (Eq Term c2 (ifthen c1' c2 c3)) (trueNoStep c1' sr) }
  ; eIfFalse a b -> \ u s -> case s of
      { eIfFalse c d -> refl Term d
      ; eIf c1 c1' c2 c3 sr -> absurd (Eq Term c3 (ifthen c1' c2 c3)) (falseNoStep c1' sr) }
  ; eIf p p' a b sr -> invIf p p' a b sr (determinacy p p' sr)
  ; eSucc p p' sr -> \ u s -> case s of
      { eSucc c1 c1' sr2 -> cong Term Term (\ x -> succ x) p' c1' (determinacy p p' sr c1' sr2) }
  ; ePredZero -> \ u s -> case s of
      { ePredZero -> refl Term zero
      ; ePred c1 c1' sr -> absurd (Eq Term zero (pred c1')) (zeroNoStep c1' sr) }
  ; ePredSucc v nv -> \ u s -> case s of
      { ePredSucc c1 nv1 -> refl Term c1
      ; ePred c1 c1' sr -> absurd (Eq Term v (pred c1')) (nvNoStep (succ v) (nvSucc v nv) c1' sr) }
  ; ePred p p' sr -> invPred p p' sr (determinacy p p' sr)
  ; eIsZeroZero -> \ u s -> case s of
      { eIsZeroZero -> refl Term true
      ; eIsZero c1 c1' sr -> absurd (Eq Term true (iszero c1')) (zeroNoStep c1' sr) }
  ; eIsZeroSucc v nv -> \ u s -> case s of
      { eIsZeroSucc c1 nv1 -> refl Term false
      ; eIsZero c1 c1' sr -> absurd (Eq Term false (iszero c1')) (nvNoStep (succ v) (nvSucc v nv) c1' sr) }
  ; eIsZero p p' sr -> invIsZero p p' sr (determinacy p p' sr) }
