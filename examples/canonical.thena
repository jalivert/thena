-- Canonical forms for TAPL chapter 8's typed arithmetic expressions, proved in
-- Thena's surface language — Theorem 8.3.1, both halves.
--
-- A companion to examples/determinacy-surface.thena. That file models the same
-- terms and their small-step semantics and proves determinacy (TAPL 3.5.4);
-- this one adds the TYPING relation those terms were missing and proves what
-- a well-typed value must look like.
--
-- WRITTEN BY HAND, unlike the determinacy example, which is generated. It is
-- about a third the size, and the shape of every proof is the same: split a
-- derivation and answer the cases that survive.
--
-- EVERY SPLIT HERE IS A `case` AND NOT AN `induction`, and that is a claim the
-- types carry rather than a convention: `case` elaborates to the generated
-- `caseD`, whose methods have no inductive hypothesis, so none of these proofs
-- can recurse even by accident. Canonical forms is inversion, and inversion
-- never recurses.
--
-- AND FOUR OF THEM HAVE NO CASES AT ALL. `case d of { }` on a
-- `HasType true nat` says every constructor of `HasType` disagrees with those
-- indices, and elaboration closes all seven methods itself — where this file
-- used to write out seven methods and seven appeals to no-confusion apiece.
--
-- AND THEY ARE LEVEL-POLYMORPHIC NOW, where they used to be at level 0. A
-- declared type's level is generalised when nothing pins it, and the old proofs
-- pinned it by passing `Empty` to `absurd`, whose first argument is declared at
-- `Type₀`. These name nothing, so what you get is `trueNotNat {ℓ}`, and
-- `trueNotNat {0}` is the lemma this file used to have.
--
-- The two theorems are what a progress proof needs as its lemmas, which is what
-- canonical forms is FOR in TAPL: knowing that a well-typed value of type bool
-- really is true or false is what lets an `if` take a step.

module Canonical where

data Term : Type₀ where
  true : Term
  false : Term
  ifthen : Term -> Term -> Term -> Term
  zero : Term
  succ : Term -> Term
  pred : Term -> Term
  iszero : Term -> Term

data Ty : Type₀ where
  bool : Ty
  nat : Ty

data NV : Term -> Type₀ where
  nvZero : NV zero
  nvSucc : forall (t : Term) (n : NV t) -> NV (succ t)

data Value : Term -> Type₀ where
  vTrue : Value true
  vFalse : Value false
  vNat : forall (t : Term) (n : NV t) -> Value t

data HasType : Term -> Ty -> Type₀ where
  tTrue : HasType true bool
  tFalse : HasType false bool
  tIf : forall (t1 : Term) (t2 : Term) (t3 : Term) (T : Ty) (d1 : HasType t1 bool) (d2 : HasType t2 T) (d3 : HasType t3 T) -> HasType (ifthen t1 t2 t3) T
  tZero : HasType zero nat
  tSucc : forall (t : Term) (d : HasType t nat) -> HasType (succ t) nat
  tPred : forall (t : Term) (d : HasType t nat) -> HasType (pred t) nat
  tIsZero : forall (t : Term) (d : HasType t nat) -> HasType (iszero t) bool

data Or (A : Type₀) (B : Type₀) : Type₀ where
  inl : forall (a : A) -> Or A B
  inr : forall (b : B) -> Or A B

absurd : forall (C : Type₀) (e : Empty) -> C
absurd = \ C e -> case e of { }

trueNotNat : forall (d : HasType true nat) -> Empty
trueNotNat = \ d -> case d of { }

falseNotNat : forall (d : HasType false nat) -> Empty
falseNotNat = \ d -> case d of { }

zeroNotBool : forall (d : HasType zero bool) -> Empty
zeroNotBool = \ d -> case d of { }

-- The one that forces a constructor argument: `tSucc`'s own subterm is
-- determined to be `t` by injectivity of `succ`, and then `nat` against `bool`
-- closes that method like all the others.
succNotBool : forall (t : Term) (d : HasType (succ t) bool) -> Empty
succNotBool = \ t d -> case d of { }

-- `d` is deliberately NOT introduced: the split is on `n`, whose index `t` is
-- a context variable, and an index no other premise mentions is abstracted
-- with no equation. Introducing `d` first would mention it and tie it.
nvNotBool : forall (t : Term) (n : NV t) (d : HasType t bool) -> Empty
nvNotBool = \ t n -> case n of
  { nvZero -> \ dd -> zeroNotBool dd
  ; nvSucc c1 nn -> \ dd -> succNotBool c1 dd }

canonicalBool : forall (v : Term) (p : Value v) (d : HasType v bool) -> Or (Eq Term v true) (Eq Term v false)
canonicalBool = \ v p -> case p of
  { vTrue -> \ dd -> inl (Eq Term true true) (Eq Term true false) (refl Term true)
  ; vFalse -> \ dd -> inr (Eq Term false true) (Eq Term false false) (refl Term false)
  ; vNat c1 nn -> \ dd -> absurd (Or (Eq Term c1 true) (Eq Term c1 false)) (nvNotBool c1 nn dd) }

canonicalNat : forall (v : Term) (p : Value v) (d : HasType v nat) -> NV v
canonicalNat = \ v p -> case p of
  { vTrue -> \ dd -> absurd (NV true) (trueNotNat dd)
  ; vFalse -> \ dd -> absurd (NV false) (falseNotNat dd)
  ; vNat c1 nn -> \ dd -> nn }
