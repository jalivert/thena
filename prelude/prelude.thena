data Eq (A : Type₀) : A -> A -> Type₀ where { refl : ∀ (a : A) -> Eq A a a }
data Unit : Type₀ where { unit : Unit }
data Empty : Type₀ where { }
data And (A : Type₀) (B : Type₀) : Type₀ where { both : ∀ (a : A) (b : B) -> And A B }
data Sigma (A : Type₀) (B : A -> Type₀) : Type₀ where { pair : ∀ (a : A) (b : B a) -> Sigma A B }
:theorem fst : ∀ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> A
try (\ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> elim Sigma (A B) (\ (z : Sigma A B) -> A) ((\ (a : A) (b : B a) -> a)) () s)
solve
qed
:theorem snd : ∀ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> B (fst A B s)
try (\ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> elim Sigma (A B) (\ (z : Sigma A B) -> B (fst A B z)) ((\ (a : A) (b : B a) -> b)) () s)
solve
qed
:theorem andLeft : ∀ (A : Type₀) (B : Type₀) (c : And A B) -> A
try (\ (A : Type₀) (B : Type₀) (c : And A B) -> elim And (A B) (\ (z : And A B) -> A) ((\ (a : A) (b : B) -> a)) () c)
solve
qed
:theorem andRight : ∀ (A : Type₀) (B : Type₀) (c : And A B) -> B
try (\ (A : Type₀) (B : Type₀) (c : And A B) -> elim And (A B) (\ (z : And A B) -> B) ((\ (a : A) (b : B) -> b)) () c)
solve
qed
