data Eq (A : Type) : A -> A -> Type where { refl : ∀ (a : A) -> Eq A a a }
data Unit : Type where { unit : Unit }
data Empty : Type where { }
data And (A : Type) (B : Type) : Type where { both : ∀ (a : A) (b : B) -> And A B }
data Sigma (A : Type₀) (B : A -> Type₀) : Type₀ where { pair : ∀ (a : A) (b : B a) -> Sigma A B }
:theorem fst : ∀ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> A
try-core ⌜ \ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> elim Sigma (A B) (\ (z : Sigma A B) -> A) ((\ (a : A) (b : B a) -> a)) () s ⌝
solve
qed
:theorem snd : ∀ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> B (fst A B s)
try-core ⌜ \ (A : Type₀) (B : A -> Type₀) (s : Sigma A B) -> elim Sigma (A B) (\ (z : Sigma A B) -> B (fst A B z)) ((\ (a : A) (b : B a) -> b)) () s ⌝
solve
qed
:theorem andLeft : ∀ (A : Type₀) (B : Type₀) (c : And {0 0} A B) -> A
try-core ⌜ \ (A : Type₀) (B : Type₀) (c : And {0 0} A B) -> elim And {0 0} (A B) (\ (z : And {0 0} A B) -> A) ((\ (a : A) (b : B) -> a)) () c ⌝
solve
qed
:theorem andRight : ∀ (A : Type₀) (B : Type₀) (c : And {0 0} A B) -> B
try-core ⌜ \ (A : Type₀) (B : Type₀) (c : And {0 0} A B) -> elim And {0 0} (A B) (\ (z : And {0 0} A B) -> B) ((\ (a : A) (b : B) -> b)) () c ⌝
solve
qed
