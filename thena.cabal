cabal-version:      3.4
name:               thena
version:            0.1.0.0
synopsis:           An interactive proof assistant for language metatheory
license:            MIT
license-file:       LICENSE
author:             jalivert
maintainer:         jali@verter.cz
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md

-- The prelude is a real file, not a built-in (§3.7). 'data-files' rather than a
-- path relative to the working directory, so it is still found after
-- 'cabal install'; 'Paths_thena' is how the library asks where it went.
data-files:         prelude/prelude.thena
                    rules/standard.thena.rules

