cabal-version:      3.0
name:               thena
version:            0.1.0.0
synopsis:           An interactive proof assistant for language metatheory
license:            NONE
author:             jalivert
maintainer:         jali@verter.cz
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:             warnings
    hs-source-dirs:     src
    default-language:   GHC2024
    exposed-modules:
        Thena.Core.Context
        Thena.Core.Term
        Thena.Driver
        Thena.Repl
    build-depends:
        base       ^>=4.21.2.0,
        haskeline  >=0.8.4 && <0.9
    build-tool-depends:
        alex:alex   >=3.5,
        happy:happy >=2.1

executable thena
    import:             warnings
    hs-source-dirs:     app
    default-language:   GHC2024
    main-is:            Main.hs
    build-depends:
        base  ^>=4.21.2.0,
        thena

test-suite thena-test
    import:             warnings
    hs-source-dirs:     test
    default-language:   GHC2024
    type:               exitcode-stdio-1.0
    main-is:            Main.hs
    other-modules:
        Thena.Core.TermTests
        Thena.DriverTests
    build-depends:
        base              ^>=4.21.2.0,
        thena,
        tasty             >=1.5  && <1.6,
        tasty-hunit       >=0.10 && <0.11,
        tasty-quickcheck  >=0.11 && <0.12
