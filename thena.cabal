cabal-version:      3.0
name:               thena
version:            0.1.0.0
synopsis:           An interactive proof assistant for language metatheory
license:            NONE
author:             jalivert
maintainer:         jali@verter.cz
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md

-- The prelude is a real file, not a built-in (§3.7). 'data-files' rather than a
-- path relative to the working directory, so it is still found after
-- 'cabal install'; 'Paths_thena' is how the library asks where it went.
data-files:         prelude/prelude.thena
                    rules/standard.thena.rules

common warnings
    ghc-options: -Wall

library
    import:             warnings
    hs-source-dirs:     src
    default-language:   GHC2024
    exposed-modules:
        Thena.Core.Context
        Thena.Core.Convert
        Thena.Core.Reduce
        Thena.Core.Level
        Thena.Core.Term
        Thena.Core.Typing
        Thena.Core.Unify
        Thena.Development.Component
        Thena.Development.Cursor
        Thena.Development.Partial
        Thena.Development.Validate
        Thena.Driver
        Thena.Engine
        Thena.Errors
        Thena.Global.Declare
        Thena.Global.Env
        Thena.Global.NoConfusion
        Thena.Kernel
        Thena.Ops
        Thena.Repl
        Thena.Rules
        Thena.Surface.Concrete
        Thena.Surface.Layout
        Thena.Surface.Parser
        Thena.Surface.Zipper
        Thena.Syntax.Concrete
        Thena.Syntax.Lexer
        Thena.Syntax.Parser
        Thena.Syntax.Resolve
        Thena.Tactics.Eliminate
    other-modules:
        Paths_thena
    autogen-modules:
        Paths_thena
    build-depends:
        base       ^>=4.21.2.0,
        array      >=0.5 && <0.6,
        haskeline  >=0.8.4 && <0.9
    build-tool-depends:
        alex:alex   >=3.5,
        happy:happy >=2.1

executable thena
    import:             warnings
    hs-source-dirs:     app
    default-language:   GHC2024
    main-is:            Main.hs
    build-depends:
        base  ^>=4.21.2.0,
        thena

test-suite thena-test
    import:             warnings
    hs-source-dirs:     test
    default-language:   GHC2024
    type:               exitcode-stdio-1.0
    main-is:            Main.hs
    other-modules:
        Thena.Core.ConvertTests
        Thena.Core.ReduceTests
        Thena.Core.LevelTests
        Thena.Core.TermTests
        Thena.Core.TypingTests
        Thena.Core.UnifyTests
        Thena.CursorTests
        Thena.DependentIndexTests
        Thena.DeterminacyTests
        Thena.ProductTests
        Thena.DevelopmentTests
        Thena.EliminateTests
        Thena.EliminatorTests
        Thena.EngineTests
        Thena.GlobalTests
        Thena.GoldenTests
        Thena.SurfaceTests
        Thena.SurfaceZipperTests
        Thena.KernelTests
        Thena.NoConfusionTests
        Thena.DispatchTests
        Thena.ElaborateTests
        Thena.RulesTests
        Thena.RuleSyntaxTests
        Thena.RuleFileTests
        Thena.CallTests
        Thena.ReadTests
        Thena.LoadTests
        Thena.DriverTests
        Thena.Declared
        Thena.Standard
        Thena.Fixtures
        Thena.SessionTests
        Thena.SyntaxTests
    build-depends:
        base              ^>=4.21.2.0,
        thena,
        bytestring        >=0.12 && <0.13,
        tasty             >=1.5  && <1.6,
        tasty-golden      >=2.3  && <2.4,
        tasty-hunit       >=0.10 && <0.11,
        tasty-quickcheck  >=0.11 && <0.12
