"""the rules the engine starts with"""

rule base standard where

rule attack :- when focus-is-hole then prim-attack

rule try t :- when focus-is-hole then prim-try t

rule abandon :- when focus-is-hole then prim-abandon

rule intro :- when focus-is-guess goal-type-is-pi then prim-intro

rule intro :- when focus-is-guess goal-type-is-let then prim-intro

rule solve :- when focus-is-guess then prim-solve

rule regret :- when focus-is-guess then prim-regret

rule eliminate t :- when focus-is-hole then prim-eliminate t

rule elab-var :- when focus-is-hole hint-is-name
  then t = resolve hint
     ; try t
     ; prim-solve

rule unify-refine t :- when focus-is-hole
  then n = fresh-name "refined"
     ; x = define n t
     ; s = typeof x
     ; g = goal
     ; unify s g
     ; prim-try x
     ; prim-solve

rule apply f :- when focus-is-hole
  then s = prim-apply f
     ; unify-refine s
